  @@map("CALIBRATION_FREQUENCY_MASTER")
}

// ═══════════════════════════════════════════════════════════════════
// APP AUTH (net-new, isolated — not an ERP table; no FKs to ERP)
// ═══════════════════════════════════════════════════════════════════

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.NVarChar(50)
  passwordHash String    @db.NVarChar(255)
  name         String    @db.NVarChar(100)
  /// Matches rolePermissions keys in src/lib/session.ts
  role         String    @default("Viewer") @db.NVarChar(50)
  /// Optional ERP USER_ID for traceability — not used for auth; no FK
  erpUserCode  String?   @db.NVarChar(10)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("TOOLS_APP_USER")
}

// ═══════════════════════════════════════════════════════════════════
// APP DOCUMENTS (net-new — file bytes on disk; metadata only in DB)
// ═══════════════════════════════════════════════════════════════════

model ToolDocument {
  id             Int       @id @default(autoincrement())
  toolOrGaugeNo  String    @db.NVarChar(25)
  toolRefNo      Int?
  /// CALIB_CERTIFICATE | CALIB_REPORT | TOOL_MANUAL | DRAWING | DC_ATTACHMENT | OTHER
  docType        String    @default("OTHER") @db.NVarChar(40)
  originalName   String    @db.NVarChar(255)
  storedName     String    @db.NVarChar(255)
  mimeType       String    @db.NVarChar(120)
  sizeBytes      Int
  calibRowId     Int?
  dcNo           String?   @db.NVarChar(20)
  remarks        String?   @db.NVarChar(200)
  creatUserIdCd  String    @db.NVarChar(50)
  creatDt        DateTime  @default(now())
  deletedAt      DateTime?

  @@index([toolOrGaugeNo])
  @@index([calibRowId])
  @@map("TOOLS_APP_DOCUMENT")
}

// ═══════════════════════════════════════════════════════════════════
// TOOL REQUISITION (ERP — MATERIAL_REQUISITION_*; read-first for Pending)
