/// ERP purchase approval trail — read-only aggregate source (no Tools-owned table).
model PurchaseApproval {
  refNo           Int       @id @map("REF_NO")
  poOrderNo       String?   @map("PO_ORDER_NO") @db.NVarChar(20)
  poAmendNo       Int?      @map("PO_AMEND_NO")
