generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// ERP READ-ONLY TABLES (existing in ERPDb_ESSKAY — never written to)
// ═══════════════════════════════════════════════════════════════════

model ErpUser {
  userId       String  @id @map("USER_ID") @db.NVarChar(10)
  empCd        Int?     @map("EMP_CD")
  pass         String  @map("PASS") @db.NVarChar(50)
  roleName     String? @map("ROLE_NAME") @db.NVarChar(15)
  addRoleName  String? @map("ADD_ROLE_NAME") @db.NVarChar(100)
  status       String? @map("STATUS") @db.NVarChar(15)

  @@map("ERP_USER")
}

model Employee {
  empCd      Int      @id @map("EMP_CD")
  title      String?  @map("TITLE") @db.NVarChar(15)
  firstName  String   @map("FIRST_NAME") @db.NVarChar(50)
  lastName   String?  @map("LAST_NAME") @db.NVarChar(50)
  deptNo     Int      @map("DEPT_NO")
  status     String?  @map("STATUS") @db.NVarChar(15)

  @@map("EMPLOYEE")
}

// ═══════════════════════════════════════════════════════════════════
// MASTER TABLES
// ═══════════════════════════════════════════════════════════════════

model Supplier {
  supCode           String   @id @map("SUP_CODE") @db.NVarChar(10)
  supName           String?  @map("SUP_NAME") @db.NVarChar(200)
  add1              String?  @map("ADD1") @db.VarChar(200)
  city              String?  @map("CITY") @db.VarChar(80)
  state             String?  @map("STATE") @db.NVarChar(50)
  gstin             String?  @map("GSTIN") @db.NVarChar(25)
  phone1            String?  @map("PHONE1") @db.NVarChar(30)
  emailId           String?  @map("EMAIL_ID") @db.NVarChar(50)
  bankName          String?  @map("BANK_NAME") @db.NVarChar(50)
  accountNumber     String?  @map("ACCOUNT_NUMBER") @db.NVarChar(30)
  ifscCode          String?  @map("IFSC_CODE") @db.NVarChar(30)
  approvedSupplier String?  @map("APPROVED_SUPPLIER") @db.NVarChar(5)
  status            String?  @map("STATUS") @db.NVarChar(15)
  creatUserIdCd     String   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd  String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  poReceives        ToolsPoReceive[]
  commonPurchaseOrders CommonPurchaseOrder[]

  @@map("SUPPLIER")
}

model Subcontractor {
  subConId               String    @id @map("SUB_CON_ID") @db.NVarChar(10)
  subName                String?   @map("SUB_NAME") @db.NVarChar(150)
  natureOfWork           String?   @map("NATURE_OF_WORK") @db.NVarChar(50)
  isStoreVendor          String?   @map("IS_STORE_VENDOR") @db.NVarChar(3)
  isInhouse              String?   @map("IS_INHOUSE") @db.NVarChar(3)
  isIssueDc              String?   @map("IS_ISSUE_DC") @db.NVarChar(3)
  add1                   String?   @map("ADD1") @db.NVarChar(75)
  add2                   String?   @map("ADD2") @db.NVarChar(100)
  gstin                  String?   @map("GSTIN") @db.NVarChar(25)
  approvedSubcontractor  String?   @map("APPROVED_SUBCONTRACTOR") @db.NVarChar(5)
  status                 String?   @map("STATUS") @db.NVarChar(15)
  creatUserIdCd          String?   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt                DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd        String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  @@map("SUBCONTRACTOR")
}

model ToolsType {
  rowId             Int       @id @map("ROW_ID") @default(autoincrement())
  typeOfTools       String?   @map("TYPE_OF_TOOLS") @db.NVarChar(100)
  itemGroupId       Int?      @map("ITEM_GROUP_ID")
  itemTypeId        Int?      @map("ITEM_TYPE_ID")
  isAutoGenCd       String?   @map("IS_AUTO_GEN_CD") @db.NVarChar(3)
  prefixItemNo      String?   @map("PREFIX_ITEM_NO") @db.NVarChar(15)
  creatUserIdCd     String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.DateTime

  @@map("TOOLS_TYPE")
}

model GaugeType {
  rowId             Int      @id @map("ROW_ID") @default(autoincrement())
  typeOfGauge       String   @map("TYPE_OF_GAUGE") @db.NVarChar(25)
  creatUserIdCd     String   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.Date

  @@map("GAUGE_TYPE")
}

model OtherToolsType {
  rowId             Int      @id @map("ROW_ID") @default(autoincrement())
  otherType         String?  @map("OTHER_TYPE") @db.NVarChar(35)
  serialNoGenReq    String?  @map("SERIAL_NO_GEN_REQ") @db.NVarChar(5)
  issueType         String?  @map("ISSUE_TYPE") @db.NVarChar(25)
  poPrefix          String?  @map("PO_PREFIX") @db.NVarChar(20)
  indentPrefix      String?  @map("INDENT_PREFIX") @db.NVarChar(12)
  grnPrefix         String?  @map("GRN_PREFIX") @db.NVarChar(12)
  prefixToolsNo     String?  @map("PREFIX_TOOLS_NO") @db.NVarChar(12)
  itemNoPrefixMod   String?  @map("ITEM__NO_PREFIX_MOD") @db.NVarChar(5)
  prefixGateEntry   String?  @map("PREFIX_GATE_ENTRY") @db.NVarChar(12)
  creatUserIdCd     String   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd   String?  @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs         DateTime? @map("LST_UPDT_TS") @db.DateTime

  subgroups         QmsOtherToolsType[]

  @@map("OTHER_TOOLS_TYPE")
}

model QmsOtherToolsType {
  // ROW_ID is NOT identity in the ERP DB — creates must supply it explicitly.
  rowId               Int      @id @map("ROW_ID")
  qmsOtherTypeOfTools String?  @map("QMS_OTHER_TYPE_OF_TOOLS") @db.NVarChar(50)
  refGroupId          Int?     @map("REF_GROUP_ID")
  prefixToolsNo       String?  @map("PREFIX_TOOLS_NO") @db.NVarChar(12)
  isAutoGenCd         String?  @map("IS_AUTO_GEN_CD") @db.NVarChar(5)
  prefixBased         String?  @map("PREFIX_BASED") @db.NVarChar(10)
  assetCategory       String?  @map("ASSET_CATEGORY") @db.NVarChar(15)
  creatUserIdCd       String   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt             DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd     String?  @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs           DateTime? @map("LST_UPDT_TS") @db.DateTime

  group               OtherToolsType? @relation(fields: [refGroupId], references: [rowId])

  @@map("QMS_OTHER_TOOLS_TYPE")
}

// ═══════════════════════════════════════════════════════════════════
// TOOLS MANAGE MASTER — Core registry (BRD: GAUGEANDTOOLS)
// ═══════════════════════════════════════════════════════════════════

model GaugeAndTools {
  refNo                       Int       @id @map("REF_NO")
  grouping                    String    @map("GROUPING") @db.NVarChar(25)
  type                        String?   @map("TYPE") @db.NVarChar(50)
  name                        String?   @map("NAME") @db.NVarChar(100)
  description                 String?   @map("DES") @db.NVarChar(500)
  toolOrGaugeNo               String?   @unique @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  size                        String?   @map("SIZE") @db.NVarChar(25)
  shape                       String?   @map("SHAPE") @db.NVarChar(15)
  range                       String?   @map("RANGE") @db.NVarChar(30)
  totQty                      Decimal?  @map("TOT_QTY") @db.Decimal(10, 3)
  qtyIn                       Decimal?  @map("QTY_IN") @db.Decimal(10, 3)
  qtyOut                      Decimal?  @map("QTY_OUT") @db.Decimal(10, 3)
  qtyNew                      Decimal?  @map("QTY_NEW") @db.Decimal(10, 3)
  qtyInUse                    Decimal?  @map("QTY_IN_USE") @db.Decimal(10, 3)
  status                      String?   @map("STATUS") @db.NVarChar(25)
  location                    String?   @map("LOCATION") @db.NVarChar(50)
  locationName                String?   @map("LOCATION_NAME") @db.NVarChar(100)
  locationOutputName          String?   @map("LOCATION_OUTPUT_NAME") @db.NVarChar(100)
  area                        String?   @map("AREA") @db.NVarChar(100)
  rack                        String?   @map("RACK") @db.NVarChar(100)
  deptName                    String?   @map("DEPT_NAME") @db.NVarChar(25)
  issueType                   String?   @map("ISSUE_TYPE") @db.NVarChar(25)
  oldItemNo                   String?   @map("OLD_ITEM_NO") @db.NVarChar(20)
  price                       Decimal?  @map("PRICE") @db.Decimal(10, 3)
  minOrderLevel               Decimal?  @map("MIN_ORDER_LEVEL") @db.Decimal(12, 3)
  hsnCode                     String?   @map("HSN_CODE") @db.NVarChar(25)
  drawingNo                   String?   @map("DRAWING_NO") @db.NVarChar(30)
  revNoDt                     String?   @map("REV_NO_DT") @db.NVarChar(30)
  detailedSpec                String?   @map("DETAILED_SPEC")
  packingLength               String?   @map("PACKING_LENGTH") @db.VarChar(20)
  packingWidth                String?   @map("PACKING_WIDTH") @db.VarChar(20)
  packingHeight               String?   @map("PACKING_HEIGHT") @db.VarChar(20)
  packingDimensions           String?   @map("PACKING_DIMENSIONS") @db.NVarChar(50)
  stiffness                   String?   @map("STIFFNESS") @db.NVarChar(20)
  selfLife                    Int?      @map("SELF_LIFE")
  activeItem                  String?   @map("ACTIVE_ITEM") @db.NVarChar(10)
  criticalItem                String?   @map("CRITICAL_ITEM") @db.NVarChar(10)
  poReq                       String?   @map("PO_REQ") @db.NVarChar(10)
  stockReq                    String?   @map("STOCK_REQ") @db.NVarChar(5)
  stockItem                   String?   @map("STOCK_ITEM") @db.NVarChar(1)
  isAsset                     String?   @map("IS_ASSET") @db.NVarChar(20)
  saleableItem                String?   @map("SALEABLE_ITEM") @db.NVarChar(3)
  nocReq                      String?   @map("NOC_REQ") @db.NVarChar(10)
  machineSoftware             String?   @map("MACHINE_SOFTWARE") @db.NVarChar(5)
  ineligibleForItc            String?   @map("INELIGIBLE_FOR_ITC") @db.NVarChar(3)
  isCustGiven                 String?   @map("IS_CUST_GIVEN") @db.NVarChar(3)
  historyCardReq              String?   @map("HISTORY_CARD_REQ") @db.NVarChar(10)
  calibrationFrqMonths        Int?      @map("CALIBRATION_FRQ_MONTHS")
  caliPlannedWho              String?   @map("CALI_PLANNED_WHO") @db.NVarChar(15)
  calibrationResponsibility   String?   @map("CALIBRATION_RESPONSIBILITY") @db.NVarChar(15)
  serialNoGenReq              String?   @map("SERIAL_NO_GEN_REQ") @db.NVarChar(5)
  preventiveMethod            String?   @map("PREVENTIVE_METHOD") @db.NVarChar(25)
  preventiveFrqMonths         Int?      @map("PREVENTIVE_FRQ_MONTHS")
  /** ERP "Preventive MNT Done At" (int counter / done flag on master) */
  preventiveFrqOthers         Int?      @map("PREVENTIVE_FRQ_OTHERS")
  /** ERP "Ref Details" */
  refDetails                  String?   @map("REF_DETAILS") @db.NVarChar(50)
  /** ERP "Addil. Remarks" */
  remarks                     String?   @map("REMARKS") @db.NVarChar(50)
  gSpecUpperMin               Decimal?  @map("G_SPEC_UPPER_MIN") @db.Decimal(12, 3)
  gSpecUpperMax               Decimal?  @map("G_SPEC_UPPER_MAX") @db.Decimal(12, 3)
  wLimitLowerMax              Decimal?  @map("W_LIMIT_LOWER_MAX") @db.Decimal(12, 3)
  wLimitUpperMin              Decimal?  @map("W_LIMIT_UPPER_MIN") @db.Decimal(12, 3)
  wLimitUpperMax              Decimal?  @map("W_LIMIT_UPPER_MAX") @db.Decimal(12, 3)
  prodSpecLowerMax            Decimal?  @map("PROD_SPEC_LOWER_MAX") @db.Decimal(12, 3)
  prodSpecUpperMin            Decimal?  @map("PROD_SPEC_UPPER_MIN") @db.Decimal(12, 3)
  prodSpecUpperMax            Decimal?  @map("PROD_SPEC_UPPER_MAX") @db.Decimal(12, 3)
  uom                         String?   @map("UOM") @db.NVarChar(10)
  returnable                  String?   @map("RETURNABLE") @db.NVarChar(3)
  leastCount                  String?   @map("LEAST_COUNT") @db.NVarChar(50)
  companyId                   String?   @map("COMPANY_ID") @db.NVarChar(10)
  creatUserIdCd               String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt                     DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd             String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  serialNumbers               GaugeSerialNo[]
  specifications              ToolsSpecification[]
  priceMaster                 ToolsPriceMaster[]
  details                     ToolsDetails[]
  toolsMapping                ToolsMapping[]
  machineMapping              ToolsMachineTrans[]
  calibControlCard            GaugeControlCard[]
  issueLines                  ToolsTransIssue[]
  issueLinesByRef             ToolsTransIssue[] @relation("IssueLineToolByRef")
  receivedTransLines          ToolsIssueReceivedTrans[]
  calibIssueLines             ToolsTransIssueForCalibration[]
  calibReceiveLines           ToolsTransReceiveForCalibration[]
  consumptionLines            ToolsConsumptionTransIssue[]
  poReceiveTrans              ToolsPoReceiveTrans[]
  commonPurchaseItems         CommonPurchaseItem[]

  @@map("GAUGEANDTOOLS")
}

model GaugeSerialNo {
  refNo           Int       @id @map("REF_NO")
  toolOrGaugeNo   String?   @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  toolRefNo       Int?      @map("TOOL_REF_NO")
  serialNo        Int?      @map("SERIAL_NO")
  status          String?   @map("STATUS") @db.NVarChar(30)
  make            String?   @map("MAKE") @db.NVarChar(50)
  purchaseDt      DateTime? @map("C_DATE") @db.DateTime
  nextPreDate     DateTime? @map("NXT_PRE_DATE") @db.DateTime
  nextPreDone     Int?      @map("NXT_PRE_DONE")
  currentStatus   Int?      @map("CURRENT_STATUS")
  creatUserIdCd   String?   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime

  tool            GaugeAndTools? @relation(fields: [toolOrGaugeNo], references: [toolOrGaugeNo])

  @@map("GAUGE_SERIAL_NO")
}

model ToolsDetails {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  toolRefNo       Int?      @map("TOOL_REF_NO")
  noOfCavity      Int?      @map("NO_OF_CAVITY")
  runningCavity   Int?      @map("RUNNING_CAVITY")
  toolLife        Int?      @map("TOOL_LIFE")
  balanceToolLife Int?      @map("BALANCE_TOOL_LIFE")
  hardness        String?   @map("HARDNESS") @db.NVarChar(50)
  shrinkage       String?   @map("SHRINKAGE") @db.NVarChar(50)
  drawingNo       String?   @map("DRAWING_NO") @db.NVarChar(25)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime

  tool            GaugeAndTools? @relation(fields: [toolRefNo], references: [refNo])

  @@map("TOOLS_DETAILS")
}

model ToolsSpecification {
  rowId            Int       @id @map("ROW_ID")
  toolRefNo        Int?      @map("TOOL_REF_NO")
  sequence         Int?      @map("SEQUENCE")
  parameter        String?   @map("PARAMETER") @db.NVarChar(50)
  specification    String?   @map("SPECIFICATION") @db.NVarChar(100)
  minRange         String?   @map("MIN_RANGE") @db.NVarChar(15)
  maxRange         String?   @map("MAX_RANGE") @db.NVarChar(15)
  specType         String?   @map("SPEC_TYPE") @db.NVarChar(20)
  wLimitLowerMin   Decimal?  @map("W_LIMIT_LOWER_MIN") @db.Decimal(12, 3)
  wLimitLowerMax   Decimal?  @map("W_LIMIT_LOWER_MAX") @db.Decimal(12, 3)
  wLimitUpperMin   Decimal?  @map("W_LIMIT_UPPER_MIN") @db.Decimal(12, 3)
  wLimitUpperMax   Decimal?  @map("W_LIMIT_UPPER_MAX") @db.Decimal(12, 3)
  prodSpecLowerMin Decimal?  @map("PROD_SPEC_LOWER_MIN") @db.Decimal(12, 3)
  prodSpecLowerMax Decimal?  @map("PROD_SPEC_LOWER_MAX") @db.Decimal(12, 3)
  creatDt          DateTime? @map("CREAT_DT") @db.DateTime

  tool             GaugeAndTools? @relation(fields: [toolRefNo], references: [refNo])

  @@map("TOOLS_SPECIFICATION")
}

model ToolsPriceMaster {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  supCode         String?   @map("SUP_CODE") @db.NVarChar(10)
  toolRefNo       Int?      @map("TOOL_REF_NO")
  revNo           String?   @map("REV_NO") @db.NVarChar(10)
  revDate         DateTime? @map("REV_DATE") @db.DateTime
  revStatus       String?   @map("REV_STATUS") @db.NVarChar(30)
  approvalStatus  String?   @map("APPROVAL_STATUS") @db.NVarChar(30)
  approvalDate    DateTime? @map("APPROVAL_DATE") @db.DateTime
  rate            Decimal?  @map("RATE") @db.Decimal(12, 4)
  remarks         String?   @map("REMARKS") @db.NVarChar(200)
  creatUserIdCd   String?   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime  @map("CREAT_DT") @db.DateTime

  tool            GaugeAndTools? @relation(fields: [toolRefNo], references: [refNo])

  @@map("TOOLS_PRICE_MASTER")
}

model ToolsMapping {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  supCode         String?   @map("SUP_CODE") @db.NVarChar(50)
  toolRefNo       Int?      @map("TOOL_REF_NO")
  creatDt         DateTime  @map("CREAT_DT") @db.DateTime

  tool            GaugeAndTools? @relation(fields: [toolRefNo], references: [refNo])

  @@map("TOOLS_MAPPING")
}

model ToolsMachineTrans {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  toolRefNo       Int?      @map("TOOL_REF_NO")
  macCode         String?   @map("MAC_CODE") @db.NVarChar(25)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime

  tool            GaugeAndTools? @relation(fields: [toolRefNo], references: [refNo])

  @@map("TOOLS_MACHINE_TRANS")
}

// ═══════════════════════════════════════════════════════════════════
// ISSUE / RECEIVE / CONSUMPTION TRANSACTIONS
// ═══════════════════════════════════════════════════════════════════

model GaugeToolsIssue {
  dcNo            String    @id @map("DC_NO") @db.NVarChar(12)
  issueDate       DateTime? @map("ISSUE_DATE") @db.DateTime
  dueDate         DateTime? @map("DUE_DATE") @db.DateTime
  itemType        String?   @map("ITEM_TYPE") @db.NVarChar(100)
  receiveName     String?   @map("RECEIVE_NAME") @db.NVarChar(50)
  subCode         String?   @map("SUB_CODE") @db.NVarChar(10)
  supCode         String?   @map("SUP_CODE") @db.NVarChar(10)
  empId           Int       @map("EMP_ID")
  status          String?   @map("STATUS") @db.NVarChar(15)
  issueOption     String?   @map("ISSUE_OPTION") @db.NVarChar(30)
  custCode        String?   @map("CUST_CODE") @db.NVarChar(12)
  issuePurpose    String?   @map("ISSUE_PURPOSE") @db.NVarChar(100)
  transportName   String?   @map("TRANSPORT_NAME") @db.NVarChar(50)
  vehicleNo       String?   @map("VEHICLE_NO") @db.NVarChar(25)
  dcRefNo         String?   @map("REF_NO") @db.NVarChar(20)
  returnable      String?   @map("RETURNABLE") @db.NVarChar(5)
  receiveNameTwo  String?   @map("RECEIVE_NAME_TWO") @db.NVarChar(50)
  lobType         String?   @map("LOB_TYPE") @db.NVarChar(50)
  fromUnit        String?   @map("FROM_UNIT") @db.NVarChar(15)
  poOrderNo       String?   @map("PO_ORDER_NO") @db.NVarChar(15)
  comments        String?   @map("COMMENTS") @db.NVarChar(100)
  matType         String?   @map("MAT_TYPE") @db.NVarChar(20)
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  receivedHeaders ToolsIssueReceived[]
  lines           ToolsTransIssue[]

  @@map("GAUGE_TOOLS_ISSUE")
}

model ToolsTransIssue {
  // ERP ROW_ID is NOT identity — writers must supply max(ROW_ID)+1
  rowId           Int       @id @map("ROW_ID")
  dcNo            String    @map("DC_NO") @db.NVarChar(12)
  toolOrGaugeNo   String?   @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  issueQty        Decimal?  @map("ISSUE_QTY") @db.Decimal(10, 3)
  partNo          String    @map("PART_NO") @db.NVarChar(50)
  type            String?   @map("TYPE") @db.NVarChar(50)
  serialNo        Int?      @map("SERIAL_NO")
  name            String?   @map("NAME") @db.NVarChar(50)
  description     String?   @map("DESCRIPTION") @db.NVarChar(500)
  processName     String?   @map("NAME_OF_THE_PROCESS") @db.NVarChar(100)
  machine         String?   @map("MACHINE") @db.NVarChar(50)
  remarks         String?   @map("REMARKS") @db.NVarChar(100)
  uom             String?   @map("UOM") @db.NVarChar(10)
  issueType       String?   @map("ISSUE_TYPE") @db.NVarChar(25)
  groupName       String?   @map("GROUP_NAME") @db.NVarChar(50)
  issueToItemNo   String?   @map("ISSUE_TO_ITEM_NO") @db.NVarChar(15)
  issueEmpName    String?   @map("ISSUE_EMP_NAME") @db.NVarChar(50)
  returnable      String?   @map("RETURNABLE") @db.NVarChar(5)
  price           Decimal?  @map("PRICE") @db.Decimal(18, 4)
  amount          Decimal?  @map("AMOUNT") @db.Decimal(18, 4)
  toolRefNo       Int?      @map("TOOL_REF_NO")
  status          String?   @map("STATUS") @db.NVarChar(10)
  dueDate         DateTime? @map("DUE_DATE") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime

  header          GaugeToolsIssue @relation(fields: [dcNo], references: [dcNo])
  tool            GaugeAndTools?  @relation(fields: [toolOrGaugeNo], references: [toolOrGaugeNo])
  toolByRef       GaugeAndTools?  @relation("IssueLineToolByRef", fields: [toolRefNo], references: [refNo], onDelete: NoAction, onUpdate: NoAction)

  @@map("TOOLS_TRANS_ISSUE")
}

model ToolsIssueReceived {
  // ERP REC_NO is NOT identity — writers must supply max(REC_NO)+1
  recNo           Int       @id @map("REC_NO")
  dcNo            String    @map("DC_NO") @db.NVarChar(12)
  receiveDate     DateTime? @map("RECEIVE_DATE") @db.DateTime
  partyDcNo       String?   @map("PARTY_DC_NO") @db.NVarChar(15)
  subCode         String    @map("SUB_CODE") @db.NVarChar(10)
  contName        String?   @map("CONT_NAME") @db.NVarChar(80)
  status          String?   @map("STATUS") @db.NVarChar(15)
  geNo            String?   @map("GE_NO") @db.NVarChar(20)
  geDate          DateTime? @map("GE_DATE") @db.DateTime
