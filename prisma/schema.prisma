// ─────────────────────────────────────────────────────────────────────────────
// Suki HRMS — Prisma Schema
// Datasource: MS SQL Server (production)
// Branch: feature/prisma-base + feature/employee-master-models
//
// SCOPE: Base master/definition tables + soft-delete, RBAC, Employee Master,
// Time Office Phase 1 — Attendance + Leave (section 14), Payroll Processing
// Phase 1 (section 15, migration 000008), Salary Revision & Arrear Phase 1
// (section 16, migration 000009), Bonus Management Phase 1 (section 17,
// migration 000011), SalaryComponent/BonusRate company-scoping (migrations
// 000012/000013), and Gratuity Phase 1 (section 18, migration 000014).
// Performance, Training, Recruitment, Reports, Compliance, Loan/Asset
// transactional logic, and ESS are still out of scope — do not add those
// models here yet.
//
// OPEN QUESTIONS STATUS:
//   Q1. Grade & Level separate              → APPROVED
//   Q2. ESI/PF two tables                   → APPROVED
//   Q3. Site/Branch discriminator           → PENDING CLIENT CONFIRMATION (Site model commented out, will NOT migrate)
//   Q4. isActive + deletedAt                → APPROVED
//   Q5. Slab overlap prevention             → APPROVED: Option D (SQL Server trigger + app-layer validation)
//   Q6. SubDepartment → Department FK       → APPROVED
//   Q7. Int autoincrement                   → APPROVED
//   Q8. ShiftPlan override shape            → APPROVED (spec override fields before Phase 2)
//   Q9. OTPlan shape                        → APPROVED
//   Q10. DropdownMaster isActive             → ALREADY PRESENT (was a summary-table omission, not a schema gap)
//   Q11. Leave/Loan/Asset minimal fields    → APPROVED
//
// Q5 IMPLEMENTATION (Option D — approved):
//   DB-level overlap prevention via SQL Server AFTER INSERT/UPDATE triggers
//   on all 4 slab/rate tables (TDSSlab, ProfessionalTaxSlab, EsiRate, PfRate).
//   Trigger checks no overlapping (effectiveFrom, effectiveTo) ranges exist
//   for the same `code`, rolls back on conflict. App-layer validation in
//   service code provides clean error messages before hitting the DB.
//   Trigger SQL is in: prisma/triggers/slab_overlap_triggers.sql
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. ORGANISATIONAL MASTER TABLES (soft-delete: isActive + deletedAt)
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  // Budgeted/approved staffing count for this department (KUN BRD review,
  // 2026-09-10). "Current" headcount is derived at read time from actual
  // JobInfo assignments, not stored.
  sanctionedHeadcount Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subDepartments SubDepartment[]
  jobInfos       JobInfo[]

  @@map("Department")
}

model SubDepartment {
  id           Int       @id @default(autoincrement())
  departmentId Int
  // Unique per department, not globally (migration 000031) — auto-generated
  // as "<DeptCode>-001", "<DeptCode>-002"... so two departments can each
  // have their own "-001".
  code         String    @db.NVarChar(20)
  name         String    @db.NVarChar(100)
  description  String?   @db.NVarChar(500)
  // Same convention as Department.sanctionedHeadcount.
  sanctionedHeadcount Int?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  jobInfos   JobInfo[]  @relation("SubDepartmentJobInfos")

  @@unique([departmentId, code])
  @@index([departmentId])
  @@map("SubDepartment")
}

model Designation {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  // KUN BRD review (2026-09-10): budget/experience/qualification/headcount
  // added to the Designation master. JD Upload (bulk import) is separate,
  // deferred to a later session.
  budget              Decimal? @db.Decimal(18, 2)
  experienceYears     Decimal? @db.Decimal(4, 1)
  qualification       String?  @db.NVarChar(200)
  sanctionedHeadcount Int?
  // Reporting Structure (KUN BRD review, 2026-09-10): which Designation this
  // one reports to by default — an org-chart template the employee wizard
  // can suggest a Reporting Manager from, not a per-employee assignment.
  reportsToId Int?
  // JD Upload (KUN BRD review, 2026-09-10): populated via bulk Excel/CSV
  // import (Designation Code + Job Description columns), not typed per row
  // in the Designation form itself.
  jobDescription String? @db.NVarChar(Max)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reportsTo    Designation?  @relation("DesignationReportsTo", fields: [reportsToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subordinates Designation[] @relation("DesignationReportsTo")
  jobInfos     JobInfo[]
  grades       Grade[]

  @@map("Designation")
}

model EmployeeType {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobInfos     JobInfo[]
  benefitRates BenefitRateByEmployeeType[]

  @@map("EmployeeType")
}

model Category {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobInfos JobInfo[]

  @@map("Category")
}

// Q3 RESOLVED (KUN BRD review, 2026-09-10): Unit is the legal/org entity —
// stays as-is, just relabelled "Branch / Unit" in the UI. Site is the
// physical location an employee actually reports to — its own master,
// company-scoped the same way Unit is, but deliberately no FK to Unit since
// the client's own wording drew the line at "legal entity vs physical
// location", not a Unit-owns-Sites hierarchy.
model Site {
  id          Int       @id @default(autoincrement())
  companyId   Int
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  address     String?   @db.NVarChar(500)
  city        String?   @db.NVarChar(100)
  state       String?   @db.NVarChar(100)
  pinCode     String?   @db.NVarChar(10)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("Site")
}

// Q3 RESOLVED: full Company master added (multi-company future-proofing).
// Unit is reused as Branch/Site/Plant/Work Location, scoped to a Company.
model Company {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  units                      Unit[]
  employees                  Employee[]
  roles                      Role[]
  users                      User[]
  payrollRuns                PayrollRun[]
  salaryRevisionRequests     SalaryRevisionRequest[]
  salaryArrears              SalaryArrear[]
  bonusRecords               BonusRecord[]
  salaryComponents           SalaryComponent[]
  bonusRates                 BonusRate[]
  gratuityPolicies           GratuityPolicy[]
  gratuityRecords            GratuityRecord[]
  biometricAttendanceImports BiometricAttendanceImport[]
  permissionPolicy           PermissionPolicy?
  holidayMasters              HolidayMaster[]
  benefitRates               BenefitRateByEmployeeType[]
  grossSplitRules            GrossSplitRule[]
  sites                      Site[]
  deductionRates             DeductionRate[]
  pmsIncentiveConfigs        PmsIncentiveConfig[]
  doubleMachineIncentives    DoubleMachineIncentive[]

  @@map("Company")
}

// Unit doubles as Branch/Site/Plant/Work Location — scoped to a Company.
model Unit {
  id          Int       @id @default(autoincrement())
  companyId   Int
  // Unique per company, not globally (migration 000033) — auto-generated as
  // "<CompanyCode>-001", "-002"... so two companies can each have their own "-001".
  code        String    @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  address     String?   @db.NVarChar(500)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  jobInfos JobInfo[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("Unit")
}

// Q1: Drafted as separate table from Level.
model Grade {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  // A grade sits under a designation (migration 000022). Nullable so the
  // rows that predate the link keep loading; the master form requires it.
  designationId Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  designation Designation? @relation(fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  levels      Level[]
  jobInfos    JobInfo[]

  @@index([designationId])
  @@map("Grade")
}

// Q1: Drafted as separate table from Grade.
model Level {
  id          Int       @id @default(autoincrement())
  // Unique per grade (migration 000024): "L1" may exist under several grades.
  code        String    @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  // A level sits under a grade (migration 000023): one grade has many
  // levels and an employee moves between levels within their grade.
  // Nullable so pre-link rows keep loading; the master form requires it.
  gradeId     Int?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  grade    Grade?    @relation(fields: [gradeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobInfos JobInfo[]

  @@unique([gradeId, code])
  @@index([gradeId])
  @@map("Level")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. STATUTORY SLAB / RATE TABLES (versioned: effectiveFrom / effectiveTo)
//    effectiveTo IS NULL → currently active version.
//    Overlap prevention: SQL Server AFTER INSERT/UPDATE triggers (Option D).
//    See prisma/triggers/slab_overlap_triggers.sql
// ─────────────────────────────────────────────────────────────────────────────

model TDSSlab {
  id            Int       @id @default(autoincrement())
  code          String    @db.NVarChar(20)
  minSalary     Decimal   @db.Decimal(18, 2)
  maxSalary     Decimal?  @db.Decimal(18, 2) // NULL = no upper limit
  ratePercent   Decimal   @db.Decimal(5, 2) // e.g. 5.00, 10.00, 20.00
  effectiveFrom DateTime
  effectiveTo   DateTime? // NULL = currently active
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([effectiveFrom, effectiveTo])
  @@index([code])
  @@map("TDSSlab")
}

// Deduction Rates (KUN BRD review, 2026-09-10, item 15) — a catch-all
// rate table for misc. statutory/company deductions (Canteen, Uniform,
// Damage recovery, ...) alongside the dedicated TDS/PT/ESI/PF slabs above.
// Company-scoped, versioned the same way. `isLop` flags the row(s)
// representing Loss-of-Pay / attendance-based deduction — folded in here
// per the client's own call rather than a separate Common Logic section;
// this table stays a read-only rate reference for now, same as
// GrossSplitRule — nothing in payroll consumes it yet.
model DeductionRate {
  id            Int       @id @default(autoincrement())
  companyId     Int
  code          String    @db.NVarChar(20)
  name          String    @db.NVarChar(100)
  deductionType String    @db.NVarChar(10) // "PERCENT" | "FLAT" — how rateValue is interpreted
  rateValue     Decimal   @db.Decimal(10, 2) // a percent (0-100) or a flat currency amount, per deductionType
  isLop         Boolean   @default(false)
  effectiveFrom DateTime
  effectiveTo   DateTime? // NULL = currently active
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, code])
  @@index([effectiveFrom, effectiveTo])
  @@map("DeductionRate")
}

model ProfessionalTaxSlab {
  id            Int       @id @default(autoincrement())
  code          String    @db.NVarChar(20)
  minSalary     Decimal   @db.Decimal(18, 2)
  maxSalary     Decimal?  @db.Decimal(18, 2) // NULL = no upper limit
  monthlyAmount Decimal   @db.Decimal(18, 2) // fixed monthly PT amount
  effectiveFrom DateTime
  effectiveTo   DateTime? // NULL = currently active
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([effectiveFrom, effectiveTo])
  @@index([code])
  @@map("ProfessionalTaxSlab")
}

// Q2: Drafted as two separate tables (EsiRate, PfRate).
model EsiRate {
  id                       Int       @id @default(autoincrement())
  code                     String    @db.NVarChar(20)
  employeeContributionRate Decimal   @db.Decimal(5, 2) // e.g. 0.75
  employerContributionRate Decimal   @db.Decimal(5, 2) // e.g. 3.25
  wageCeilingMonthly       Decimal   @db.Decimal(18, 2) // max monthly wage for ESI applicability
  effectiveFrom            DateTime
  effectiveTo              DateTime? // NULL = currently active
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([effectiveFrom, effectiveTo])
  @@index([code])
  @@map("EsiRate")
}

// Q2: Drafted as two separate tables (EsiRate, PfRate).
model PfRate {
  id                       Int       @id @default(autoincrement())
  code                     String    @db.NVarChar(20)
  employeeContributionRate Decimal   @db.Decimal(5, 2) // e.g. 12.00
  employerContributionRate Decimal   @db.Decimal(5, 2) // e.g. 12.00 (or 3.67 + 8.33 EPS)
  pensionContributionRate  Decimal?  @db.Decimal(5, 2) // EPS share, e.g. 8.33
  wageCeilingMonthly       Decimal   @db.Decimal(18, 2) // max monthly wage for PF applicability
  effectiveFrom            DateTime
  effectiveTo              DateTime? // NULL = currently active
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([effectiveFrom, effectiveTo])
  @@index([code])
  @@map("PfRate")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. SHIFT & OVERTIME DEFINITION TABLES
// ─────────────────────────────────────────────────────────────────────────────

model ShiftMaster {
  id           Int       @id @default(autoincrement())
  code         String    @unique @db.NVarChar(20)
  name         String    @db.NVarChar(100)
  startTime    String    @db.NVarChar(8) // "09:00" (HH:mm)
  endTime      String    @db.NVarChar(8) // "18:00" (HH:mm)
  graceMinutes Int       @default(0)
  // KUN BRD review (2026-09-10): night/snacks/meals allowances for this shift.
  nightAllowed               Boolean @default(false)
  bufferMinutes              Int     @default(0)
  snacksAllowed              Boolean @default(false)
  mealsAllowed               Boolean @default(false)
  snacksMealsDurationMinutes Int?
  description  String?   @db.NVarChar(500)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  jobInfos           JobInfo[]
  dailyAttendances   DailyAttendance[]
  shiftRotationSlots ShiftRotationSlot[]

  @@map("ShiftMaster")
}

// Q9: Drafted as OT rate definition. Confirm shape.
model OTPlan {
  id                     Int       @id @default(autoincrement())
  code                   String    @unique @db.NVarChar(20)
  name                   String    @db.NVarChar(100)
  otRateMultiplier       Decimal   @db.Decimal(5, 2) // e.g. 1.50, 2.00
  applicableAfterMinutes Int       @default(0) // OT kicks in after N minutes
  maxOtHoursPerDay       Int? // NULL = no cap
  // KUN BRD review (2026-09-10): which SalaryComponent the calculated OT
  // amount is credited to on the payslip (e.g. "OT Pay"). OTPlan itself is
  // a global master (no companyId), unlike SalaryComponent — the API
  // validates the chosen component belongs to the caller's own company at
  // write time; nothing enforces that at the DB level.
  payComponentId         Int?
  description            String?   @db.NVarChar(500)
  isActive               Boolean   @default(true)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  payComponent SalaryComponent? @relation(fields: [payComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("OTPlan")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. GENERIC DROPDOWN MASTER
// ─────────────────────────────────────────────────────────────────────────────

// Q10: Drafted with category grouping + label/value + sortOrder.
model DropdownMaster {
  id        Int       @id @default(autoincrement())
  category  String    @db.NVarChar(50) // grouping key, e.g. "gender", "blood_group"
  label     String    @db.NVarChar(100) // display text
  value     String    @db.NVarChar(100) // stored value
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([category, value])
  @@index([category])
  @@map("DropdownMaster")
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. LEAVE / LOAN / ASSET — DEFINITION TABLES (no logic)
// ─────────────────────────────────────────────────────────────────────────────

// Q11: Drafted with minimal definition fields. Confirm if flags needed.
model LeaveMaster {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  // How many days of this leave type an employee gets per year by default —
  // used to seed LeaveBalance.openingBalance/accrued when a new year's
  // balance is created for an employee. Decimal to allow half-day
  // entitlements (e.g. 12.5), same precision as LeaveBalance's own fields.
  defaultAnnualDays Decimal   @default(0) @db.Decimal(5, 2)

  // How this leave type's yearly credit is computed by the annual accrual
  // run (src/lib/leaveAccrual.ts) — FIXED_ANNUAL just credits
  // defaultAnnualDays; EARNED_PER_DAYS_WORKED credits
  // floor(daysWorkedInYear / daysWorkedPerAccrualUnit), e.g. Earned Leave's
  // "1 EL per 20 working days worked" (client BRD). daysWorkedPerAccrualUnit
  // is only meaningful for the EARNED type.
  accrualType              String @default("FIXED_ANNUAL") @db.NVarChar(30)
  daysWorkedPerAccrualUnit Int?

  // Carry-forward at year-end: if not allowed (e.g. Casual Leave per BRD —
  // "no carry forward to next year"), the accrual run always starts the new
  // year's openingBalance at 0 regardless of the prior year's closing
  // balance. carryForwardMaxDays caps what carries over when it IS allowed;
  // null means uncapped.
  carryForwardAllowed Boolean  @default(false)
  carryForwardMaxDays Decimal? @db.Decimal(5, 2)

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leaveApplications LeaveApplication[]
  leaveBalances     LeaveBalance[]

  @@map("LeaveMaster")
}

// Per-company holiday calendar. Was a genuine gap called out while building
// OT Approval: without this, "Sunday or Holiday work" (BRD) could only ever
// detect Sunday via date math — a day off for a declared holiday landed as
// ordinary attendance with no way to offer the same OT/Comp-Off choice.
// Company-scoped (not global like LeaveMaster) since holiday calendars are
// genuinely company/location-specific, not shared policy.
model HolidayMaster {
  id          Int       @id @default(autoincrement())
  companyId   Int
  date        DateTime  @db.Date
  name        String    @db.NVarChar(100)
  // KUN BRD review (2026-09-10): COMPANY | FESTIVAL | GOVERNMENT | OTHER.
  holidayType String    @default("OTHER") @db.NVarChar(20)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, date])
  @@index([companyId])
  @@map("HolidayMaster")
}

model LoanType {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  // KUN BRD review (2026-09-10): min/max amount this loan type may be sanctioned for.
  minAmount   Decimal?  @db.Decimal(18, 2)
  maxAmount   Decimal?  @db.Decimal(18, 2)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("LoanType")
}

model AssetMaster {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assetAllocations EmployeeAssetAllocation[]

  @@map("AssetMaster")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. AUTH + RBAC SKELETON
//    (feature/auth-rbac branch — included here so schema is complete)
// ─────────────────────────────────────────────────────────────────────────────

// Role codes are scoped per company (e.g. "hr-admin" can exist once per
// company, not once globally) — see Company-scoped RBAC plan.
model Role {
  id          Int       @id @default(autoincrement())
  companyId   Int
  code        String    @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rolePermissions RolePermission[]
  users           User[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("Role")
}

model Permission {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(50) // e.g. "employee.view", "payroll.run"
  module      String    @db.NVarChar(50) // top-level module, e.g. "employee"
  submodule   String?   @db.NVarChar(50) // sub-module, e.g. "profile"
  page        String?   @db.NVarChar(50) // page-level, e.g. "list"
  action      String    @db.NVarChar(20) // "view" | "create" | "edit" | "delete" | "export"
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([module, submodule, page])
  @@map("Permission")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("RolePermission")
}

// ─────────────────────────────────────────────────────────────────────────────
// 6b. USERS (feature/auth-login)
//    Login credentials + role assignment. FK to Role.
//    Soft-delete pattern (isActive + deletedAt) — same as all other tables.
// ─────────────────────────────────────────────────────────────────────────────

// Two shapes of User: a platform superadmin (isSuperAdmin: true, companyId
// and roleId both null — not tied to any company, no RBAC role) or a
// company-scoped user (isSuperAdmin: false, companyId + roleId required).
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.NVarChar(100)
  passwordHash String    @db.NVarChar(255)
  companyId    Int?
  roleId       Int?
  isSuperAdmin Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role     Role?     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee?

  @@index([roleId])
  @@index([companyId])
  @@map("User")
}

// ─────────────────────────────────────────────────────────────────────────────
// 7. EMPLOYEE MASTER (feature/employee-master-models)
//
//    Employee is the core record. Related data is split into sub-tables
//    (PersonalDetails, JobInfo, SalaryStructure, Dependents, Experience,
//    Education, Documents, ExitInterview) — each FKs back to Employee.
//
//    JobInfo FKs into the already-merged Org structure tables:
//      Department, SubDepartment, Designation, EmployeeType, Category,
//      Grade, Level, Unit, ShiftMaster, ShiftRotationPlan
//
//    Asset allocation is a read-only reference via EmployeeAssetAllocation
//    join table → AssetMaster. No asset data duplicated on Employee.
//
//    OPEN QUESTIONS (Employee Master):
//      E1. Employee code format — auto-generated or manual? Pattern?
//          DRAFTED: manual entry, NVarChar(20), unique.
//      E2. Should Employee have a status enum (active/on-leave/terminated/resigned)?
//          DRAFTED: Yes — status String with NVarChar(20) for flexibility.
//          Future: constrain via DropdownMaster or enum.
//      E3. Multiple JobInfo records (history) or single current record?
//          DRAFTED: Multiple — JobInfo has effectiveFrom/effectiveTo for
//          job history tracking. Only one record with effectiveTo = NULL
//          at a time (current job info).
//      E4. SalaryStructure — single current CTC or versioned history?
//          DRAFTED: Versioned — effectiveFrom/effectiveTo, same pattern
//          as slab tables. Only one active record at a time.
//      E5. Documents — one row per document type or a generic documents table?
//          DRAFTED: One row per document type with typed fields for
//          Aadhaar/PAN/Passport/DL + expiry tracking. Generic document
//          uploads via separate Document table for other files.
//      E6. KPI/JD attachment — separate table or fields on Employee?
//          DRAFTED: Separate EmployeeDocument table with docType =
//          "kpi" | "jd" | "other". Placeholder only — no UI beyond stub.
//      E7. ExitInterview — on Employee or separate?
//          DRAFTED: Separate model, 1:1 with Employee, created on exit.
//      E8. Reporting manager — self-referential FK on Employee?
//          DRAFTED: Yes — reportingManagerId Int? self-FK on Employee.
//      E9. Bank details — on Employee or separate table?
//          DRAFTED: Separate EmployeeBankDetail (1:1) — multiple bank
//          accounts may be needed in future.
// ─────────────────────────────────────────────────────────────────────────────

// E1: Manual code entry for now. Auto-generation pattern TBD.
// Q3/emp-code RESOLVED: employeeCode is unique per Company, not globally.
model Employee {
  id                 Int     @id @default(autoincrement())
  companyId          Int
  userId             Int?    @unique // optional linked login account (Job Profile tab)
  employeeCode       String  @db.NVarChar(20)
  oldEmployeeCode    String? @db.NVarChar(20)
  title              String? @db.NVarChar(10) // Mr/Mrs/Ms/Dr — via DropdownMaster
  firstName          String  @db.NVarChar(100)
  middleName         String? @db.NVarChar(100)
  lastName           String  @db.NVarChar(100)
  profilePhotoPath   String? @db.NVarChar(500)
  signaturePath      String? @db.NVarChar(500)
  // E2: Status as flexible string — constrain via DropdownMaster later
  status             String  @default("active") @db.NVarChar(20) // active | on-leave | terminated | resigned
  guestEmployee      Boolean @default(false)
  inductionStatus    String? @db.NVarChar(30)
  // E8: Self-referential FK for reporting manager
  reportingManagerId       Int?
  // Level 2: skip-level / second reporting manager
  secondReportingManagerId Int?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Self-referential relation for reporting manager
  // NoAction required to break cyclic cascade through child tables
  reportingManager       Employee?  @relation("EmployeeToManager", fields: [reportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports          Employee[] @relation("EmployeeToManager")
  secondReportingManager Employee?  @relation("EmployeeToSecondManager", fields: [secondReportingManagerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  secondLevelReports     Employee[] @relation("EmployeeToSecondManager")

  // 1:1 relations
  personalDetails PersonalDetails?
  contactDetails  EmployeeContactDetails?
  bankDetail      EmployeeBankDetail?
  passport        EmployeePassport?
  kyc             EmployeeKyc?
  exitInterview   ExitInterview?

  // 1:N relations (versioned tables are 1:N, not 1:1)
  jobInfos                   JobInfo[]
  salaryStructures           SalaryStructure[] // legacy — superseded by salaryRevisions, kept for no-destructive-migration
  salaryRevisions            EmployeeSalaryRevision[]
  ctcRecords                 EmployeeCtc[]
  dependents                 EmployeeDependent[]
  experiences                EmployeeExperience[]
  educations                 EmployeeEducation[]
  documents                  EmployeeDocument[]
  assetAllocations           EmployeeAssetAllocation[]
  emergencyContacts          EmployeeEmergencyContact[]
  skills                     EmployeeSkill[]
  activities                 EmployeeActivity[]
  dailyAttendances           DailyAttendance[]
  monthlyAttendance          MonthlyAttendanceSummary[]
  leaveApplications          LeaveApplication[]
  leaveBalances              LeaveBalance[]
  mispunchCorrections        MispunchCorrection[]
  permissionRequests         PermissionRequest[]
  pmsIncentives              PmsIncentive[]
  doubleMachineIncentives    DoubleMachineIncentive[]
  payrollLines               PayrollLine[]
  salaryRevisionRequests     SalaryRevisionRequest[]
  salaryArrears              SalaryArrear[]
  bonusRecords               BonusRecord[]
  gratuityRecords            GratuityRecord[]
  biometricAttendanceImports BiometricAttendanceImport[]
  dailyAttendanceHistory     DailyAttendanceHistory[]

  @@unique([companyId, employeeCode])
  @@index([reportingManagerId])
  @@index([secondReportingManagerId])
  @@index([status])
  @@map("Employee")
}

// Personal details — 1:1 with Employee
// Address + emergency-contact fields moved to EmployeeContactDetails /
// EmployeeEmergencyContact (spec: Contact Details is a separate tab).
model PersonalDetails {
  id                           Int       @id @default(autoincrement())
  employeeId                   Int       @unique
  dateOfBirth                  DateTime?
  gender                       String?   @db.NVarChar(20) // via DropdownMaster
  bloodGroup                   String?   @db.NVarChar(10) // via DropdownMaster
  maritalStatus                String?   @db.NVarChar(20) // via DropdownMaster
  marriageDate                 DateTime?
  numberOfChildren             Int?
  nationality                  String?   @db.NVarChar(50)
  religion                     String?   @db.NVarChar(50)
  category                     String?   @db.NVarChar(50) // via DropdownMaster (general category)
  physicallyChallenged         Boolean   @default(false)
  physicallyChallengedCategory String?   @db.NVarChar(50)
  internationalWorker          Boolean   @default(false)
  heightCm                     Decimal?  @db.Decimal(5, 2)
  weightKg                     Decimal?  @db.Decimal(5, 2)
  shirtSize                    String?   @db.NVarChar(10)
  pantSize                     String?   @db.NVarChar(10)
  shoeSize                     String?   @db.NVarChar(10)
  issuedMobileNumber           String?   @db.NVarChar(20)
  mobileDeductionApplicable    Boolean   @default(false)
  canteenAllowanceApplicable   Boolean   @default(false)
  loanInstalmentMonth          String?   @db.NVarChar(20)
  // Personal email only — phone/mobile live on EmployeeContactDetails
  personalEmail                String?   @db.NVarChar(100)
  ndaDocument                  Boolean   @default(false)
  fitnessCertificate           Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("PersonalDetails")
}

// Contact Details — 1:1 with Employee. Structured permanent/present address.
model EmployeeContactDetails {
