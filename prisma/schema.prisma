}

model ToolsPoSchMaster {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  schDate         DateTime? @map("SCH_DATE") @db.DateTime
  poOrderNo       String?   @map("PO_ORDER_NO") @db.NVarChar(50)
  status          String?   @map("STATUS") @db.NVarChar(20)
  remarks         String?   @map("REMARKS") @db.NVarChar(300)
  creatDt         DateTime  @map("CREAT_DT") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)

  lines           ToolsPoSchTrans[]

  @@map("TOOLS_PO_SCH_MASTER")
}

model ToolsPoSchTrans {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  refNo           Int       @map("REF_NO")
  poTransNo       Int       @map("PO_TRANS_NO")
  qty             Decimal?  @map("QTY") @db.Decimal(12, 2)
  schStatus       String?   @map("SCH_STATUS") @db.NVarChar(20)
  comments        String?   @map("COMMENTS") @db.NVarChar(300)
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
