  prodToleranceMin  String?   @map("PROD_TOLERANCE_MIN") @db.NVarChar(50)
  prodToleranceMax  Decimal?  @map("PROD_TOLERANCE_MAX")
  calibFrequency     Int?      @map("CALIB_FREQUENCY")
  creatUserIdCd     String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
