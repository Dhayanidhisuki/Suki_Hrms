// ─────────────────────────────────────────────────────────────────────────────
// 11. EMPLOYEE ACTIVITY — 1:N with Employee. Read-only audit timeline.
//     Written via src/lib/activity-log.ts inside each mutating endpoint's
//     transaction. Never store passwords or full sensitive KYC/bank values.
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeActivity {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  activityType      String   @db.NVarChar(50) // e.g. "created" | "job_info_updated" | "status_changed"
  activityAt        DateTime @default(now())
  performedByUserId Int?
  module            String   @db.NVarChar(50) // e.g. "basic" | "personal" | "contact" | "job_profile"
  oldValue          String?  @db.NVarChar(2000)
  newValue          String?  @db.NVarChar(2000)
  remarks           String?  @db.NVarChar(500)
  source            String?  @db.NVarChar(30) // "web" | "api" | "seed"
  relatedRecordId   Int?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([activityAt])
  @@map("EmployeeActivity")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. DYNAMIC SALARY COMPONENTS (replaces hardcoded SalaryStructure columns)
//     Only one EmployeeSalaryRevision per employee may have effectiveTo = NULL
//     — enforced via SQL Server trigger, same Option D pattern as the slab
//     tables (see prisma/triggers/tr_EmployeeSalaryRevision_no_overlap.sql).
// ─────────────────────────────────────────────────────────────────────────────

// Company-scoped since migration 000012 — each company manages its own
// catalog via /masters/salary-components. isSystemDefined marks the 7 codes
// Payroll/Arrear/Bonus depend on by code (BASIC, PF, ESI, ARREAR_GROSS,
// ARREAR_PF, ARREAR_ESI, BONUS — see src/lib/defaultSalaryComponents.ts):
// the CRUD routes refuse to edit/delete those rows so a company admin can't
// break the built-in calculations, but can freely add their own components.
model SalaryComponent {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String    @db.NVarChar(30)
  name              String    @db.NVarChar(100)
  type              String    @db.NVarChar(30) // earning | deduction | employer_contribution
  isSystemDefined   Boolean   @default(false)
  // Whether this component counts toward "eligible salary" in the Gratuity
  // calculation (BRD §10's "Include in Gratuity: Yes/No") — see
  // src/lib/gratuityCalculation.ts. Defaults false; a company admin opts
  // components in via this Masters page.
  includeInGratuity Boolean   @default(false)
  // KUN BRD review (2026-09-10): whether this component counts toward the
  // ESI / PF eligible-wage base — same convention as includeInGratuity.
  includeInEsi      Boolean   @default(false)
  includeInPf       Boolean   @default(false)
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company             Company                   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeComponents  EmployeeSalaryComponent[]
  payrollLineItems    PayrollLineComponent[]
  salaryRevisionItems SalaryRevisionComponent[]
  benefitRates        BenefitRateByEmployeeType[]
  grossSplitRule      GrossSplitRule?
  otPlansPayingHere   OTPlan[]
  pmsIncentives       PmsIncentive[]
  pmsIncentiveConfigs PmsIncentiveConfig[]

  @@unique([companyId, code])
  @@map("SalaryComponent")
}

// Common Logic > Gross % Split (KUN BRD review, 2026-09-10): the fixed
// percentage of Gross Salary each earning SalaryComponent is entitled to
// (e.g. Basic = 40%, HRA = 20%). Company-scoped, one row per component.
// Read-only reference table for now — nothing in payroll consumes it yet;
// wiring it into Salary Revision's component auto-fill is a later session.
model GrossSplitRule {
  id                Int      @id @default(autoincrement())
  companyId         Int
  salaryComponentId Int      @unique
  percentOfGross    Decimal  @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("GrossSplitRule")
}

// Per-Employee-Type monthly rate for a benefit (BRD: Canteen Deduction and
// Petrol Allowance both vary "based on company" by employee category —
// EmployeeType is the mandatory-on-JobInfo axis that matches the BRD's own
// Staff/Trainee/Operator framing, see JobInfo.employeeTypeId). The rate
// itself is company-configured (no client-confirmed figures exist yet);
// what's fixed is the mechanism — a flat monthly amount per employee type,
// applied as an ad-hoc PayrollLineComponent via
// src/app/api/payroll/runs/[id]/apply-benefit-rates/route.ts, prorated for
// Canteen by the same payableDays/totalWorkingDays factor
// payrollCalculation.ts already uses for recurring components (BRD:
// "prorated based on absence"). One row per (company, component, type).
model BenefitRateByEmployeeType {
  id                Int      @id @default(autoincrement())
  companyId         Int
  salaryComponentId Int
  employeeTypeId    Int
  amount            Decimal  @db.Decimal(18, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeType    EmployeeType    @relation(fields: [employeeTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, salaryComponentId, employeeTypeId])
  @@map("BenefitRateByEmployeeType")
}

model PmsIncentiveConfig {
  id            Int      @id @default(autoincrement())
  companyId     Int
  financialYear String   @db.NVarChar(10) // e.g. "2026-27"
  effectiveFrom DateTime
  effectiveTo   DateTime

  calculationBasis  String @default("basic") @db.NVarChar(30) // basic | gross | ctc | target_incentive | component
  salaryComponentId Int? // required when calculationBasis = 'component'
  incentiveType     String @default("percentage") @db.NVarChar(20) // percentage | fixed

  companyPercent        Decimal  @default(0) @db.Decimal(5, 2)
  companyValue          Decimal? @db.Decimal(18, 2) // fixed-value mode
  targetIncentiveAmount Decimal? @db.Decimal(18, 2) // basis = target_incentive

  remarks String? @db.NVarChar(500)
  status  String  @default("active") @db.NVarChar(20) // draft | active | finalized

  createdByUserId Int?
  updatedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pmsIncentives   PmsIncentive[]

  @@unique([companyId, financialYear])
  @@map("PmsIncentiveConfig")
}

// Performance Incentive — one employee-level row per period. A row starts as
// a draft while the Reporting Manager keys the individual %, moves to
// submitted for HR review, then approved / rejected / returned. HR/Admin may
// override any field; every mutation is mirrored into EmployeeActivity
// (module = 'pms') for the audit trail the BRD requires.
model PmsIncentive {
  id            Int  @id @default(autoincrement())
  employeeId    Int
  configId      Int?
  year          Int // anchor year of the configured effective period
  month         Int // anchor month (1-12) of the configured effective period
  financialYear String? @db.NVarChar(10)

  calculationBasis  String? @db.NVarChar(30) // copied from config at save time
  salaryComponentId Int? // 'component' basis snapshot
  incentiveType     String  @default("percentage") @db.NVarChar(20) // percentage | fixed
  basisAmount       Decimal @default(0) @db.Decimal(18, 2)

  companyPercent Decimal  @default(0) @db.Decimal(5, 2)
  managerPercent Decimal  @default(0) @db.Decimal(5, 2) // "Individual %" in the BRD
  totalPercent   Decimal  @default(0) @db.Decimal(5, 2)

  companyValue    Decimal? @db.Decimal(18, 2) // fixed-value mode
  individualValue Decimal? @db.Decimal(18, 2) // fixed-value mode
  companyAmount   Decimal  @default(0) @db.Decimal(18, 2)
  individualAmount Decimal @default(0) @db.Decimal(18, 2)
  overallAmount   Decimal  @default(0) @db.Decimal(18, 2)

  // Attendance-based payout computation, stored at save time (the "fixed"
  // Performance Incentive salary component is the base, MonthlyAttendance
  // .presentDays prorates it over the calendar month, PMS % scales it, and
  // ESI shares split off the earned amount):
  //   incentiveMoney = performanceIncentive / monthDays * presentDays
  //   incentiveEarn  = incentiveMoney * totalPercent / 100
  //   employeeEsi    = incentiveEarn * 0.75 / 100
  //   employerEsi    = incentiveEarn * 3.25 / 100
  //   pmsNet         = incentiveEarn - employeeEsi
  performanceIncentive Decimal @default(0) @db.Decimal(18, 2)
  monthDays            Int     @default(0)
  presentDays          Decimal @default(0) @db.Decimal(5, 2)
  incentiveMoney       Decimal @default(0) @db.Decimal(18, 2)
  incentiveEarn        Decimal @default(0) @db.Decimal(18, 2)
  employeeEsi          Decimal @default(0) @db.Decimal(18, 2)
  employerEsi          Decimal @default(0) @db.Decimal(18, 2)
  pmsNet               Decimal @default(0) @db.Decimal(18, 2)

  // draft | submitted | under_review | approved | rejected | returned | finalized
  status String @default("draft") @db.NVarChar(20)

  supportingFileName String? @db.NVarChar(200)
  supportingFilePath String? @db.NVarChar(500)
  remarks            String? @db.NVarChar(500)
  rejectionReason    String? @db.NVarChar(500)

  managerActionByUserId Int? // who entered / submitted the individual incentive
  managerActionAt       DateTime?
  hrActionByUserId      Int? // HR approver / rejector / overrider
  hrActionAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee        Employee            @relation(fields: [employeeId], references: [id])
  config          PmsIncentiveConfig? @relation(fields: [configId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent?    @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, year, month])
  @@index([configId])
  @@index([status])
  @@map("PmsIncentive")
}

// Double Machine Incentive — BRD B5/B6 + Suki ERP DOUBLE_MACHINE_INCENTIVE
// / INCENTIVE_DET_MULTI_MACHINE. Manual HR entry per employee per month
// (employee, Double Machine, Att.Bonus, Shift Incentive, OT Weekly Inc,
// Employee R, status). Employee code/name/dept/designation come from
// Employee + JobInfo, not stored here.
model DoubleMachineIncentive {
  id              Int     @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  year            Int
  month           Int // 1-12
  doubleMachine   Decimal @default(0) @db.Decimal(18, 2)
  attendanceBonus Decimal @default(0) @db.Decimal(18, 2)
  shiftIncentive  Decimal @default(0) @db.Decimal(18, 2)
  otWeeklyInc     Decimal @default(0) @db.Decimal(18, 2)
  employeeR       Decimal @default(0) @db.Decimal(18, 2)

  // draft | process | hold | complete
  status  String  @default("draft") @db.NVarChar(20)
  remarks String? @db.NVarChar(500)

  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, year, month])
  @@index([companyId, year, month])
  @@index([status])
  @@map("DoubleMachineIncentive")
}

model EmployeeSalaryRevision {
  id                  Int       @id @default(autoincrement())
  employeeId          Int
  financialYear       String?   @db.NVarChar(10) // e.g. "2026-27"
  grossSalary         Decimal   @db.Decimal(18, 2)
  netSalary           Decimal?  @db.Decimal(18, 2)
  lastUpdatedByUserId Int?
  effectiveFrom       DateTime
  effectiveTo         DateTime? // NULL = current

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee           Employee                  @relation(fields: [employeeId], references: [id])
  components         EmployeeSalaryComponent[]
  // Reverse of SalaryRevisionRequest.appliedRevisionId — the request whose
  // approval created this version, if it was created via that workflow
  // rather than the direct Employee > Salary tab entry.
  appliedFromRequest SalaryRevisionRequest?

  @@index([employeeId])
  @@index([effectiveFrom, effectiveTo])
  @@map("EmployeeSalaryRevision")
}

model EmployeeSalaryComponent {
  id                Int     @id @default(autoincrement())
  salaryRevisionId  Int
  salaryComponentId Int
  amount            Decimal @db.Decimal(18, 2)

  salaryRevision  EmployeeSalaryRevision @relation(fields: [salaryRevisionId], references: [id])
  salaryComponent SalaryComponent        @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryRevisionId, salaryComponentId])
  @@map("EmployeeSalaryComponent")
}

// ─────────────────────────────────────────────────────────────────────────────
// 13. CTC — versioned like salary revision, same overlap-prevention approach.
//     Manually configured values only — no CTC/PF/ESI/gratuity formulas
//     invented here (spec §6.6 explicitly forbids inventing formulas).
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeCtc {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  basic                Decimal   @db.Decimal(18, 2)
  specialAllowance     Decimal   @default(0) @db.Decimal(18, 2)
  hra                  Decimal   @default(0) @db.Decimal(18, 2)
  conveyanceAllowance  Decimal   @default(0) @db.Decimal(18, 2)
  washAllowance        Decimal   @default(0) @db.Decimal(18, 2)
  canteen              Decimal   @default(0) @db.Decimal(18, 2)
  dislocationAllowance Decimal   @default(0) @db.Decimal(18, 2)
  otherAllowance       Decimal   @default(0) @db.Decimal(18, 2)
  shiftAllowance       Decimal   @default(0) @db.Decimal(18, 2)
  attendanceBonus      Decimal   @default(0) @db.Decimal(18, 2)
  employeePf           Decimal   @default(0) @db.Decimal(18, 2)
  employeeEsi          Decimal   @default(0) @db.Decimal(18, 2)
  bonus                Decimal   @default(0) @db.Decimal(18, 2)
  lta                  Decimal   @default(0) @db.Decimal(18, 2)
  medicalClaim         Decimal   @default(0) @db.Decimal(18, 2)
  gratuity             Decimal   @default(0) @db.Decimal(18, 2)
  employerPf           Decimal   @default(0) @db.Decimal(18, 2)
  employerEsi          Decimal   @default(0) @db.Decimal(18, 2)
  otherBenefits        Decimal   @default(0) @db.Decimal(18, 2)
  nonMonetaryBenefits  Decimal   @default(0) @db.Decimal(18, 2)
  monthlyCtc           Decimal   @db.Decimal(18, 2)
  annualCtc            Decimal   @db.Decimal(18, 2)
  effectiveFrom        DateTime
  effectiveTo          DateTime? // NULL = current

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveFrom, effectiveTo])
  @@map("EmployeeCtc")
}

// ─────────────────────────────────────────────────────────────────────────────
// 14. TIME OFFICE — PHASE 1 (Daily/Monthly Attendance + Leave)
//     Scope: the true dependency root for Payroll/PT/Bonus — LOP is
//     Attendance + Leave + Permission + Holiday/Weekly-Off, per BRD.
//     Deferred to a later phase: Comp-Off ledger, standalone Permission
//     requests, OT as its own approval queue (otMinutes are still captured
//     per day so this needs no follow-up migration), biometric device sync,
//     Canteen Token, Petrol Allowance amount, Performance/Double-Machine
//     Incentive.
//     *UserId fields are bare Int (no FK relation), matching
//     EmployeeActivity.performedByUserId — avoids SQL Server's
//     multiple-cascade-path restriction and keeps this consistent with the
//     existing audit-trail convention.
// ─────────────────────────────────────────────────────────────────────────────

// One row per employee per calendar date. Corrections happen in place with a
// mandatory remark, not by superseding rows — this is a daily fact table, not
// a versioned "current vs historical" table like JobInfo/SalaryStructure.
model DailyAttendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date

  // Snapshot of the shift that applied this day — not a live FK the shift
  // master can retroactively change out from under a finalized day.
  shiftMasterId Int?

  // Present | Absent | HalfDay | WeeklyOff | Holiday | Leave | Permission |
  // OnDuty | MissingPunch | LOP — free string, same convention as
  // Employee.status (constrain via DropdownMaster later, not now).
  status String @db.NVarChar(20)

  inTime  DateTime?
  outTime DateTime?

  workingMinutes      Int     @default(0)
  lateMinutes         Int     @default(0)
  earlyOutMinutes     Int     @default(0)
  otMinutesCalculated Int     @default(0)
  otMinutesApproved   Int?
  // pending_manager | pending_hr | approved | rejected — null until OT
  // calculated > 0 AND the employee is OT-eligible (JobInfo.overtimeAllowed)
  // — see upsertDailyAttendanceWithHistory's auto-queue logic. Two-stage
  // approval (Reporting Manager, then HR), same pattern as
  // MispunchCorrection, but tracked directly on the day instead of a
  // separate request table since OT isn't employee-initiated.
  otApprovalStatus String? @db.NVarChar(20)
  // OT | COMP_OFF — set at HR approval time. Only meaningful for work on a
  // Sunday/weekly-off (BRD: "Either based on approval"); weekday OT is
  // always settled as OT. COMP_OFF credits the employee's Compensatory Off
  // leave balance instead of approving paid overtime minutes.
  otSettlementType String? @db.NVarChar(20)

  otManagerActionByUserId Int?
  otManagerActionAt       DateTime?
  otHrActionByUserId      Int?
  otHrActionAt            DateTime?
  otRejectionReason       String?   @db.NVarChar(500)

  // manual | biometric — everything is "manual" in Phase 1; the column
  // exists now so a future biometric-sync phase needs no migration.
  source String @default("manual") @db.NVarChar(20)

  remarks         String? @db.NVarChar(500)
  createdByUserId Int?
  updatedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id])
  shiftMaster ShiftMaster? @relation(fields: [shiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("DailyAttendance")
}

// The "Time Office Final" rollup + freeze gate for one employee/month —
// computed from DailyAttendance + LeaveApplication, not entered directly.
// Change history for DailyAttendance. One row per overwrite, holding the
// values as they were BEFORE that change — so a biometric re-import (or a
// manual correction) never destroys what was there. The live
// DailyAttendance row is always the current value; walking its history
// rows newest-first replays how it got there.
//
// Written only when a value actually changes (an identical re-import
// writes nothing), by both write paths: the manual Daily Attendance route
// and the biometric conversion — see recordDailyAttendanceChange in
// src/lib/attendanceHistory.ts. Deliberately has no FK to
// DailyAttendance: history outlives the row it describes, and is keyed by
// the same natural [employeeId, date] pair.
model DailyAttendanceHistory {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date

  // Snapshot of the superseded values.
  status              String    @db.NVarChar(20)
  inTime              DateTime?
  outTime             DateTime?
  workingMinutes      Int       @default(0)
  lateMinutes         Int       @default(0)
  earlyOutMinutes     Int       @default(0)
  otMinutesCalculated Int       @default(0)
  otMinutesApproved   Int?
  otApprovalStatus    String?   @db.NVarChar(20)
  source              String    @db.NVarChar(20)
  remarks             String?   @db.NVarChar(500)

  // What replaced them.
  changedByUserId Int?
  changedBySource String   @db.NVarChar(20) // manual | biometric
  changedAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId, date])
  @@index([changedAt])
  @@map("DailyAttendanceHistory")
}

model MonthlyAttendanceSummary {
  id         Int @id @default(autoincrement())
  employeeId Int
  year       Int
  month      Int // 1-12

  totalWorkingDays     Int      @default(0)
  payableDays          Decimal  @default(0) @db.Decimal(5, 2)
  presentDays          Decimal  @default(0) @db.Decimal(5, 2)
  absentDays           Decimal  @default(0) @db.Decimal(5, 2)
  leaveDays            Decimal  @default(0) @db.Decimal(5, 2)
  lopDays              Decimal  @default(0) @db.Decimal(5, 2)
  otMinutesTotal       Int      @default(0)
  lateMinutesTotal     Int      @default(0)
  earlyOutMinutesTotal Int      @default(0)

  // OPEN | FINALIZED | FROZEN
  status String @default("OPEN") @db.NVarChar(20)

  finalizedAt       DateTime?
  finalizedByUserId Int?
  frozenAt          DateTime?
  reopenedAt        DateTime?
  reopenedByUserId  Int?
  reopenReason      String?   @db.NVarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, year, month])
  @@index([employeeId])
  @@map("MonthlyAttendanceSummary")
}

// Biometric/legacy attendance landing table — Phase 1. One row per
// (company, EMP_ID, year, wage period), merging the three legacy tables the
// client actually exports from (HRMS_EMP_MON_ATT_DETAILS for day1..day31
// hours, HRMS_EMP_DAILY_ATT_DETAILS_INTIME / _OUTTIME for day1InTime../
// day1OutTime.. — real per-day punch times, raw HH.MM encoding from the
// source, parsed to a real time only in src/lib/biometricConversion.ts, not
// here). FROM_WHERE distinguishes MANUAL vs BIOMETRIC rows sharing this one
// table, per the client's explicit requirement. periodStartDate is the one
// field with no source equivalent — ATT_FOR_MONTH ("Feb-Mar") is a
// cutoff-date wage period, not a calendar month, so day1 needs a real anchor
// date supplied at import time. See src/lib/biometricConversion.ts for how
// this flows into DailyAttendance/MonthlyAttendanceSummary.
// One run of the device-API sync (src/lib/biometricSync.ts) — scheduled
// every N hours from src/instrumentation.ts or triggered manually from the
// Biometric page. Keeps the outcome and the device user IDs that matched no
// employee, so HR can map them via Employee Code (oldEmployeeCode).
model BiometricSyncRun {
  id                Int       @id @default(autoincrement())
  companyId         Int
  trigger           String    @db.NVarChar(20) // scheduled | manual
  rangeStart        DateTime  @db.Date
  rangeEnd          DateTime  @db.Date
  status            String    @default("running") @db.NVarChar(20) // running | success | failed
  rowsFetched       Int       @default(0)
  daysCreated       Int       @default(0)
  daysUpdated       Int       @default(0)
  daysUnchanged     Int       @default(0)
  skippedFrozen     Int       @default(0)
  unmatchedUserIds  String?   @db.NVarChar(Max) // JSON: [{ userid, username, days }]
  error             String?   @db.NVarChar(2000)
  triggeredByUserId Int?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?

  @@index([companyId, startedAt])
  @@map("BiometricSyncRun")
}

model BiometricAttendanceImport {
  id          Int    @id @default(autoincrement())
  companyId   Int
  empIdRaw    String @db.NVarChar(20) // source EMP_ID, kept as string — not assumed numeric
  year        Int
  attForMonth String @db.NVarChar(30) // e.g. "Feb-Mar"

  periodStartDate DateTime @db.Date // anchors day1 — no source equivalent, required at import

  refNo           Int?
  total           Decimal   @default(0) @db.Decimal(10, 2)
  totalLom        Decimal   @default(0) @db.Decimal(10, 2)
  totalOtHrs      Decimal   @default(0) @db.Decimal(10, 2)
  fromWhere       String    @default("MANUAL") @db.NVarChar(20) // MANUAL | BIOMETRIC
  attEndMonth     DateTime?
  creatUserIdCd   String?   @db.NVarChar(50)
  creatDt         DateTime?
  lstUpdtUserIdCd String?   @db.NVarChar(50)
  lstUpdtTs       DateTime?

  // Hours worked that day, from HRMS_EMP_MON_ATT_DETAILS.DAY1..DAY31
  day1  Decimal? @db.Decimal(6, 2)
  day2  Decimal? @db.Decimal(6, 2)
  day3  Decimal? @db.Decimal(6, 2)
  day4  Decimal? @db.Decimal(6, 2)
  day5  Decimal? @db.Decimal(6, 2)
  day6  Decimal? @db.Decimal(6, 2)
  day7  Decimal? @db.Decimal(6, 2)
  day8  Decimal? @db.Decimal(6, 2)
  day9  Decimal? @db.Decimal(6, 2)
  day10 Decimal? @db.Decimal(6, 2)
  day11 Decimal? @db.Decimal(6, 2)
  day12 Decimal? @db.Decimal(6, 2)
