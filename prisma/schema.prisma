  @@map("EmployeeEmergencyContact")
}

// E3: JobInfo is versioned — effectiveFrom/effectiveTo for job history.
//     Only one record with effectiveTo = NULL = current job info.
//     FKs into existing Org structure tables — no redefinition.
model JobInfo {
  id                               Int       @id @default(autoincrement())
  employeeId                       Int
  // FKs into merged Org tables
  departmentId                     Int
  subDepartmentId                  Int?
  designationId                    Int
  employeeTypeId                   Int
  categoryId                       Int?
  gradeId                          Int?
  levelId                          Int?
  unitId                           Int?
  shiftMasterId                    Int?
  // GENERAL | ROTATIONAL — governs which of the two below applies. GENERAL
  // uses shiftMasterId above (a fixed shift, unchanged week to week).
  // ROTATIONAL uses shiftRotationPlanId instead — the actual shift for a
  // given date is computed from that plan (see resolveShiftAndOtRule in
  // src/lib/biometricConversion.ts), not stored per-day.
  shiftAssignmentType              String?   @default("GENERAL") @db.NVarChar(20)
  shiftRotationPlanId              Int?
  // Job details
  jobTitle                         String?   @db.NVarChar(100)
  subCategory                      String?   @db.NVarChar(50)
  productionLine                   String?   @db.NVarChar(100)
  additionalRole                   String?   @db.NVarChar(100)
  teamGroup                        String?   @db.NVarChar(100)
  joinDate                         DateTime
  confirmationDate                 DateTime?
  // probationEndDate is server-computed (joinDate + probationPeriodMonths),
  // never accepted directly from the client — see calculateProbationEndDate.
  probationPeriodMonths            Int?
  probationEndDate                 DateTime?
  // Manager recommendation stage (two-level approval: Manager → HR)
  managerRecommendation            String?   @db.NVarChar(20) // recommend | extend | reject
  managerRecommendationByUserId     Int?
  managerRecommendationAt           DateTime?
  managerRemarks                    String?   @db.NVarChar(500)
  // Shift / attendance config
  shiftRequired                    Boolean   @default(false)
  dailySheetRequired               Boolean   @default(false)
  // Documents/config flags
  petrolAllowance                  Boolean   @default(false)
  // Payroll configuration
  wageType                         String?   @db.NVarChar(20) // monthly | daily | hourly
  paymentMode                      String?   @db.NVarChar(20) // bank | cash | cheque
  // Official access
  officialEmail                    String?   @db.NVarChar(100)
  // Statutory applicability
  esiApplicable                    Boolean   @default(false)
  professionalTaxApplicable        Boolean   @default(false)
  bonusApplicable                  Boolean   @default(false)
  ltaEligible                      Boolean   @default(false)
  pfRestrictionAmount              Decimal?  @db.Decimal(18, 2)
  // Attendance and overtime
  overtimeAllowed                  Boolean   @default(false)
  overtimeFactor                   Decimal?  @db.Decimal(5, 2)
  overtimeRatePerHour              Decimal?  @db.Decimal(18, 2)
  lossOfMinutesDeductionApplicable Boolean   @default(false)
  allowedLossOfMinutes             Int?
  numberOfLeavesAllowed            Decimal?  @db.Decimal(5, 2)
  permissionRequestAllowed         Boolean   @default(false)
  permissionHours                  Decimal?  @db.Decimal(5, 2)
  // Company resources
  companyContact1                  String?   @db.NVarChar(20)
  companyContact2                  String?   @db.NVarChar(20)
  ipAddress1                       String?   @db.NVarChar(50)
  ipAddress2                       String?   @db.NVarChar(50)
  // Versioning
  effectiveFrom                    DateTime
  effectiveTo                      DateTime? // NULL = current

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee      Employee       @relation(fields: [employeeId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  subDepartment SubDepartment? @relation("SubDepartmentJobInfos", fields: [subDepartmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designation   Designation    @relation(fields: [designationId], references: [id])
  employeeType  EmployeeType   @relation(fields: [employeeTypeId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  grade         Grade?         @relation(fields: [gradeId], references: [id])
  level         Level?         @relation(fields: [levelId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftMaster       ShiftMaster?       @relation(fields: [shiftMasterId], references: [id])
  shiftRotationPlan ShiftRotationPlan? @relation(fields: [shiftRotationPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Employee Master BRD §5/§15/§19 — additive, nullable. Location and cost
  // centre complete the org hierarchy on the dated job row; notice period
  // is a dated attribute so F&F reads the value in force on the LWD.
  locationId        Int?
  costCentreId      Int?
  noticePeriodDays  Int?
  noticePeriodSource String? @db.NVarChar(20) // OFFER | GRADE_DEFAULT | POLICY | MANUAL
  changeReason      String?  @db.NVarChar(30) // JOINING | TRANSFER | PROMOTION | CONFIRMATION | REPORTING_CHANGE | CORRECTION | POLICY
  changeReference   String?  @db.NVarChar(60)

  @@index([employeeId])
  @@index([departmentId])
  @@index([designationId])
  @@index([effectiveFrom, effectiveTo])
  @@index([locationId])
  @@index([costCentreId])
  @@index([shiftRotationPlanId])
  @@map("JobInfo")
}

// A weekly shift-rotation policy: an ordered cycle of shifts (e.g. Shift 1 ->
// Shift 2 -> Shift 3 -> back to Shift 1), anchored to a real calendar date so
// "which shift applies on date X" is deterministic — see resolveShiftAndOtRule
// in src/lib/biometricConversion.ts. anchorDate is the start of week 0 (the
// first slot in the cycle); the applicable slot for any date is
// floor(weeksSinceAnchor) mod slot count.
model ShiftRotationPlan {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  anchorDate  DateTime  @db.Date
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  slots    ShiftRotationSlot[]
  jobInfos JobInfo[]

  @@map("ShiftRotationPlan")
}

// One position in a ShiftRotationPlan's weekly cycle — sequenceOrder 0, 1, 2...
model ShiftRotationSlot {
  id                  Int @id @default(autoincrement())
  shiftRotationPlanId Int
  sequenceOrder       Int // 0-based position in the weekly cycle
  shiftMasterId       Int

  shiftRotationPlan ShiftRotationPlan @relation(fields: [shiftRotationPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftMaster       ShiftMaster       @relation(fields: [shiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([shiftRotationPlanId, sequenceOrder])
  @@index([shiftMasterId])
  @@map("ShiftRotationSlot")
}

// Phase TimeOffice — per-employee, per-date shift overrides.
// When an admin bulk-uploads or manually changes an employee's shift for
// a specific date, it's stored here. resolveDailyShift checks overrides
// first, then falls back to the automatic rotation plan. This allows
// manual corrections on top of the automated weekly rotation.
model ShiftAssignmentOverride {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  date         DateTime @db.Date
  shiftMasterId Int
  reason       String?  @db.NVarChar(500)
  createdByUserId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  shiftMaster ShiftMaster @relation(fields: [shiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("ShiftAssignmentOverride")
}

// Phase TimeOffice — Dynamic approval chain configuration.
// Admin configures who approvals go to for each module (SHIFT_CHANGE, LOM,
// OT, etc.). Each stage has an order, an approver type (REPORTING_MANAGER,
// HR, ROLE, SPECIFIC_USER), and optional role/user reference.
model ApprovalChainConfig {
  id           Int      @id @default(autoincrement())
  companyId    Int
  module       String   @db.NVarChar(50)  // SHIFT_CHANGE | LOM | OT | LEAVE etc.
  stageName    String   @db.NVarChar(50)  // L1 | L2 | HR | FINANCE etc.
  stageOrder   Int                        // 1, 2, 3...
  approverType String   @db.NVarChar(20)  // REPORTING_MANAGER | HR | ROLE | SPECIFIC_USER
  approverRoleId  Int?                    // when approverType = ROLE
  approverUserId  Int?                    // when approverType = SPECIFIC_USER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, module, stageOrder])
  @@index([companyId, module])
  @@map("ApprovalChainConfig")
}

// Phase TimeOffice — Employee shift change request.
// Employee requests a shift change for a specific date. The request flows
// through the configured approval chain (ApprovalChainConfig for module
// SHIFT_CHANGE). When all stages approve, a ShiftAssignmentOverride is
// created automatically.
model ShiftChangeRequest {
  id                    Int      @id @default(autoincrement())
  employeeId            Int
  requestedDate         DateTime @db.Date  // the date they want to change
  currentShiftMasterId  Int?                // snapshot of current shift
  requestedShiftMasterId Int                 // the shift they want
  reason                String?  @db.NVarChar(500)
  status                String   @default("pending") @db.NVarChar(20)  // pending | approved | rejected
  currentStageOrder     Int      @default(1)  // which approval stage we're at
  approvedByUserId      Int?
  approvedAt            DateTime?
  rejectionReason       String?  @db.NVarChar(500)
  rejectedByUserId      Int?
  rejectedAt            DateTime?
  createdByUserId       Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  employee             Employee     @relation(fields: [employeeId], references: [id])
  currentShiftMaster   ShiftMaster? @relation("ShiftChangeRequest_CurrentShift", fields: [currentShiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedShiftMaster ShiftMaster  @relation("ShiftChangeRequest_RequestedShift", fields: [requestedShiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@index([status])
  @@map("ShiftChangeRequest")
}

// Phase TimeOffice — notifications sent to employees when their shift changes.
// Created when a ShiftAssignmentOverride is created (manual or via shift change
// request approval). Employees can view their notifications on their dashboard.
model ShiftChangeNotification {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  date         DateTime @db.Date  // the date the shift changed
  oldShiftMasterId Int?
  newShiftMasterId  Int
  reason       String?  @db.NVarChar(500)
  isRead       Boolean  @default(false)
  createdByUserId Int?
  createdAt    DateTime @default(now())

  employee      Employee     @relation(fields: [employeeId], references: [id])
  oldShiftMaster ShiftMaster? @relation("ShiftChangeNotification_OldShift", fields: [oldShiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newShiftMaster ShiftMaster  @relation("ShiftChangeNotification_NewShift", fields: [newShiftMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@index([isRead])
  @@map("ShiftChangeNotification")
}

// Phase TimeOffice — comp-off request from employees.
// When an employee works on a weekly off or holiday, they can request
// comp-off (compensatory off) for a specific date. This goes to admin/HR
// for approval. When approved, a comp-off leave balance is credited.
model CompOffRequest {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  workedDate      DateTime @db.Date  // the date they worked on weekly off/holiday
  requestedDate   DateTime @db.Date  // the date they want to take as comp-off
  reason          String?  @db.NVarChar(500)
  status          String   @default("pending") @db.NVarChar(20)  // pending | approved | rejected
  approvedByUserId Int?
  approvedAt       DateTime?
  rejectionReason  String?  @db.NVarChar(500)
  rejectedByUserId Int?
  rejectedAt       DateTime?
  createdByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("CompOffRequest")
}

// E4: SalaryStructure is versioned — effectiveFrom/effectiveTo.
//     Only one active record at a time. CTC breakdown fields.
model SalaryStructure {
  id                  Int       @id @default(autoincrement())
  employeeId          Int
  // CTC breakdown
  basic               Decimal   @db.Decimal(18, 2)
  hra                 Decimal   @db.Decimal(18, 2)
  conveyanceAllowance Decimal   @default(0) @db.Decimal(18, 2)
  medicalAllowance    Decimal   @default(0) @db.Decimal(18, 2)
  specialAllowance    Decimal   @default(0) @db.Decimal(18, 2)
  otherAllowance      Decimal   @default(0) @db.Decimal(18, 2)
  // Statutory
  pfApplicable        Boolean   @default(true)
  esiApplicable       Boolean   @default(false)
  // Totals
  monthlyCtc          Decimal   @db.Decimal(18, 2)
  annualCtc           Decimal   @db.Decimal(18, 2)
  // Versioning
  effectiveFrom       DateTime
  effectiveTo         DateTime? // NULL = current

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveFrom, effectiveTo])
  @@map("SalaryStructure")
}

// E9: Separate bank detail table — 1:1 for now, may extend to multiple.
model EmployeeBankDetail {
  id            Int     @id @default(autoincrement())
  employeeId    Int     @unique
  bankName      String? @db.NVarChar(100)
  branchName    String? @db.NVarChar(100)
  accountNumber String? @db.NVarChar(30)
  ifscCode      String? @db.NVarChar(20)
  accountType   String? @db.NVarChar(20) // savings | current | salary
  isPrimary     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("EmployeeBankDetail")
}

// Dependents — 1:N with Employee
model EmployeeDependent {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  name         String    @db.NVarChar(100)
  relationship String    @db.NVarChar(50) // spouse | son | daughter | father | mother | other
  dateOfBirth  DateTime?
  isDependent  Boolean   @default(true) // for insurance/tax purposes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("EmployeeDependent")
}

// Previous work experience — 1:N with Employee
model EmployeeExperience {
  id               Int       @id @default(autoincrement())
  employeeId       Int
  companyName      String    @db.NVarChar(100)
  designation      String    @db.NVarChar(100)
  fromDate         DateTime
  toDate           DateTime? // NULL = current job
  reasonForLeaving String?   @db.NVarChar(500)
  lastDrawnSalary  Decimal?  @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("EmployeeExperience")
}

// Education qualifications — 1:N with Employee
model EmployeeEducation {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  qualification String   @db.NVarChar(100) // e.g. "B.Tech", "MCA"
  institution   String?  @db.NVarChar(200)
  university    String?  @db.NVarChar(200)
  yearOfPassing Int?
  percentage    Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("EmployeeEducation")
}

// E5: Documents with expiry tracking for Aadhaar/PAN/Passport/DL.
//     Also handles KPI/JD attachments via docType field (E6).
//     File upload is a placeholder stub — no actual file storage in this branch.
model EmployeeDocument {
  id         Int       @id @default(autoincrement())
  employeeId Int
  docType    String    @db.NVarChar(30)
  // "aadhaar" | "pan" | "passport" | "driving_license" | "kpi" | "jd" | "other"
  docNumber  String?   @db.NVarChar(50) // e.g. Aadhaar number, PAN number
  fileName   String?   @db.NVarChar(200) // placeholder — actual file path/URL later
  filePath   String?   @db.NVarChar(500) // placeholder — actual file storage later
  // Expiry tracking
  issuedDate DateTime?
  expiryDate DateTime? // NULL = no expiry
  isVerified Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([docType])
  @@index([expiryDate])
  @@map("EmployeeDocument")
}

// Asset allocation — join table between Employee and AssetMaster.
// Single-source-of-truth: no asset data duplicated on Employee.
// Read-only reference — actual asset management logic is a future phase.
model EmployeeAssetAllocation {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  assetMasterId      Int
  serialNumber       String?   @db.NVarChar(50)
  model              String?   @db.NVarChar(100)
  assetValue         Decimal?  @db.Decimal(12, 2)
  allocatedDate      DateTime  @default(now())
  expectedReturnDate DateTime?
  returnedDate       DateTime? // NULL = currently allocated
  notes              String?   @db.NVarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  assetMaster AssetMaster @relation(fields: [assetMasterId], references: [id])

  @@index([employeeId])
  @@index([assetMasterId])
  @@map("EmployeeAssetAllocation")
}

// E7: Exit interview — 1:1 with Employee, created on exit.
model ExitInterview {
  id             Int       @id @default(autoincrement())
  employeeId     Int       @unique
  exitDate       DateTime
  exitReason     String?   @db.NVarChar(500)
  exitType       String    @db.NVarChar(20) // resignation | termination | retirement
  interviewNotes String?   @db.NVarChar(2000)
  interviewDate  DateTime?
  interviewedBy  String?   @db.NVarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee       Employee        @relation(fields: [employeeId], references: [id])
  gratuityRecord GratuityRecord?
  fnfSettlement  FnFSettlement?

  @@map("ExitInterview")
}

// ─────────────────────────────────────────────────────────────────────────────
// 8. PASSPORT — 1:1 with Employee
// ─────────────────────────────────────────────────────────────────────────────

model EmployeePassport {
  id                 Int       @id @default(autoincrement())
  employeeId         Int       @unique
  passportNumber     String?   @db.NVarChar(30)
  placeOfIssue       String?   @db.NVarChar(100)
  countryOfIssue     String?   @db.NVarChar(50)
  issueDate          DateTime?
  expiryDate         DateTime?
  filePath           String?   @db.NVarChar(500)
  verificationStatus String?   @db.NVarChar(20) // pending | verified | rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("EmployeePassport")
}

// ─────────────────────────────────────────────────────────────────────────────
// 9. KYC & STATUTORY — 1:1 with Employee. Single source of truth (spec §6.14).
//    panNumberEnc / aadhaarNumberEnc are ciphertext (src/lib/crypto.ts,
//    AES-256-GCM). Bank account fields remain owned by EmployeeBankDetail —
//    both are edited under the same employee.kyc.* permission gate.
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeKyc {
  id                   Int       @id @default(autoincrement())
  employeeId           Int       @unique
  pfNumber             String?   @db.NVarChar(30)
  uanNumber            String?   @db.NVarChar(20)
  esiNumber            String?   @db.NVarChar(20)
  panNumberEnc         String?   @db.NVarChar(255)
  aadhaarNumberEnc     String?   @db.NVarChar(255)
  drivingLicenceNumber String?   @db.NVarChar(30)
  drivingLicenceExpiry DateTime?
  electionCardNumber   String?   @db.NVarChar(30)
  rationCardNumber     String?   @db.NVarChar(30)
  verificationStatus   String?   @db.NVarChar(20) // pending | verified | rejected
  verifiedByUserId     Int?
  verifiedDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("EmployeeKyc")
}

// ─────────────────────────────────────────────────────────────────────────────
// 10. SKILL MATRIX — 1:N with Employee
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeSkill {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  skillCategory     String?   @db.NVarChar(100)
  skillName         String    @db.NVarChar(100) // skill / machine / operation
  proficiencyLevel  String?   @db.NVarChar(30) // via workflow proficiency reference
  levelPercentage   Decimal?  @db.Decimal(5, 2)
  certified         Boolean   @default(false)
  certificateNumber String?   @db.NVarChar(50)
  certifiedDate     DateTime?
  expiryDate        DateTime?
  evaluatedBy       String?   @db.NVarChar(100)
  remarks           String?   @db.NVarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("EmployeeSkill")
}

// ─────────────────────────────────────────────────────────────────────────────
// 11. EMPLOYEE ACTIVITY — 1:N with Employee. Read-only audit timeline.
//     Written via src/lib/activity-log.ts inside each mutating endpoint's
//     transaction. Never store passwords or full sensitive KYC/bank values.
// ─────────────────────────────────────────────────────────────────────────────

model EmployeeActivity {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  activityType      String   @db.NVarChar(50) // e.g. "created" | "job_info_updated" | "status_changed"
  activityAt        DateTime @default(now())
  performedByUserId Int?
  module            String   @db.NVarChar(50) // e.g. "basic" | "personal" | "contact" | "job_profile"
  oldValue          String?  @db.NVarChar(2000)
  newValue          String?  @db.NVarChar(2000)
  remarks           String?  @db.NVarChar(500)
  source            String?  @db.NVarChar(30) // "web" | "api" | "seed"
  relatedRecordId   Int?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([activityAt])
  @@map("EmployeeActivity")
}

// ─────────────────────────────────────────────────────────────────────────────
// 12. DYNAMIC SALARY COMPONENTS (replaces hardcoded SalaryStructure columns)
//     Only one EmployeeSalaryRevision per employee may have effectiveTo = NULL
//     — enforced via SQL Server trigger, same Option D pattern as the slab
//     tables (see prisma/triggers/tr_EmployeeSalaryRevision_no_overlap.sql).
// ─────────────────────────────────────────────────────────────────────────────

// Company-scoped since migration 000012 — each company manages its own
// catalog via /masters/salary-components. isSystemDefined marks the 7 codes
// Payroll/Arrear/Bonus depend on by code (BASIC, PF, ESI, ARREAR_GROSS,
// ARREAR_PF, ARREAR_ESI, BONUS — see src/lib/defaultSalaryComponents.ts):
// the CRUD routes refuse to edit/delete those rows so a company admin can't
// break the built-in calculations, but can freely add their own components.
model SalaryComponent {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String    @db.NVarChar(30)
  name              String    @db.NVarChar(100)
  type              String    @db.NVarChar(30) // earning | deduction | employer_contribution
  isSystemDefined   Boolean   @default(false)
  // Whether this component counts toward "eligible salary" in the Gratuity
  // calculation (BRD §10's "Include in Gratuity: Yes/No") — see
  // src/lib/gratuityCalculation.ts. Defaults false; a company admin opts
  // components in via this Masters page.
  includeInGratuity Boolean   @default(false)
  // KUN BRD review (2026-09-10): whether this component counts toward the
  // ESI / PF eligible-wage base — same convention as includeInGratuity.
  includeInEsi      Boolean   @default(false)
  includeInPf       Boolean   @default(false)
  // Whether this earning component counts toward Gross Salary. When false
  // the component is CTC-only — it is paid out (e.g. a performance incentive
  // disbursed monthly based on PMS rating) but never part of Gross and never
  // a base for PF/ESI/PT/TDS. Defaults true so existing components are
  // unaffected.
  includeInGross    Boolean   @default(true)
  // Which Gross tier this earning component belongs to, for payslip
  // subtotal display: FIXED (Basic, HRA, LTA, Special, Educational…) or
  // ADDITIONAL (Additional HRA and similar top-up components). Only
  // meaningful when includeInGross = true; CTC-only components are paid
  // outside Gross entirely and ignore this field.
  grossTier         String    @default("ADDITIONAL") @db.NVarChar(20) // FIXED | ADDITIONAL
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company             Company                   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeComponents  EmployeeSalaryComponent[]
  payrollLineItems    PayrollLineComponent[]
  salaryRevisionItems SalaryRevisionComponent[]
  grossSplitRule      GrossSplitRule?
  otPlansPayingHere   OTPlan[]
  esiRateComponents   EsiRateComponent[]
  pfRateComponents    PfRateComponent[]
  benefitRates        BenefitRateByEmployeeType[]
  pmsIncentives       PmsIncentive[]
  pmsIncentiveConfigs PmsIncentiveConfig[]

  @@unique([companyId, code])
  @@map("SalaryComponent")
}

// Common Logic > Gross % Split (KUN BRD review, 2026-09-10): the fixed
// percentage of Gross Salary each earning SalaryComponent is entitled to
// (e.g. Basic = 40%, HRA = 20%). Company-scoped, one row per component.
// Read-only reference table for now — nothing in payroll consumes it yet;
// wiring it into Salary Revision's component auto-fill is a later session.
model GrossSplitRule {
  id                Int      @id @default(autoincrement())
  companyId         Int
  salaryComponentId Int      @unique
  percentOfGross    Decimal  @db.Decimal(5, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("GrossSplitRule")
}

// Per-Employee-Type monthly rate for a benefit (BRD: Canteen Deduction and
// Petrol Allowance both vary "based on company" by employee category —
// EmployeeType is the mandatory-on-JobInfo axis that matches the BRD's own
// Staff/Trainee/Operator framing, see JobInfo.employeeTypeId). The rate
// itself is company-configured (no client-confirmed figures exist yet);
// what's fixed is the mechanism — a flat monthly amount per employee type,
// applied as an ad-hoc PayrollLineComponent via
// src/app/api/payroll/runs/[id]/apply-benefit-rates/route.ts, prorated for
// Canteen by the same payableDays/totalWorkingDays factor
// payrollCalculation.ts already uses for recurring components (BRD:
// "prorated based on absence"). One row per (company, component, type).
model BenefitRateByEmployeeType {
  id                Int      @id @default(autoincrement())
  companyId         Int
  code              String   @db.NVarChar(20)
  name              String   @db.NVarChar(100)
  employeeTypeId    Int
  salaryComponentId Int?
  amount            Decimal  @db.Decimal(18, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeType    EmployeeType    @relation(fields: [employeeTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employeeBenefits EmployeeBenefit[]

  @@unique([companyId, code])
  @@map("BenefitRateByEmployeeType")
}

model EmployeeBenefit {
  id              Int     @id @default(autoincrement())
  employeeId      Int
  benefitRateId   Int
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitRate    BenefitRateByEmployeeType @relation(fields: [benefitRateId], references: [id], onDelete: Cascade)

  @@unique([employeeId, benefitRateId])
  @@index([employeeId])
  @@index([benefitRateId])
  @@map("EmployeeBenefit")
}

// PMS Incentive — BRD: monthly % entered jointly (50% company contribution,
// 50% Reporting Manager's own input), approved by HR before payroll. Only
// the PERCENTAGE agreement and its approval are modeled here; the client
// never specified what base amount the percentage applies to, so this does
// NOT compute or push a rupee amount to payroll automatically — HR applies
// the actual incentive amount through the general bulk ad-hoc payroll-line
// upload (reusing the existing PayrollLineComponent.isAdhoc mechanism) once
// they know the base, using this record's approved totalPercent as the
// reference figure.
model PmsIncentiveConfig {
  id            Int      @id @default(autoincrement())
  companyId     Int
  financialYear String   @db.NVarChar(10) // e.g. "2026-27"
  effectiveFrom DateTime
  effectiveTo   DateTime

  calculationBasis  String @default("basic") @db.NVarChar(30) // basic | gross | ctc | target_incentive | component
  salaryComponentId Int? // required when calculationBasis = 'component'
  incentiveType     String @default("percentage") @db.NVarChar(20) // percentage | fixed

  companyPercent        Decimal  @default(0) @db.Decimal(5, 2)
  companyValue          Decimal? @db.Decimal(18, 2) // fixed-value mode
  targetIncentiveAmount Decimal? @db.Decimal(18, 2) // basis = target_incentive

  remarks String? @db.NVarChar(500)
  status  String  @default("active") @db.NVarChar(20) // draft | active | finalized

  createdByUserId Int?
  updatedByUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent? @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pmsIncentives   PmsIncentive[]

  @@unique([companyId, financialYear])
  @@map("PmsIncentiveConfig")
}

// Performance Incentive — one employee-level row per period. A row starts as
// a draft while the Reporting Manager keys the individual %, moves to
// submitted for HR review, then approved / rejected / returned. HR/Admin may
// override any field; every mutation is mirrored into EmployeeActivity
// (module = 'pms') for the audit trail the BRD requires.
model PmsIncentive {
  id            Int  @id @default(autoincrement())
  employeeId    Int
  configId      Int?
  year          Int // anchor year of the configured effective period
  month         Int // anchor month (1-12) of the configured effective period
  financialYear String? @db.NVarChar(10)

  calculationBasis  String? @db.NVarChar(30) // copied from config at save time
  salaryComponentId Int? // 'component' basis snapshot
  incentiveType     String  @default("percentage") @db.NVarChar(20) // percentage | fixed
  basisAmount       Decimal @default(0) @db.Decimal(18, 2)

  companyPercent Decimal  @default(0) @db.Decimal(5, 2)
  managerPercent Decimal  @default(0) @db.Decimal(5, 2) // "Individual %" in the BRD
  totalPercent   Decimal  @default(0) @db.Decimal(5, 2)

  companyValue    Decimal? @db.Decimal(18, 2) // fixed-value mode
  individualValue Decimal? @db.Decimal(18, 2) // fixed-value mode
  companyAmount   Decimal  @default(0) @db.Decimal(18, 2)
  individualAmount Decimal @default(0) @db.Decimal(18, 2)
  overallAmount   Decimal  @default(0) @db.Decimal(18, 2)

  // Attendance-based payout computation, stored at save time (the "fixed"
  // Performance Incentive salary component is the base, MonthlyAttendance
  // .presentDays prorates it over the calendar month, PMS % scales it, and
  // ESI shares split off the earned amount):
  //   incentiveMoney = performanceIncentive / monthDays * presentDays
  //   incentiveEarn  = incentiveMoney * totalPercent / 100
  //   employeeEsi    = incentiveEarn * 0.75 / 100
  //   employerEsi    = incentiveEarn * 3.25 / 100
  //   pmsNet         = incentiveEarn - employeeEsi
  performanceIncentive Decimal @default(0) @db.Decimal(18, 2)
  monthDays            Int     @default(0)
  presentDays          Decimal @default(0) @db.Decimal(5, 2)
  incentiveMoney       Decimal @default(0) @db.Decimal(18, 2)
  incentiveEarn        Decimal @default(0) @db.Decimal(18, 2)
  employeeEsi          Decimal @default(0) @db.Decimal(18, 2)
  employerEsi          Decimal @default(0) @db.Decimal(18, 2)
  pmsNet               Decimal @default(0) @db.Decimal(18, 2)

  // draft | submitted | under_review | approved | rejected | returned | finalized
  status String @default("draft") @db.NVarChar(20)

  supportingFileName String? @db.NVarChar(200)
  supportingFilePath String? @db.NVarChar(500)
  remarks            String? @db.NVarChar(500)
  rejectionReason    String? @db.NVarChar(500)

  managerActionByUserId Int? // who entered / submitted the individual incentive
  managerActionAt       DateTime?
  hrActionByUserId      Int? // HR approver / rejector / overrider
  hrActionAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee        Employee            @relation(fields: [employeeId], references: [id])
  config          PmsIncentiveConfig? @relation(fields: [configId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent SalaryComponent?    @relation(fields: [salaryComponentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, year, month])
  @@index([configId])
  @@index([status])
  @@map("PmsIncentive")
}

// Double Machine Incentive — BRD B5/B6 + Suki ERP DOUBLE_MACHINE_INCENTIVE
// / INCENTIVE_DET_MULTI_MACHINE. Manual HR entry per employee per month
// (employee, Double Machine, Att.Bonus, Shift Incentive, OT Weekly Inc,
// Employee R, status). Employee code/name/dept/designation come from
// Employee + JobInfo, not stored here.
model DoubleMachineIncentive {
  id              Int     @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  year            Int
  month           Int // 1-12
  doubleMachine   Decimal @default(0) @db.Decimal(18, 2)
  attendanceBonus Decimal @default(0) @db.Decimal(18, 2)
  shiftIncentive  Decimal @default(0) @db.Decimal(18, 2)
  otWeeklyInc     Decimal @default(0) @db.Decimal(18, 2)
  employeeR       Decimal @default(0) @db.Decimal(18, 2)

  // draft | process | hold | complete
  status  String  @default("draft") @db.NVarChar(20)
  remarks String? @db.NVarChar(500)

  createdByUserId Int?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employeeId, year, month])
  @@index([companyId, year, month])
  @@index([status])
  @@map("DoubleMachineIncentive")
}

model EmployeeSalaryRevision {
