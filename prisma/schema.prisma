// Full-fidelity result data owned by this app. Legacy ERP lifecycle tables have
// short remark columns, so certificates and observation rows live here.
model CalibrationResultDetail {
  id                Int                            @id @default(autoincrement()) @map("ID")
  issueLineRowId    Int                            @unique @map("ISSUE_LINE_ROW_ID")
  toolOrGaugeNo     String                         @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  dcNo              Int?                           @map("DC_NO")
  serialNo          Int?                           @map("SERIAL_NO")
  resultStatus      String                         @map("RESULT_STATUS") @db.NVarChar(30)
  certificateNo     String?                        @map("CERTIFICATE_NO") @db.NVarChar(100)
  referenceStandard String?                        @map("REFERENCE_STANDARD") @db.NVarChar(200)
  errorNoticed      String?                        @map("ERROR_NOTICED") @db.NVarChar(500)
  comments          String?                        @map("COMMENTS") @db.NVarChar(1000)
  calibratedBy      String?                        @map("CALIBRATED_BY") @db.NVarChar(100)
  calibratedDate    DateTime                       @map("CALIBRATED_DATE") @db.DateTime
  nextCalibDate     DateTime                       @map("NEXT_CALIB_DATE") @db.DateTime
  location          String?                        @map("LOCATION") @db.NVarChar(100)
  createdBy         String                         @map("CREATED_BY") @db.NVarChar(10)
  createdAt         DateTime                       @default(now()) @map("CREATED_AT") @db.DateTime
  updatedBy         String?                        @map("UPDATED_BY") @db.NVarChar(10)
  updatedAt         DateTime                       @updatedAt @map("UPDATED_AT") @db.DateTime
  observations      CalibrationResultObservation[]
  deviations        CalibrationDeviation[]

  @@index([toolOrGaugeNo, calibratedDate])
  @@index([dcNo])
  @@map("TOOLS_APP_CALIBRATION_RESULT")
}

model CalibrationResultObservation {
  id            Int                     @id @default(autoincrement()) @map("ID")
  resultId      Int                     @map("RESULT_ID")
  lineNo        Int                     @map("LINE_NO")
  parameter     String                  @map("PARAMETER") @db.NVarChar(100)
  specification String?                 @map("SPECIFICATION") @db.NVarChar(200)
  observedMin   String?                 @map("OBSERVED_MIN") @db.NVarChar(50)
  observedMax   String?                 @map("OBSERVED_MAX") @db.NVarChar(50)
  gaugeStatus   String?                 @map("GAUGE_STATUS") @db.NVarChar(30)
  remarks       String?                 @map("REMARKS") @db.NVarChar(500)
  createdAt     DateTime                @default(now()) @map("CREATED_AT") @db.DateTime
  result        CalibrationResultDetail @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, lineNo])
  @@map("TOOLS_APP_CALIBRATION_RESULT_OBS")
}

model InstrumentDefect {
  id             Int                       @id @default(autoincrement()) @map("ID")
  refNo          Int                       @map("REF_NO")
  toolOrGaugeNo  String                    @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  unitCode       String?                   @map("UNIT_CODE") @db.NVarChar(100)
  reportedDate   DateTime                  @map("REPORTED_DATE") @db.DateTime
  defectDetails  String                    @map("DEFECT_DETAILS") @db.NVarChar(1000)
  errorDeviation String?                   @map("ERROR_DEVIATION") @db.NVarChar(500)
  status         String                    @default("Defect Reported") @map("STATUS") @db.NVarChar(40)
  disposition    String?                   @map("DISPOSITION") @db.NVarChar(100)
  reportedBy     String                    @map("REPORTED_BY") @db.NVarChar(50)
  createdAt      DateTime                  @default(now()) @map("CREATED_AT") @db.DateTime
  updatedBy      String?                   @map("UPDATED_BY") @db.NVarChar(50)
  updatedAt      DateTime                  @updatedAt @map("UPDATED_AT") @db.DateTime
  tool           GaugeAndTools             @relation(fields: [refNo], references: [refNo], onDelete: NoAction, onUpdate: NoAction)
  serviceRecords InstrumentServiceRecord[]

  @@index([refNo, reportedDate])
  @@index([status])
  @@map("TOOLS_APP_INSTRUMENT_DEFECT")
}

model InstrumentServiceRecord {
  id                 Int               @id @default(autoincrement()) @map("ID")
  defectId           Int?              @map("DEFECT_ID")
  refNo              Int               @map("REF_NO")
  toolOrGaugeNo      String            @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  serviceAgency      String?           @map("SERVICE_AGENCY") @db.NVarChar(100)
  serviceDcNo        String?           @map("SERVICE_DC_NO") @db.NVarChar(30)
  sentDate           DateTime?         @map("SENT_DATE") @db.DateTime
  expectedReturnDate DateTime?         @map("EXPECTED_RETURN_DATE") @db.DateTime
  receivedDate       DateTime?         @map("RECEIVED_DATE") @db.DateTime
  repairDetails      String?           @map("REPAIR_DETAILS") @db.NVarChar(1000)
  cost               Decimal?          @map("COST") @db.Decimal(18, 2)
  verificationResult String?           @map("VERIFICATION_RESULT") @db.NVarChar(500)
  status             String            @map("STATUS") @db.NVarChar(40)
  finalStatus        String?           @map("FINAL_STATUS") @db.NVarChar(40)
  createdBy          String            @map("CREATED_BY") @db.NVarChar(50)
  createdAt          DateTime          @default(now()) @map("CREATED_AT") @db.DateTime
  updatedBy          String?           @map("UPDATED_BY") @db.NVarChar(50)
  updatedAt          DateTime          @updatedAt @map("UPDATED_AT") @db.DateTime
  defect             InstrumentDefect? @relation(fields: [defectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tool               GaugeAndTools     @relation(fields: [refNo], references: [refNo], onDelete: NoAction, onUpdate: NoAction)

  @@index([refNo, sentDate])
  @@index([defectId])
  @@index([status])
  @@map("TOOLS_APP_INSTRUMENT_SERVICE")
}

model CalibrationDeviation {
  id               Int                      @id @default(autoincrement()) @map("ID")
  resultId         Int?                     @map("RESULT_ID")
  issueLineRowId   Int?                     @map("ISSUE_LINE_ROW_ID")
  toolOrGaugeNo    String                   @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  parameter        String                   @map("PARAMETER") @db.NVarChar(100)
  expectedValue    String?                  @map("EXPECTED_VALUE") @db.NVarChar(100)
  observedValue    String?                  @map("OBSERVED_VALUE") @db.NVarChar(100)
  deviation        String                   @map("DEVIATION") @db.NVarChar(200)
  permissibleLimit String?                  @map("PERMISSIBLE_LIMIT") @db.NVarChar(100)
  resultStatus     String                   @map("RESULT_STATUS") @db.NVarChar(20)
  correctiveAction String?                  @map("CORRECTIVE_ACTION") @db.NVarChar(1000)
  recordedBy       String                   @map("RECORDED_BY") @db.NVarChar(50)
  recordedAt       DateTime                 @default(now()) @map("RECORDED_AT") @db.DateTime
  result           CalibrationResultDetail? @relation(fields: [resultId], references: [id])

  @@index([toolOrGaugeNo, recordedAt])
  @@index([resultId])
  @@map("TOOLS_APP_CALIBRATION_DEVIATION")
}

// Authorized external calibration laboratories. Additive app-owned master;
// legacy calibration issue headers continue storing the selected code/name.
model AuthorizedCalibrationAgency {
  id                  Int       @id @default(autoincrement()) @map("ID")
  agencyCode          String    @unique @map("AGENCY_CODE") @db.NVarChar(10)
  agencyName          String    @map("AGENCY_NAME") @db.NVarChar(100)
  address             String?   @map("ADDRESS") @db.NVarChar(500)
  contactPerson       String?   @map("CONTACT_PERSON") @db.NVarChar(100)
  phone               String?   @map("PHONE") @db.NVarChar(30)
  email               String?   @map("EMAIL") @db.NVarChar(150)
  accreditationNo     String?   @map("ACCREDITATION_NO") @db.NVarChar(100)
  accreditationExpiry DateTime? @map("ACCREDITATION_EXPIRY") @db.DateTime
  capabilities        String?   @map("CAPABILITIES") @db.NVarChar(1000)
  isAuthorized        Boolean   @default(true) @map("IS_AUTHORIZED")
  isActive            Boolean   @default(true) @map("IS_ACTIVE")
  createdBy           String    @map("CREATED_BY") @db.NVarChar(50)
  createdAt           DateTime  @default(now()) @map("CREATED_AT") @db.DateTime
  updatedBy           String?   @map("UPDATED_BY") @db.NVarChar(50)
  updatedAt           DateTime  @updatedAt @map("UPDATED_AT") @db.DateTime

  @@index([isActive, isAuthorized])
  @@map("TOOLS_APP_CALIBRATION_AGENCY")
}

// App-owned calibration reminder configuration and delivery outbox.
model CalibrationNotificationSetting {
  id            Int      @id @default(1) @map("ID")
  alertDays     Int      @default(15) @map("ALERT_DAYS")
  emailEnabled  Boolean  @default(true) @map("EMAIL_ENABLED")
  systemEnabled Boolean  @default(true) @map("SYSTEM_ENABLED")
  updatedBy     String?  @map("UPDATED_BY") @db.NVarChar(50)
  updatedAt     DateTime @updatedAt @map("UPDATED_AT") @db.DateTime

  @@map("TOOLS_APP_NOTIFICATION_SETTING")
}

model CalibrationNotificationRecipient {
  id        Int      @id @default(autoincrement()) @map("ID")
  name      String   @map("NAME") @db.NVarChar(100)
  email     String   @unique @map("EMAIL") @db.NVarChar(150)
  unitCode  String?  @map("UNIT_CODE") @db.NVarChar(100)
  responsibility String? @map("RESPONSIBILITY") @db.NVarChar(15)
  isActive  Boolean  @default(true) @map("IS_ACTIVE")
  createdBy String   @map("CREATED_BY") @db.NVarChar(50)
  createdAt DateTime @default(now()) @map("CREATED_AT") @db.DateTime
  updatedBy String?  @map("UPDATED_BY") @db.NVarChar(50)
  updatedAt DateTime @updatedAt @map("UPDATED_AT") @db.DateTime

  @@index([isActive, responsibility])
  @@map("TOOLS_APP_NOTIFICATION_RECIPIENT")
}

model CalibrationNotification {
  id             Int       @id @default(autoincrement()) @map("ID")
  toolOrGaugeNo  String    @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  unitCode       String?   @map("UNIT_CODE") @db.NVarChar(100)
  dueDate        DateTime  @map("DUE_DATE") @db.DateTime
  reminderDate   DateTime  @default(now()) @map("REMINDER_DATE") @db.DateTime
  channel        String    @map("CHANNEL") @db.NVarChar(10)
  recipientEmail String    @default("") @map("RECIPIENT_EMAIL") @db.NVarChar(150)
  responsibility String?   @map("RESPONSIBILITY") @db.NVarChar(15)
  ccAddress      String?   @map("CC_ADDRESS") @db.NVarChar(1000)
  bccAddress     String?   @map("BCC_ADDRESS") @db.NVarChar(1000)
  subject        String    @map("SUBJECT") @db.NVarChar(200)
  message        String    @map("MESSAGE") @db.NVarChar(1000)
  status         String    @default("PENDING") @map("STATUS") @db.NVarChar(20)
  sentAt         DateTime? @map("SENT_AT") @db.DateTime
  readAt         DateTime? @map("READ_AT") @db.DateTime
  errorMessage   String?   @map("ERROR_MESSAGE") @db.NVarChar(500)
  createdAt      DateTime  @default(now()) @map("CREATED_AT") @db.DateTime

  @@unique([toolOrGaugeNo, unitCode, dueDate, channel, recipientEmail], map: "TOOLS_APP_NOTIFICATION_DEDUPE")
  @@index([channel, status, createdAt])
  @@map("TOOLS_APP_CALIBRATION_NOTIFICATION")
}

// ═══════════════════════════════════════════════════════════════════
// APP AUTH (net-new, isolated — not an ERP table; no FKs to ERP)
// ═══════════════════════════════════════════════════════════════════

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.NVarChar(50)
  passwordHash String    @db.NVarChar(255)
  name         String    @db.NVarChar(100)
  email        String?   @db.NVarChar(150)
  /// Matches rolePermissions keys / TOOLS_ROLE_PERMISSION.role
  role         String    @default("Viewer") @db.NVarChar(50)
  /// Optional ERP USER_ID for traceability — not used for auth; no FK
  erpUserCode  String?   @db.NVarChar(10)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRole   UserRole?
  unitScopes UserUnitScope[]

  @@map("TOOLS_APP_USER")
}

/// App-owned role → permission matrix (editable via Settings). Seeded from rolePermissions.ts.
model RolePermission {
  id            Int      @id @default(autoincrement())
  role          String   @db.NVarChar(50)
  permissionKey String   @map("permission_key") @db.NVarChar(50)
  allowed       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([role, permissionKey], map: "TOOLS_ROLE_PERMISSION_role_perm_key")
  @@index([role])
  @@map("TOOLS_ROLE_PERMISSION")
}

// ═══════════════════════════════════════════════════════════════════
// APP DOCUMENTS (net-new — file bytes on disk; metadata only in DB)
// ═══════════════════════════════════════════════════════════════════

model ToolDocument {
  id            Int       @id @default(autoincrement())
  toolOrGaugeNo String    @db.NVarChar(25)
  toolRefNo     Int?
  /// CALIB_CERTIFICATE | CALIB_REPORT | TOOL_MANUAL | DRAWING | DC_ATTACHMENT | OTHER
  docType       String    @default("OTHER") @db.NVarChar(40)
  originalName  String    @db.NVarChar(255)
  storedName    String    @db.NVarChar(255)
  mimeType      String    @db.NVarChar(120)
  sizeBytes     Int
  calibRowId    Int?
  dcNo          String?   @db.NVarChar(20)
  remarks       String?   @db.NVarChar(200)
  creatUserIdCd String    @db.NVarChar(50)
  creatDt       DateTime  @default(now())
  deletedAt     DateTime?

  @@index([toolOrGaugeNo])
  @@index([calibRowId])
  @@map("TOOLS_APP_DOCUMENT")
}

// ═══════════════════════════════════════════════════════════════════
// TOOL REQUISITION (ERP — MATERIAL_REQUISITION_*; read-first for Pending)
// Lines with TOOL_GAUGE_NO are tools-capable. Table may be unused today.
// ═══════════════════════════════════════════════════════════════════

model MaterialRequisitionMaster {
  rowId           Int       @id @default(autoincrement()) @map("ROW_ID")
  reqNo           String?   @map("REQ_NO") @db.NVarChar(40)
  deptId          Int?      @map("DEPT_ID")
  empCd           Int?      @map("EMP_CD")
  reqDate         DateTime? @map("DATE") @db.DateTime
  status          String?   @map("STATUS") @db.NVarChar(20)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs       DateTime? @map("LST_UPDT_TS") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  matType         String?   @map("MAT_TYPE") @db.NVarChar(20)
  fromWhere       String?   @map("FROM_WHERE") @db.NVarChar(30)
  cardNo          String?   @map("CARD_NO") @db.NVarChar(15)
  issueQty        Decimal?  @map("ISSUE_QTY") @db.Decimal(10, 2)
  isAuto          String?   @map("IS_AUTO") @db.NVarChar(3)
  macCd           String?   @map("MAC_CD") @db.NVarChar(25)
  revNo           String?   @map("REV_NO") @db.NVarChar(10)
  revDate         DateTime? @map("REV_DATE") @db.Date

  @@index([reqNo])
  @@index([status])
  @@map("MATERIAL_REQUISITION_MASTER")
}

model MaterialRequisitionTrans {
  rowId           Int       @id @default(autoincrement()) @map("ROW_ID")
  refRowId        Int?      @map("REF_ROW_ID")
  reqNo           String?   @map("REQ_NO") @db.NVarChar(40)
  mcNo            String?   @map("MC_NO") @db.NVarChar(30)
  descrip         String?   @map("DESCRIP") @db.NVarChar(500)
  shift           String?   @map("SHIFT") @db.NVarChar(50)
  reqQty          Decimal?  @map("REQ_QTY") @db.Decimal(10, 2)
  uom             String?   @map("UOM") @db.NVarChar(20)
  remarks         String?   @map("REMARKS") @db.NVarChar(500)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs       DateTime? @map("LST_UPDT_TS") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  toolOrGaugeNo   String?   @map("TOOL_GAUGE_NO") @db.NVarChar(30)
  issueQty        Decimal?  @map("ISSUE_QTY") @db.Decimal(12, 2)
  status          String?   @map("STATUS") @db.NVarChar(20)
  storeId         Int?      @map("STORE_ID")
  matType         String?   @map("MAT_TYPE") @db.NVarChar(20)
  machine         String?   @map("MACHINE") @db.NVarChar(20)
  cardNo          String?   @map("CARD_NO") @db.NVarChar(15)
  consQty         Decimal?  @map("CONS_QTY") @db.Decimal(10, 2)
  prodCd          String?   @map("PROD_CD") @db.NVarChar(15)
  operCd          Int?      @map("OPER_CD")

  @@index([reqNo])
  @@index([toolOrGaugeNo])
  @@index([status])
  @@map("MATERIAL_REQUISITION_TRANS")
}

// ═══════════════════════════════════════════════════════════════════
// ROLES & PERMISSIONS MATRIX (Module-Level, Unit-Scoped)
// Net-new tables; no ALTER/DROP on existing tables.
// ═══════════════════════════════════════════════════════════════════

model Role {
  roleId        Int      @id @default(autoincrement()) @map("ROLE_ID")
  roleName      String   @unique @map("ROLE_NAME") @db.NVarChar(50)
  isSystemAdmin Boolean  @default(false) @map("IS_SYSTEM_ADMIN")
  createdAt     DateTime @default(now()) @map("CREATED_AT")
  updatedAt     DateTime @updatedAt @map("UPDATED_AT")

  userRoles       UserRole[]
  rolePermissions RolePermissionMatrix[]

  @@map("TOOLS_APP_ROLE")
}

model Module {
  moduleId          Int      @id @default(autoincrement()) @map("MODULE_ID")
  moduleKey         String   @unique @map("MODULE_KEY") @db.NVarChar(50)
  moduleLabel       String   @map("MODULE_LABEL") @db.NVarChar(100)
  moduleGroup       String   @map("MODULE_GROUP") @db.NVarChar(50)
  applicableActions String   @map("APPLICABLE_ACTIONS") @db.NVarChar(255)
  isBuilt           Boolean  @default(true) @map("IS_BUILT")
  createdAt         DateTime @default(now()) @map("CREATED_AT")
  updatedAt         DateTime @updatedAt @map("UPDATED_AT")

  rolePermissions RolePermissionMatrix[]

  @@map("TOOLS_APP_MODULE")
}

model RolePermissionMatrix {
  roleId   Int     @map("ROLE_ID")
  moduleId Int     @map("MODULE_ID")
  action   String  @map("ACTION") @db.NVarChar(30)
  allowed  Boolean @default(false) @map("ALLOWED")

  role   Role   @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [moduleId], onDelete: Cascade)

  @@id([roleId, moduleId, action])
  @@map("TOOLS_APP_ROLE_PERMISSION_MATRIX")
}

model UserRole {
  userId Int @id @map("USER_ID")
  roleId Int @map("ROLE_ID")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@map("TOOLS_APP_USER_ROLE")
}

model UserUnitScope {
  userId    Int    @map("USER_ID")
  unitScope String @map("UNIT_SCOPE") @db.NVarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, unitScope])
  @@map("TOOLS_APP_USER_UNIT_SCOPE")
}
