  revNo           String?   @map("REV_NO") @db.NVarChar(10)
  revDate         DateTime? @map("REV_DATE") @db.Date

  @@index([reqNo])
  @@index([status])
  @@map("MATERIAL_REQUISITION_MASTER")
}

model MaterialRequisitionTrans {
  rowId           Int       @id @default(autoincrement()) @map("ROW_ID")
  refRowId        Int?      @map("REF_ROW_ID")
