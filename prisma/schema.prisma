  shift           String?   @map("SHIFT") @db.NVarChar(50)
  reqQty          Decimal?  @map("REQ_QTY") @db.Decimal(10, 2)
  uom             String?   @map("UOM") @db.NVarChar(20)
  remarks         String?   @map("REMARKS") @db.NVarChar(500)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs       DateTime? @map("LST_UPDT_TS") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  toolOrGaugeNo   String?   @map("TOOL_GAUGE_NO") @db.NVarChar(30)
  issueQty        Decimal?  @map("ISSUE_QTY") @db.Decimal(12, 2)
