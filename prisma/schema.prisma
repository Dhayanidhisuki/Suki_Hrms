model ToolsPoReceiveTrans {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  girNo           Int?      @map("GIR_NO")
  itemCode        String?   @map("ITEM_CODE") @db.NVarChar(25)
  itemType        String?   @map("ITEM_TYPE") @db.NVarChar(50)
  qtyOrder        Decimal?  @map("QTY_ORDER") @db.Decimal(10, 2)
  invQty          Decimal?  @map("INV_QTY") @db.Decimal(10, 2)
  recQty          Decimal?  @map("REC_QTY") @db.Decimal(10, 2)
