// ═══════════════════════════════════════════════════════════════════

model MaterialRequisitionMaster {
  rowId           Int       @id @default(autoincrement()) @map("ROW_ID")
  reqNo           String?   @map("REQ_NO") @db.NVarChar(40)
  deptId          Int?      @map("DEPT_ID")
  empCd           Int?      @map("EMP_CD")
  reqDate         DateTime? @map("DATE") @db.DateTime
  status          String?   @map("STATUS") @db.NVarChar(20)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs       DateTime? @map("LST_UPDT_TS") @db.DateTime
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  matType         String?   @map("MAT_TYPE") @db.NVarChar(20)
  fromWhere       String?   @map("FROM_WHERE") @db.NVarChar(30)
  cardNo          String?   @map("CARD_NO") @db.NVarChar(15)
  issueQty        Decimal?  @map("ISSUE_QTY") @db.Decimal(10, 2)
