  day4OutTime  Decimal? @db.Decimal(6, 2)
  day5OutTime  Decimal? @db.Decimal(6, 2)
  day6OutTime  Decimal? @db.Decimal(6, 2)
  day7OutTime  Decimal? @db.Decimal(6, 2)
  day8OutTime  Decimal? @db.Decimal(6, 2)
  day9OutTime  Decimal? @db.Decimal(6, 2)
  day10OutTime Decimal? @db.Decimal(6, 2)
  day11OutTime Decimal? @db.Decimal(6, 2)
  day12OutTime Decimal? @db.Decimal(6, 2)
  day13OutTime Decimal? @db.Decimal(6, 2)
  day14OutTime Decimal? @db.Decimal(6, 2)
  day15OutTime Decimal? @db.Decimal(6, 2)
  day16OutTime Decimal? @db.Decimal(6, 2)
  day17OutTime Decimal? @db.Decimal(6, 2)
  day18OutTime Decimal? @db.Decimal(6, 2)
  day19OutTime Decimal? @db.Decimal(6, 2)
  day20OutTime Decimal? @db.Decimal(6, 2)
  day21OutTime Decimal? @db.Decimal(6, 2)
  day22OutTime Decimal? @db.Decimal(6, 2)
  day23OutTime Decimal? @db.Decimal(6, 2)
  day24OutTime Decimal? @db.Decimal(6, 2)
  day25OutTime Decimal? @db.Decimal(6, 2)
  day26OutTime Decimal? @db.Decimal(6, 2)
  day27OutTime Decimal? @db.Decimal(6, 2)
  day28OutTime Decimal? @db.Decimal(6, 2)
  day29OutTime Decimal? @db.Decimal(6, 2)
  day30OutTime Decimal? @db.Decimal(6, 2)
  day31OutTime Decimal? @db.Decimal(6, 2)

  // Resolved via Employee.oldEmployeeCode at ingestion; null = unmatched,
  // surfaced in the Biometric module, never silently dropped.
  matchedEmployeeId Int?
  // Set once this row's days have been pushed into DailyAttendance.
  processedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matchedEmployee Employee? @relation(fields: [matchedEmployeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Re-importing the same period (from any of the 3 sources, at any time)
  // upserts the same row, merging in whichever of hours/in-time/out-time
  // that import provided.
  @@unique([companyId, empIdRaw, year, attForMonth])
  @@index([companyId])
  @@index([matchedEmployeeId])
  @@map("BiometricAttendanceImport")
}

model LeaveApplication {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  leaveMasterId Int
  fromDate      DateTime @db.Date
  toDate        DateTime @db.Date
  numberOfDays  Decimal  @db.Decimal(5, 2) // supports half-day (0.5)
  isHalfDay     Boolean  @default(false)
  reason        String?  @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected | cancelled
  status               String    @default("pending_manager") @db.NVarChar(20)
  managerActionByUserId Int?
  managerActionAt       DateTime?
  managerRejectionReason String? @db.NVarChar(500)
  // Tranche 4 additions. companyId denormalised for scoped queries.
  companyId              Int?
  workflowRequestId      Int?     // WorkflowRequest.id once leave approval runs on the platform engine
  calendarDays           Decimal? @db.Decimal(6, 2)
  nonWorkingDaysCounted  Decimal? @db.Decimal(6, 2)
  documentId             Int?     // PlatformDocument.id for supporting document
  contactDuringLeave     String?  @db.NVarChar(50)
  addressDuringLeave     String?  @db.NVarChar(300)
  cancelledAt            DateTime?
  cancelledByUserId      Int?
  outcomeOnExit          String?  @db.NVarChar(20) // STANDS | TRUNCATED | CANCELLED | LAPSED_ON_EXIT
  approvedByUserId      Int?
  approvedAt            DateTime?
  rejectionReason       String?   @db.NVarChar(500)
  appliedAt             DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveMaster LeaveMaster @relation(fields: [leaveMasterId], references: [id])

  @@index([employeeId])
  @@index([leaveMasterId])
  @@index([status])
  @@map("LeaveApplication")
}

// Employee-submitted request to correct a day's punch (missing/wrong
// in/out), reviewed in two stages before DailyAttendance is touched at all
// — Reporting Manager first, then HR — per client BRD: "employee applies,
// Reporting Manager and HR review/approve." Mirrors LeaveApplication's
// pending/approved/rejected shape, but needs two actor/timestamp pairs
// since it's a two-stage approval, not LeaveApplication's single stage.
model MispunchCorrection {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date

  requestedInTime  DateTime?
  requestedOutTime DateTime?
  reason           String    @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status String @default("pending_manager") @db.NVarChar(20)

  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)

  hrActionByUserId  Int?
  hrActionAt        DateTime?
  hrRejectionReason String?   @db.NVarChar(500)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("MispunchCorrection")
}

// Per-employee, per-leave-type, per-year balance ledger.
model LeaveBalance {
  id             Int     @id @default(autoincrement())
  employeeId     Int
  leaveMasterId  Int
  year           Int
  openingBalance Decimal @default(0) @db.Decimal(5, 2)
  accrued        Decimal @default(0) @db.Decimal(5, 2)
  availed        Decimal @default(0) @db.Decimal(5, 2)
  adjusted       Decimal @default(0) @db.Decimal(5, 2)
  closingBalance Decimal @default(0) @db.Decimal(5, 2)
  carryForwardIn Decimal @default(0) @db.Decimal(5, 2)
  // §11.2 buckets added in tranche 4; closingBalance keeps the §11.1 identity.
  encashed        Decimal @default(0) @db.Decimal(5, 2)
  lapsed          Decimal @default(0) @db.Decimal(5, 2)
  expired         Decimal @default(0) @db.Decimal(5, 2)
  pendingApproval Decimal @default(0) @db.Decimal(5, 2) // reservation, not in closing
  held            Decimal @default(0) @db.Decimal(5, 2) // ACCRUE_HOLD on probation
  leaveYear       String? @db.NVarChar(9) // e.g. FY2026-27; `year` stays the numeric key

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveMaster LeaveMaster @relation(fields: [leaveMasterId], references: [id])

  @@unique([employeeId, leaveMasterId, year])
  @@map("LeaveBalance")
}

// Per-company "free permission hours per month" policy (BRD: "2 Hrs /
// Dynamic" — client left the exact number company-configurable, not fixed).
// One row per company; freeHoursPerMonth defaults to 2 only as a starting
// point, not a client-confirmed figure.
model PermissionPolicy {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  freeHoursPerMonth Decimal  @default(2) @db.Decimal(4, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("PermissionPolicy")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Payroll Config (Phase 2A) — company-scoped single-row configs that
// make payroll calculation rules admin-configurable instead of hard-coded.
// Each model uses companyId @unique so upsert by companyId is the write path.
// ─────────────────────────────────────────────────────────────────────────────

// LOM (Loss of Minutes) — converts late + early-out minutes to a currency
// deduction. When no row exists, payrollCalculation.ts falls back to the
// default formula (gross / totalWorkingDays / 8 / 60) × lomMinutes.
model LomConfig {
  id                      Int      @id @default(autoincrement())
  companyId               Int      @unique
  calculationBasis        String   @default("GROSS") @db.NVarChar(20) // GROSS | BASIC
  multiplier              Decimal  @default(1) @db.Decimal(5, 2) // 1 or 2
  shiftDurationSource     String   @default("FIXED_8") @db.NVarChar(20) // FIXED_8 | SHIFT_MASTER
  payrollDaysDenominator  String   @default("CALENDAR") @db.NVarChar(20) // CALENDAR | FIXED_26
  graceMinutesExempt      Int      @default(0)
  dailyLomCap             Int?     // null = no cap
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("LomConfig")
}

// Salary rounding — applied to net salary (or all components) after calc.
model RoundingConfig {
  id           Int      @id @default(autoincrement())
  companyId    Int      @unique
  roundingMode String   @default("NEAREST_1") @db.NVarChar(20) // NONE | NEAREST_1 | NEAREST_5 | NEAREST_10 | NEAREST_100
  applyTo      String   @default("NET_ONLY") @db.NVarChar(20) // NET_ONLY | ALL_COMPONENTS
  showRoundOff Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("RoundingConfig")
}

// Payroll validation — negative net salary and deduction limit checks.
model PayrollValidationConfig {
  id                        Int      @id @default(autoincrement())
  companyId                 Int      @unique
  allowNegativeNet          Boolean  @default(false)
  minNetPercentOfGross      Decimal  @default(0) @db.Decimal(5, 2) // 0-100
  requireApprovalIfNegative Boolean  @default(true)
  maxDeductionPercent       Decimal  @default(100) @db.Decimal(5, 2)
  statutoryIncludedInLimit  Boolean  @default(true)
  // Phase 11 — additional BRD §17 validations
  maxOtHoursPerMonth        Decimal? @db.Decimal(5, 2) // null = no cap
  maxOtPercentOfGross       Decimal? @db.Decimal(5, 2) // e.g. 25 = 25%
  checkGrossReconciliation  Boolean  @default(false) // gross = sum of components
  maxLopDaysPerMonth        Int?    // null = no cap
  checkAttendanceFrozen     Boolean  @default(false) // attendance must be FINALIZED/FROZEN
  checkDuplicateComponents  Boolean  @default(true) // no duplicate component codes
  minPayableDays            Decimal? @db.Decimal(5, 2) // null = no min
  warnIfZeroGross           Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("PayrollValidationConfig")
}

// Payroll workflow — which stages are enabled and approval chain.
model PayrollWorkflowConfig {
  id                   Int      @id @default(autoincrement())
  companyId            Int      @unique
  enableValidatedStage Boolean  @default(false)
  enableSubmittedStage Boolean  @default(false)
  enablePostedStage    Boolean  @default(false)
  approvalStages       String   @default("HR") @db.NVarChar(100) // HR | MANAGER_HR | HR_FINANCE | MANAGER_HR_FINANCE
  cutoffDayOfMonth     Int?     // e.g. 25 = 25th of each month
  allowReopenAfterLock Boolean  @default(true)
  reopenRequiresReason Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("PayrollWorkflowConfig")
}

// Payslip display — what to show on the payslip.
model PayrollDisplayConfig {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  showDeductionPercent Boolean @default(true)
  decimalPlaces     Int      @default(2)
  showYTD           Boolean  @default(false)
  showLeaveBalance  Boolean  @default(false)
  showTaxBreakdown  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("PayrollDisplayConfig")
}

// ─────────────────────────────────────────────────────────────────────────────
// Time Office Config (Phase 2B) — Comp-Off, OT incentive slabs, attendance bonus.
// ─────────────────────────────────────────────────────────────────────────────

// Comp-Off policy — company-scoped single-row config. Defines how comp-off
// is earned (minimum qualifying hours, qualifying day types), expiry, and
// encashment. When no row exists, comp-off is disabled.
model CompOffPolicy {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  minQualifyingHours    Int      @default(4) // minimum OT hours to earn 1 comp-off
  qualifyingDayTypes    String   @default("WEEKLY_OFF,HOLIDAY") @db.NVarChar(100)
  requiresApproval      Boolean  @default(true)
  expiryMonths          Int      @default(3) // comp-off expires after N months
  allowEncashment       Boolean  @default(false)
  encashmentRatePerDay  Decimal? @db.Decimal(18, 2) // flat amount per comp-off day encashed
  autoCreditOnApproval  Boolean  @default(true) // auto-credit when OT approved as COMP_OFF
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("CompOffPolicy")
}

// Per-employee comp-off balance — one row per employee. Updated by
// CompOffTransaction entries (credit on OT approval, debit on leave usage).
model CompOffBalance {
  id          Int      @id @default(autoincrement())
  employeeId  Int      @unique
  balance     Decimal  @default(0) @db.Decimal(8, 2) // current available comp-off days
  earned      Decimal  @default(0) @db.Decimal(8, 2) // total earned to date
  used        Decimal  @default(0) @db.Decimal(8, 2) // total used to date
  expired     Decimal  @default(0) @db.Decimal(8, 2) // total expired to date
  encashed    Decimal  @default(0) @db.Decimal(8, 2) // total encashed to date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CompOffBalance")
}

// Comp-off transaction log — one row per credit/debit/expire/encash event.
// Preserves the full audit trail; CompOffBalance is the running total.
model CompOffTransaction {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  date        DateTime @db.Date
  type        String   @db.NVarChar(20) // CREDIT | DEBIT | EXPIRE | ENCASH
  days        Decimal  @db.Decimal(8, 2) // positive for CREDIT, negative for DEBIT/EXPIRE/ENCASH
  balanceAfter Decimal @db.Decimal(8, 2)
  reason      String?  @db.NVarChar(500)
  // Source: which DailyAttendance OT approval credited this, or which
  // LeaveApplication debited it.
  sourceType  String?  @db.NVarChar(20) // OT_APPROVAL | LEAVE | MANUAL | EXPIRY
  sourceId    Int?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId, date])
  @@map("CompOffTransaction")
}

// OT incentive slab — tiered incentive rates based on monthly OT hours.
// E.g. 0-25 hrs = 1x, 25-50 hrs = 1.25x, 50+ hrs = 1.5x. Company-scoped.
model OTIncentiveSlab {
  id              Int      @id @default(autoincrement())
  companyId       Int
  code            String   @db.NVarChar(20)
  name            String   @db.NVarChar(100)
  minOtHours      Decimal  @db.Decimal(8, 2) // lower bound (inclusive)
  maxOtHours      Decimal? @db.Decimal(8, 2) // upper bound (exclusive), null = no upper limit
  incentiveMultiplier Decimal @default(1) @db.Decimal(5, 2) // multiplier on OT amount for hours in this slab; ignored when flatBonusAmount is set
  // A fixed monthly bonus for reaching this OT-hours band, added as its own
  // earning — NOT a multiplier on OT pay. When set, this slab pays
  // flatBonusAmount and incentiveMultiplier is ignored for it.
  flatBonusAmount Decimal? @db.Decimal(18, 2)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, code])
  @@index([effectiveFrom, effectiveTo])
  @@map("OTIncentiveSlab")
}

// Attendance bonus — company-scoped single-row config. Defines the bonus
// amount for perfect attendance (zero LOP, zero late) and proration rules.
model AttendanceBonusConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  bonusAmount           Decimal  @default(0) @db.Decimal(18, 2)
  requiresZeroLop       Boolean  @default(true)
  requiresZeroLate      Boolean  @default(false)
  requiresZeroEarlyOut  Boolean  @default(false)
  prorateByPayableDays  Boolean  @default(false) // prorate bonus by payableDays/totalDays
  minPayableDaysPercent Decimal  @default(100) @db.Decimal(5, 2) // minimum % of days present to qualify
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("AttendanceBonusConfig")
}

// ─────────────────────────────────────────────────────────────────────────────
// Statutory Config (Phase 2C) — LWF, state PT, TDS regime, health insurance.
// ─────────────────────────────────────────────────────────────────────────────

// Labour Welfare Fund — company-scoped effective-dated rate. Different
// states have different rates and frequencies; the admin configures one
// row per state they operate in. Payroll applies the matching row based
// on the employee's work state (from JobInfo.site.state or Unit state).
model LwfRate {
  id                Int      @id @default(autoincrement())
  companyId         Int
  code              String   @db.NVarChar(20)
  state             String   @db.NVarChar(50)
  employeeRate      Decimal  @db.Decimal(10, 2) // flat amount or % of gross
  employerRate      Decimal  @db.Decimal(10, 2)
  rateType          String   @default("FLAT") @db.NVarChar(10) // FLAT | PERCENT
  frequency         String   @default("MONTHLY") @db.NVarChar(20) // MONTHLY | HALF_YEARLY | YEARLY
  deductionMonth    Int      @default(1) // for HALF_YEARLY/YEARLY: which month (1-12) to deduct
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, state, effectiveFrom])
  @@index([companyId, state])
  @@map("LwfRate")
}

// State-wise Professional Tax — extends ProfessionalTaxSlab with state
// jurisdiction. The existing ProfessionalTaxSlab remains for backward
// compatibility (no state = applies to all states); this table takes
// precedence when a row matches the employee's work state.
model StatePtConfig {
  id            Int      @id @default(autoincrement())
  companyId     Int
  code          String   @db.NVarChar(20)
  state         String   @db.NVarChar(50)
  slabCode      String   @db.NVarChar(20) // links to ProfessionalTaxSlab.code
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, state, effectiveFrom])
  @@index([companyId, state])
  @@map("StatePtConfig")
}

// TDS regime configuration — company-scoped single-row config. Defines
// which regime is default, financial year start, and surcharge/cess rates.
// The existing TDSSlab table holds the rate slabs; this config wraps them.
model TdsRegimeConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  defaultRegime         String   @default("NEW") @db.NVarChar(20) // OLD | NEW
  financialYearStart    Int      @default(4) // month (1-12), April=4
  cessRate              Decimal  @default(4) @db.Decimal(5, 2) // health & education cess %
  surchargeThreshold    Decimal  @default(5000000) @db.Decimal(18, 2) // income above which surcharge applies
  surchargeRate         Decimal  @default(10) @db.Decimal(5, 2) // surcharge %
  rebateUptoIncome      Decimal  @default(500000) @db.Decimal(18, 2) // 87A rebate threshold
  rebateAmount          Decimal  @default(12500) @db.Decimal(18, 2) // 87A rebate amount
  standardDeduction     Decimal  @default(50000) @db.Decimal(18, 2) // old regime standard deduction
  isActive              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("TdsRegimeConfig")
}

// Health insurance — company-scoped single-row config. Defines employee +
// employer contribution rates and policy master linkage.
model HealthInsuranceConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  employeeContributionRate Decimal @default(0) @db.Decimal(5, 2) // % of gross
  employerContributionRate  Decimal @default(0) @db.Decimal(5, 2) // % of gross
  monthlyPremium         Decimal @default(0) @db.Decimal(18, 2) // flat monthly premium
  applyToAllEmployees    Boolean  @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("HealthInsuranceConfig")
}

// Employee-submitted short-leave-in-hours request (self-service, like
// Mispunch). Single-stage RBAC approval — the BRD's Permission section
// names no Reporting-Manager stage the way Mispunch/OT explicitly do.
// Approval only flags whether this request pushes the employee over their
// monthly free-hours allowance (exceedsAllowance/excessHours, computed at
// approval time against PermissionPolicy + the month's other approved
// requests) — it does NOT auto-convert the excess to LOP on DailyAttendance,
// since that table has no fractional-day-LOP field; per BRD ("exceed limit
// = LOM only") the excess is meant to reduce pay, so converting it is left
// as a manual attendance correction HR makes using the flagged hours.
model PermissionRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date
  fromTime   DateTime
  toTime     DateTime
  hours      Decimal  @db.Decimal(4, 2)
  reason     String?  @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status                 String    @default("pending_manager") @db.NVarChar(20)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)
  approvedByUserId       Int?
  approvedAt             DateTime?
  rejectionReason        String?   @db.NVarChar(500)

  exceedsAllowance Boolean @default(false)
  excessHours      Decimal @default(0) @db.Decimal(4, 2)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("PermissionRequest")
}

// On-Duty (OD) — employee applies for official duty performed outside the
// normal workplace (client visit, offsite work, travel). Approved OD marks
// the covered days as OnDuty (counted as present) in DailyAttendance rather
// than Absent/LOP. Two-stage approval mirrors MispunchCorrection/
// PermissionRequest; BRD (HRMS-ESS BRD §D) lists fields and manager/HR
// approval but no eligibility/limit rules, so none are enforced here.
model OnDutyRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  location   String   @db.NVarChar(200)
  purpose    String   @db.NVarChar(500)
  customerProject String? @db.NVarChar(200)
  remarks    String?  @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status                 String    @default("pending_manager") @db.NVarChar(20)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)
  approvedByUserId       Int?
  approvedAt             DateTime?
  rejectionReason        String?   @db.NVarChar(500)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("OnDutyRequest")
}

// Work From Home (WFH) — employee applies to work remotely for a date
// range. Approved WFH marks the covered days Present (with a remark) in
// DailyAttendance — "WFH" is not one of the client-confirmed attendance
// statuses (see docs/DECISIONS_NEEDED_2026-09-11.md), so this reuses
// Present rather than inventing a new status. Two-stage approval mirrors
// OnDutyRequest/PermissionRequest. BRD (HRMS-ESS BRD §E) lists only
// date/duration/reason — no eligibility/frequency-limit rules, so none are
// enforced here.
model WfhRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  reason     String   @db.NVarChar(500)
  remarks    String?  @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status                 String    @default("pending_manager") @db.NVarChar(20)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)
  approvedByUserId       Int?
  approvedAt             DateTime?
  rejectionReason        String?   @db.NVarChar(500)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("WfhRequest")
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. PAYROLL PROCESSING — PHASE 1
//     Scope: gross -> LOP-adjusted earnings -> OT -> PF/ESI/PT/TDS (simple
//     estimate against the existing statutory masters) -> net salary ->
//     approve -> lock, with itemized payslips. Reads the employee's current
//     EmployeeSalaryRevision/EmployeeSalaryComponent (NOT EmployeeCtc, which
//     has zero consumers and explicitly forbids invented formulas; NOT the
//     legacy SalaryStructure) and that month's MonthlyAttendanceSummary.
//     Deferred: real Loan/Bonus/Gratuity/Arrear module integration (none of
//     those modules exist yet — PayrollLineComponent.isAdhoc is the
//     manual-entry stand-in), LWF (no master anywhere), full annual TDS with
//     regime/exemptions/rebate/surcharge/cess (flat monthly TDSSlab lookup
//     only), bank transfer files, bulk payslip PDF, configurable rounding,
//     multi-level approval.
// ─────────────────────────────────────────────────────────────────────────────

// Company-level entity (like Unit/Role) — carries companyId directly rather
// than resolving it via an employee join.
model PayrollRun {
  id        Int @id @default(autoincrement())
  companyId Int
  year      Int
  month     Int // 1-12

  // DRAFT | CALCULATED | VALIDATED | SUBMITTED | APPROVED | LOCKED | POSTED
  // — extended from the compressed 4-stage chain to support the BRD's
  // fuller workflow when PayrollWorkflowConfig enables the extra stages.
  // VALIDATED/SUBMITTED/POSTED are optional — only used when the
  // corresponding enable* flag is true on PayrollWorkflowConfig.
  status String @default("DRAFT") @db.NVarChar(20)

  calculatedAt      DateTime?
  validatedAt       DateTime?
  validatedByUserId Int?
  submittedAt       DateTime?
  submittedByUserId Int?
  approvedAt        DateTime?
  approvedByUserId  Int?
  lockedAt          DateTime?
  postedAt          DateTime?
  postedByUserId    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines          PayrollLine[]
  // Arrears applied into this run as ad-hoc PayrollLineComponent rows —
  // see SalaryArrear.appliedPayrollRunId.
  appliedArrears SalaryArrear[]
  // Bonuses applied into this run as ad-hoc PayrollLineComponent rows —
  // see BonusRecord.appliedPayrollRunId.
  appliedBonuses BonusRecord[]
  // Manual arrears applied into this run — see ManualArrear.appliedPayrollRunId.
  appliedManualArrears ManualArrear[]

  @@unique([companyId, year, month])
  @@map("PayrollRun")
}

// One row per employee per run.
model PayrollLine {
  id           Int @id @default(autoincrement())
  payrollRunId Int
  employeeId   Int

  totalWorkingDays Int     @default(0)
  payableDays      Decimal @default(0) @db.Decimal(5, 2)
  lopDays          Int     @default(0)

  grossEarnings      Decimal @default(0) @db.Decimal(18, 2) // LOP-adjusted sum of recurring earning components (excludes CTC-only)
  // Gross tier breakdown for payslip subtotal display. fixedGross = sum
  // of earning components flagged grossTier = FIXED (Basic, HRA, LTA…);
  // additionalGross = sum of grossTier = ADDITIONAL (Additional HRA…).
  // grossEarnings = fixedGross + additionalGross. CTC-only components
  // (includeInGross = false) are in neither subtotal — paid separately.
  fixedGross         Decimal @default(0) @db.Decimal(18, 2)
  additionalGross    Decimal @default(0) @db.Decimal(18, 2)
  // Performance incentive paid this month from the PMS module — a CTC-only
  // earning disbursed based on the employee's approved PMS rating. Not part
  // of grossEarnings and never a base for PF/ESI/PT/TDS.
  performanceIncentive Decimal @default(0) @db.Decimal(18, 2)
  otAmount           Decimal @default(0) @db.Decimal(18, 2)
  // Flat monthly bonus from OTIncentiveSlab.flatBonusAmount for crossing an
  // OT-hours threshold — a separate earning line, not part of otAmount.
  otIncentiveAmount  Decimal @default(0) @db.Decimal(18, 2)
  otherEarningsTotal Decimal @default(0) @db.Decimal(18, 2) // sum of isAdhoc earning components

  pfEmployee           Decimal @default(0) @db.Decimal(18, 2)
  pfEmployer           Decimal @default(0) @db.Decimal(18, 2)
  epsEmployer          Decimal @default(0) @db.Decimal(18, 2)
  esiEmployee          Decimal @default(0) @db.Decimal(18, 2)
  esiEmployer          Decimal @default(0) @db.Decimal(18, 2)
  professionalTax      Decimal @default(0) @db.Decimal(18, 2)
  tds                  Decimal @default(0) @db.Decimal(18, 2)
  otherDeductionsTotal Decimal @default(0) @db.Decimal(18, 2) // sum of isAdhoc deduction components
  lomAmount            Decimal @default(0) @db.Decimal(18, 2) // Loss of Minutes deduction
  lwfAmount            Decimal @default(0) @db.Decimal(18, 2) // Labour Welfare Fund deduction
  healthInsurance      Decimal @default(0) @db.Decimal(18, 2) // Health insurance employee contribution
  licAmount            Decimal @default(0) @db.Decimal(18, 2) // LIC premium deduction

  netSalary Decimal @default(0) @db.Decimal(18, 2)

  // Snapshotted from JobInfo/defaults at calculate time (not live-joined),
  // same convention as DailyAttendance.shiftMasterId. pfApplicable has no
  // JobInfo source field (unlike esi/pt) — defaults true, editable per run.
  pfApplicable  Boolean @default(true)
  esiApplicable Boolean @default(false)
  ptApplicable  Boolean @default(false)

  // OK | HOLD — per-employee exception flag, distinct from the run's own
  // status (e.g. attendance not finalized for this employee yet).
  status     String  @default("OK") @db.NVarChar(20)
  holdReason String? @db.NVarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun             @relation(fields: [payrollRunId], references: [id])
  employee   Employee               @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components PayrollLineComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("PayrollLine")
}

// Itemization for the payslip — both the LOP-adjusted recurring components
// (isAdhoc: false) and any one-off entries added to this run only
// (isAdhoc: true — e.g. a manually-entered loan recovery or bonus, since
// those modules don't exist yet).
model PayrollLineComponent {
  id                Int     @id @default(autoincrement())
  payrollLineId     Int
  salaryComponentId Int
  amount            Decimal @db.Decimal(18, 2)
  isAdhoc           Boolean @default(false)

  createdAt DateTime @default(now())

  payrollLine     PayrollLine     @relation(fields: [payrollLineId], references: [id])
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@index([payrollLineId])
  @@map("PayrollLineComponent")
}

// ─────────────────────────────────────────────────────────────────────────────
// 16. SALARY REVISION & ARREAR — PHASE 1
//     Scope: employee-wise revision request with a single-approver workflow
//     (Draft/Submitted/Approved/Rejected/Hold/Cancelled — no HR-Verification-
//     then-Management multi-stage chain) that, on approval, versions the
//     employee's salary via the same logic src/app/api/employees/[id]/salary
//     already uses (extracted into src/lib/salaryRevisioning.ts) and
//     auto-detects a retroactive effective date to generate a month-wise
//     SalaryArrear, which is then pushed into Payroll as ad-hoc
//     PayrollLineComponent rows — reusing the ad-hoc mechanism from section 15
//     rather than inventing a new payroll-input concept.
//     Deferred to a later phase: SalaryRevisionCycle (bulk/department/grade-
//     wide revisions), a configurable eligibility engine, bulk Excel upload,
//     multi-level approval, a separate arrear-approval stage, a dedicated
//     audit table (reuse EmployeeActivity/logActivity instead), the reports
//     suite, "Other Deduction Arrear", and PT/TDS arrear adjustment.
//     All FKs here are onDelete/onUpdate: NoAction — several of these models
//     have more than one path back to Company/Employee (e.g. SalaryArrear
//     carries both companyId/employeeId directly AND a link through
//     SalaryRevisionRequest, which itself reaches the same rows), so every
//     relation is pinned NoAction up front rather than chasing SQL Server's
//     "multiple cascade paths" error one FK at a time.
// ─────────────────────────────────────────────────────────────────────────────

model SalaryRevisionRequest {
  id         Int @id @default(autoincrement())
  companyId  Int
  employeeId Int

  // ANNUAL_INCREMENT | PROMOTION | SPECIAL
  revisionType   String @db.NVarChar(30)
  // PERCENTAGE | FIXED_AMOUNT | REVISED_GROSS — which input the user typed;
  // the other two of {incrementPercent, incrementAmount, revisedGross} are
  // server-computed from it (BRD §27).
  revisionMethod String @db.NVarChar(20)

  currentGross     Decimal  @db.Decimal(18, 2) // snapshot of gross at proposal time
  incrementPercent Decimal? @db.Decimal(7, 2)
  incrementAmount  Decimal? @db.Decimal(18, 2)
  revisedGross     Decimal  @db.Decimal(18, 2)

  effectiveFrom DateTime

  // DRAFT | SUBMITTED | PENDING_MANAGER | PENDING_HR | APPROVED | REJECTED | HOLD | CANCELLED
  status       String  @default("DRAFT") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  // Manager stage (two-level approval: Manager → HR)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectReason   String? @db.NVarChar(500)

  // Set once approved — the new EmployeeSalaryRevision version this request
  // produced. @unique here is for Prisma's relation typing only — the real
  // DB constraint is a FILTERED unique index (WHERE appliedRevisionId IS
  // NOT NULL, migration 000010), same fix as Employee.userId, since most
  // requests sit at NULL until approved and SQL Server's plain UNIQUE only
  // allows one NULL. `prisma migrate diff` will keep re-emitting the plain
  // "ADD CONSTRAINT ... UNIQUE NONCLUSTERED" version of this — exclude it
  // from any future migration, same as Employee_userId_key.
  appliedRevisionId Int? @unique

  createdByUserId  Int?
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedRevision EmployeeSalaryRevision?   @relation(fields: [appliedRevisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components      SalaryRevisionComponent[]
  arrear          SalaryArrear?

  @@index([companyId, status])
  @@index([employeeId])
  @@map("SalaryRevisionRequest")
}

// Component-level revised amounts for the proposal — mirrors
// EmployeeSalaryComponent's shape; copied into a real EmployeeSalaryComponent
// row set on approval via salaryRevisioning.ts.
model SalaryRevisionComponent {
  id                      Int     @id @default(autoincrement())
  salaryRevisionRequestId Int
  salaryComponentId       Int
  currentAmount           Decimal @db.Decimal(18, 2)
  revisedAmount           Decimal @db.Decimal(18, 2)

  salaryRevisionRequest SalaryRevisionRequest @relation(fields: [salaryRevisionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent       SalaryComponent       @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryRevisionRequestId, salaryComponentId])
  @@map("SalaryRevisionComponent")
}

// One per approved + retroactive SalaryRevisionRequest — header totals;
// month-wise detail lives in SalaryArrearMonth (BRD §18's auditability ask).
model SalaryArrear {
  id                      Int @id @default(autoincrement())
  salaryRevisionRequestId Int @unique
  employeeId              Int
  companyId               Int

  oldGross     Decimal @db.Decimal(18, 2)
  revisedGross Decimal @db.Decimal(18, 2)

  arrearFromYear  Int
  arrearFromMonth Int
  arrearToYear    Int
  arrearToMonth   Int

  grossArrearTotal Decimal @default(0) @db.Decimal(18, 2)
  pfArrearTotal    Decimal @default(0) @db.Decimal(18, 2)
  esiArrearTotal   Decimal @default(0) @db.Decimal(18, 2)
  netArrearTotal   Decimal @default(0) @db.Decimal(18, 2)

  // CALCULATED | APPLIED
  status       String   @default("CALCULATED") @db.NVarChar(20)
  calculatedAt DateTime @default(now())

  appliedPayrollRunId Int?
  appliedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRevisionRequest SalaryRevisionRequest @relation(fields: [salaryRevisionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company               Company               @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedPayrollRun     PayrollRun?           @relation(fields: [appliedPayrollRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  months                SalaryArrearMonth[]

  @@map("SalaryArrear")
}

model SalaryArrearMonth {
  id             Int @id @default(autoincrement())
  salaryArrearId Int
  year           Int
  month          Int

  oldGross        Decimal @db.Decimal(18, 2)
  revisedGross    Decimal @db.Decimal(18, 2)
  grossDifference Decimal @db.Decimal(18, 2)
  pfArrear        Decimal @default(0) @db.Decimal(18, 2)
  esiArrear       Decimal @default(0) @db.Decimal(18, 2)
  netArrear       Decimal @db.Decimal(18, 2)

  salaryArrear SalaryArrear @relation(fields: [salaryArrearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([salaryArrearId, year, month])
  @@map("SalaryArrearMonth")
}

// ─────────────────────────────────────────────────────────────────────────────
// 17. BONUS MANAGEMENT — PHASE 1 (Tier 5a)
//     Scope: statutory-minimum bonus only (BRD's own worked example —
//     min(basic, wage ceiling) × 12 × rate%), against a configurable
//     BonusRate master, with a single-approver workflow that pushes the
//     approved amount into Payroll as an ad-hoc earning line — same pattern
//     as section 16's SalaryArrear → PayrollLineComponent integration.
//     Deferred: the full allocable-surplus/Set-On-Set-Off variable bonus
//     scheme, unit/category/performance-based rate determinants, a
//     configured Remark master, true attendance-day-sum eligibility (DOJ-vs-
//     calculation-date proxy instead), multi-level approval, bulk
//     upload/export, a dedicated audit table (reuse EmployeeActivity).
//     Gratuity (the BRD's "II." module) is intentionally out of scope here —
//     see Tier 5b.
// ─────────────────────────────────────────────────────────────────────────────

// Company-scoped since migration 000013 (previously global, like PfRate/
// EsiRate). calculationType picks which of the two Phase-1 bonus formulas
// bonusCalculation.ts uses for this company: BASIC_PROJECTION (the original
// Tier 5a logic) or ACTUAL_NET_PAY (sums real PayrollLine.netSalary paid
// across the accounting year instead of projecting off Basic). 8.33% is a
// hard floor on ratePercent/minRatePercent — enforced in
// src/lib/validations/master.ts's bonusRateSchema, not just documented.
model BonusRate {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  code                   String    @db.NVarChar(20)
  calculationType        String    @default("BASIC_PROJECTION") @db.NVarChar(30)
  ratePercent            Decimal   @db.Decimal(5, 2) // e.g. 8.33
  minRatePercent         Decimal   @db.Decimal(5, 2)
  maxRatePercent         Decimal   @db.Decimal(5, 2)
  wageEligibilityCeiling Decimal   @db.Decimal(18, 2) // e.g. 21000 — monthly wage must be <= this
  calculationWageCeiling Decimal   @db.Decimal(18, 2) // e.g. 7000 — wage basis capped at this (BASIC_PROJECTION only)
  minWorkingDays         Int       @default(30)
  effectiveFrom          DateTime
  effectiveTo            DateTime? // NULL = currently active
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, effectiveFrom, effectiveTo])
  @@index([code])
  @@map("BonusRate")
}

// One row per employee per accounting year (acYear = FY's starting calendar
// year, e.g. 2026 for "2026-2027" — same convention as the PT report's
// financialYear).
model BonusRecord {
  id         Int @id @default(autoincrement())
  companyId  Int
  employeeId Int
  acYear     Int

  currentGross   Decimal  @db.Decimal(18, 2)
  currentBasic   Decimal  @db.Decimal(18, 2)
  doj            DateTime
  yearsOfService Decimal  @db.Decimal(6, 2)

  // ELIGIBLE | NOT_ELIGIBLE_WAGE | NOT_ELIGIBLE_SERVICE | MANUAL_REVIEW
  // (MANUAL_REVIEW: ACTUAL_NET_PAY type with zero processed payroll months
  // this accounting year — nothing to sum, not a fabricated ₹0 bonus)
  eligibilityStatus String  @db.NVarChar(30)
  eligibilityReason String? @db.NVarChar(500)

  // BASIC_PROJECTION | ACTUAL_NET_PAY — snapshot of which BonusRate.calculationType
  // produced this record, for display/audit.
  calculationType String   @default("BASIC_PROJECTION") @db.NVarChar(30)
  // The wage base bonusAmount was last computed from (min(basic,ceiling)×12
  // for BASIC_PROJECTION, summed actual netSalary for ACTUAL_NET_PAY) —
  // stored so PUT /api/bonus/records/[id] can recompute bonusAmount from a
  // new bonusPercent without re-touching Payroll data.
  annualBonusWage Decimal? @db.Decimal(18, 2)

  bonusPercent Decimal? @db.Decimal(5, 2)
  bonusAmount  Decimal? @db.Decimal(18, 2)

  // PENDING | NOT_ELIGIBLE | CALCULATED | APPROVED | REJECTED | HOLD | PROCESSED
  status       String  @default("PENDING") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  appliedPayrollRunId Int?
  appliedAt           DateTime?

  // Phase 14 — bonus type categorization + paid/balance tracking (BRD §6).
  // FESTIVAL | ANNUAL | PERFORMANCE | EX_GRATIA | PRODUCTION | OTHER
  bonusType       String   @default("ANNUAL") @db.NVarChar(30)
  // For monthly accrual: amount accrued per month, total accrued, paid, balance
  monthlyAccrual  Decimal  @default(0) @db.Decimal(18, 2)
  totalAccrued    Decimal  @default(0) @db.Decimal(18, 2)
  totalPaid       Decimal  @default(0) @db.Decimal(18, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(18, 2)

  calculatedAt     DateTime?
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedPayrollRun PayrollRun? @relation(fields: [appliedPayrollRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, employeeId, acYear])
  @@index([companyId, acYear, status])
  @@map("BonusRecord")
}

// ─────────────────────────────────────────────────────────────────────────────
// 18. GRATUITY — PHASE 1 (Tier 5b)
//     Scope: the BRD's own worked example (§20) — Last Drawn Eligible Salary
//     x multiplierNumerator/multiplierDenominator x Completed Years of
//     Service, capped at a configurable ceiling, both gross and payable
//     figures retained (§13). Triggered per-employee by their own
//     ExitInterview (section 7's schema-only model, finally getting an
//     API/UI here), not a whole-company batch like Bonus.
//     Deferred: multiple/category-specific policies, the standalone
//     estimation facility, death/disability special rules + nominee/
//     document tracking, multi-level approval, bulk processing, the full
//     reports suite, a dedicated audit table (reuse EmployeeActivity),
//     Payroll integration (gratuity is a terminal settlement per the BRD's
//     own diagram, not an ad-hoc PayrollLineComponent like Arrear/Bonus —
//     paymentDate/paymentReference live directly on GratuityRecord).
// ─────────────────────────────────────────────────────────────────────────────

model GratuityPolicy {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  code                    String    @db.NVarChar(20)
  policyName              String    @db.NVarChar(100)
  multiplierNumerator     Decimal   @default(15) @db.Decimal(5, 2)
  multiplierDenominator   Decimal   @default(26) @db.Decimal(5, 2)
  minEligibleServiceYears Decimal   @default(5) @db.Decimal(5, 2)
  maxGratuityCeiling      Decimal   @db.Decimal(18, 2)
  effectiveFrom           DateTime
  effectiveTo             DateTime? // NULL = currently active
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, effectiveFrom, effectiveTo])
  @@index([code])
  @@map("GratuityPolicy")
}

// One row per employee separation (1:1 with ExitInterview).
model GratuityRecord {
  id              Int @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  exitInterviewId Int @unique

  doj                    DateTime
  separationDate         DateTime
  qualifyingServiceYears Decimal  @db.Decimal(6, 2)

  // ELIGIBLE | NOT_ELIGIBLE_SERVICE
  eligibilityStatus String  @db.NVarChar(30)
  eligibilityReason String? @db.NVarChar(500)

  eligibleSalary        Decimal? @db.Decimal(18, 2)
  multiplierNumerator   Decimal? @db.Decimal(5, 2)
  multiplierDenominator Decimal? @db.Decimal(5, 2)
  // Pre-ceiling and post-ceiling amounts, both retained — BRD §13.
  grossGratuity         Decimal? @db.Decimal(18, 2)
  payableGratuity       Decimal? @db.Decimal(18, 2)

  // CALCULATED | NOT_ELIGIBLE | APPROVED | REJECTED | HOLD | PAID
  status       String  @default("CALCULATED") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  paymentDate      DateTime?
  paymentReference String?   @db.NVarChar(100)

  calculatedAt     DateTime  @default(now())
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exitInterview ExitInterview @relation(fields: [exitInterviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@map("GratuityRecord")
}

// -----------------------------------------------------------------------------
// 19. VISITOR MANAGEMENT - GATE PASS
//     Scope: visitor entry scheduling + gate movement (check-in/check-out) +
//     QR-validated gate pass + PDF downloads. Type is a hard enum
//     (GATE_PASS | WORK_PERMIT); Visitor Type / Purpose / Food Category /
//     Food Type / Gadgets are DropdownMaster categories (visitor_*), so HR
//     can add new options without a deploy. Person To Meet is a live FK to
//     Employee. QR validity is a per-pass field set at creation time.
// -----------------------------------------------------------------------------

model VisitorGatePass {
  id                Int       @id @default(autoincrement())
  companyId         Int
  gatePassNo        String    @unique @db.NVarChar(50)   // GPN/<TYPE>/<seq>
  passType          String    @db.NVarChar(20)           // GATE_PASS | WORK_PERMIT
  status            String    @default("DRAFT") @db.NVarChar(20)
                        // DRAFT | PENDING_APPROVAL | APPROVED | CHECKED_IN | CHECKED_OUT | COMPLETED
                        // REJECTED | CANCELLED | EXPIRED

  // visitor
  visitorName       String    @db.NVarChar(100)
  mobileNo          String    @db.NVarChar(15)
  mobilePrefix      String    @default("+91") @db.NVarChar(5)
  visitorTypeValue  String?   @db.NVarChar(100)  // DropdownMaster value
  partyName         String?   @db.NVarChar(200)
  email             String?   @db.NVarChar(200)
  address           String?   @db.NVarChar(500)
  identityProofType   String? @db.NVarChar(50)
  identityProofNumber String? @db.NVarChar(100)

  // schedule - validity window, not a single date
  visitDate         DateTime  @db.Date
  validFrom         DateTime
  validTo           DateTime
  plannedInTime     String?   @db.NVarChar(5)  // "HH:mm"
  plannedOutTime    String?   @db.NVarChar(5)

  // host
  personToMeetId    Int
  noOfPersons       Int       @default(1)
  purposeValue      String?   @db.NVarChar(100)  // DropdownMaster value
  remarks           String?   @db.NVarChar(500)

  // vehicle / driver
  vehicleNumber     String?   @db.NVarChar(20)
  vehicleType       String?   @db.NVarChar(50)
  driverName        String?   @db.NVarChar(100)
  driverMobile      String?   @db.NVarChar(15)

  // logistics
  foodRequired      Boolean   @default(false)
  foodCategory      String?   @db.NVarChar(50)
  foodType          String?   @db.NVarChar(50)
  gadgets           String?   @db.NVarChar(50)

  // approval
  approvedBy        Int?
  approvedAt        DateTime?
  approvalComments  String?   @db.NVarChar(500)
  rejectionReason   String?   @db.NVarChar(500)

  // gate movement
  checkInBy         Int?
  checkInTime       DateTime?
  checkInGate       String?   @db.NVarChar(50)
  checkOutBy        Int?
  checkOutTime      DateTime?
  checkOutGate      String?   @db.NVarChar(50)

  // QR - random token + per-pass validity in minutes
  qrToken           String    @unique @db.NVarChar(64)
  qrValidMinutes    Int       @default(1440)

  createdBy         Int?
  createdAt         DateTime  @default(now())
  updatedBy         Int?
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company      Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personToMeet Employee @relation(fields: [personToMeetId], references: [id])

  @@index([companyId, status])
  @@index([companyId, visitDate])
  @@map("VisitorGatePass")
}

// -----------------------------------------------------------------------------
// 19b. MATERIAL GATE / GNR (Gate Number Register)
//      Linked to a Delivery Challan (DC) number, tracks material inward/outward
//      and returnable/non-returnable movements through the gate.
// -----------------------------------------------------------------------------

model GateNumberRegister {
  id                Int       @id @default(autoincrement())
  companyId         Int

  gnrNo             String    @unique @db.NVarChar(50) // GNR/<TYPE>/<seq>
  dcNo              String    @db.NVarChar(100)
  dcDate            DateTime? @db.Date
  movementType      String    @db.NVarChar(50)
                        // MATERIAL_INWARD | MATERIAL_OUTWARD | RETURNABLE | NON_RETURNABLE | SERVICE_REPAIR

  status            String    @default("DRAFT") @db.NVarChar(30)
                        // DRAFT | DC_CAPTURED | GNR_CREATED | AWAITING_AUTHORIZATION | AUTHORIZED |
                        // INWARD_RECORDED | OUTWARD_RECORDED | ACKNOWLEDGED | PARTIALLY_RECEIVED |
                        // COMPLETED | CANCELLED | REJECTED | EXCEPTION_PENDING

  // counterparty
  counterpartyType  String?   @db.NVarChar(20) // SUPPLIER | CUSTOMER | TRANSPORTER
  counterpartyName  String?   @db.NVarChar(200)
  transporterName   String?   @db.NVarChar(200)
  sourceLocation    String?   @db.NVarChar(200)
  destinationLocation String? @db.NVarChar(200)
  contactName       String?   @db.NVarChar(100)
  contactMobile     String?   @db.NVarChar(15)

  // references
  purchaseOrderRef  String?   @db.NVarChar(100)
  workOrderRef      String?   @db.NVarChar(100)
  authorizationRef  String?   @db.NVarChar(100)

  // vehicle / driver
  vehicleNumber     String?   @db.NVarChar(20)
  vehicleType       String?   @db.NVarChar(50)
  driverName        String?   @db.NVarChar(100)
  driverMobile      String?   @db.NVarChar(15)
  driverId          String?   @db.NVarChar(50)

  // gate transaction
  gateId            String?   @db.NVarChar(50)
  inwardBy          Int?
  inwardTime        DateTime?
  inwardRemarks     String?   @db.NVarChar(500)
  outwardBy         Int?
  outwardTime       DateTime?
  outwardRemarks    String?   @db.NVarChar(500)

  // authorization / control
  authorizedBy      Int?
  authorizedAt      DateTime?
  exceptionReason   String?   @db.NVarChar(500)
  rejectionReason   String?   @db.NVarChar(500)

  // documents (placeholders - real file storage integration later)
  dcDocumentUrl     String?   @db.NVarChar(500)
  supportingDocumentUrl String? @db.NVarChar(500)
  remarks           String?   @db.NVarChar(500)

  createdBy         Int?
  createdAt         DateTime  @default(now())
  updatedBy         Int?
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  company           Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lineItems         GNRLineItem[]

  @@index([companyId, status])
  @@index([companyId, dcNo])
  @@index([companyId, movementType])
  @@map("GateNumberRegister")
}

model GNRLineItem {
  id                Int       @id @default(autoincrement())
  gnrId             Int

  materialDescription String  @db.NVarChar(500)
  itemCode          String?   @db.NVarChar(100)
  quantity          Decimal?  @db.Decimal(18, 4)
  unit              String?   @db.NVarChar(30)
  packageCount      Int?
  returnable        Boolean   @default(false)
  receivedQuantity  Decimal?  @db.Decimal(18, 4)
  remarks           String?   @db.NVarChar(500)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  gnr               GateNumberRegister @relation(fields: [gnrId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([gnrId])
  @@map("GNRLineItem")
}

// -----------------------------------------------------------------------------
// 19c. VISITOR NOTIFICATION LOG
//      Captures notification events for the visitor / gate module. Actual
//      delivery (email/WhatsApp/SMS) is delegated to company-configured
//      channels in a later integration step.
// -----------------------------------------------------------------------------

model VisitorNotificationLog {
  id          Int       @id @default(autoincrement())
  companyId   Int

  event       String    @db.NVarChar(50)
                        // VISITOR_SUBMITTED | VISITOR_APPROVED | VISITOR_REJECTED |
                        // VISITOR_CHECKED_IN | VISITOR_CHECKED_OUT | VISITOR_OVERDUE |
                        // GNR_CREATED | GNR_AUTHORIZED | GNR_INWARD | GNR_OUTWARD

  channel     String    @default("IN_APP") @db.NVarChar(20)
                        // IN_APP | EMAIL | SMS | WHATSAPP
  recipient   String    @db.NVarChar(200) // email/mobile/userId
  subject     String?   @db.NVarChar(200)
  body        String?   @db.NVarChar(1000)
  status      String    @default("PENDING") @db.NVarChar(20)
                        // PENDING | SENT | FAILED | READ

  // relates to either a visitor pass or a GNR
  visitorGatePassId Int?
  gnrId             Int?

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  readAt      DateTime?
  error       String?   @db.NVarChar(500)

  @@index([companyId, event])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("VisitorNotificationLog")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2D — Leave Encashment, Full & Final, Bank File Template.
// ─────────────────────────────────────────────────────────────────────────────

// Leave encashment — company-scoped single-row config. Defines the basis
// (basic/gross), denominator (26/30), and eligibility (min service, max days).
model LeaveEncashmentConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  calculationBasis      String   @default("GROSS") @db.NVarChar(20) // GROSS | BASIC | BASIC_DA
  denominator           Int      @default(26) // 26 or 30
  minServiceMonths      Int      @default(0) // 0 = no minimum
  maxEncashableDays     Int      @default(45) // cap on days encashable per year
  includeEarnedOnly     Boolean  @default(true) // encash earned leaves only, not accrued
  prorateByLop          Boolean  @default(false) // reduce encashment by LOP days
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("LeaveEncashmentConfig")
}

// Full & Final settlement — company-scoped single-row config. Defines which
// components are included in the settlement and the approval chain.
model FullAndFinalConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  includeUnpaidSalary   Boolean  @default(true)
  includeLeaveEncashment Boolean @default(true)
  includeGratuity       Boolean  @default(true)
  includeBonusProportion Boolean @default(false)
  includeNoticePay      Boolean  @default(true) // notice pay recovery or payable
  noticePeriodDays      Int      @default(30)
  includeLoanRecovery   Boolean  @default(true)
  includeAssetRecovery  Boolean  @default(true)
  approvalStages        String   @default("HR_FINANCE") @db.NVarChar(100) // HR | HR_FINANCE | MANAGER_HR_FINANCE
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("FullAndFinalConfig")
}

// Bank file template — company-scoped. Defines the format for the bank
// transfer file (RTGS/NEFT/IMPS). Multiple templates per company (one per bank).
model BankFileTemplate {
  id              Int      @id @default(autoincrement())
  companyId       Int
  code            String   @db.NVarChar(20)
  name            String   @db.NVarChar(100)
  bankName        String   @db.NVarChar(100)
  fileFormat      String   @default("CSV") @db.NVarChar(20) // CSV | XLSX | TXT | FIXED_WIDTH
  delimiter       String   @default(",") @db.NVarChar(5)
  // Column definitions as JSON: [{ "field": "employeeCode", "label": "Employee ID", "width": 10, "pad": "left" }, ...]
  columnMapping   String   @db.NVarChar(2000)
  headerRow       Boolean  @default(true)
  footerRow       Boolean  @default(false)
  footerTemplate  String?  @db.NVarChar(500)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@map("BankFileTemplate")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — TDS Annual Engine (investment declarations, proofs, annual calc).
// ─────────────────────────────────────────────────────────────────────────────

// Investment declaration — employee-submitted, per financial year. An
// employee may submit multiple declarations (e.g. amend during the year);
// the latest approved one is used by the TDS engine.
model TdsInvestmentDeclaration {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  companyId       Int
  financialYear   Int      // e.g. 2026 for FY 2026-27
  regime          String   @default("NEW") @db.NVarChar(20) // OLD | NEW

  // Old regime deductions (section 80C, 80D, 80CCD, etc.)
  section80C      Decimal  @default(0) @db.Decimal(18, 2) // PF, ELSS, LIC, PPF, etc. (cap 150000)
  section80D      Decimal  @default(0) @db.Decimal(18, 2) // health insurance premium
  section80CCD    Decimal  @default(0) @db.Decimal(18, 2) // NPS
  section80G      Decimal  @default(0) @db.Decimal(18, 2) // donations
  section80E      Decimal  @default(0) @db.Decimal(18, 2) // education loan interest
  section80TTA    Decimal  @default(0) @db.Decimal(18, 2) // savings account interest
  otherDeductions Decimal  @default(0) @db.Decimal(18, 2) // any other declared deduction
  hraExemption    Decimal  @default(0) @db.Decimal(18, 2) // HRA exemption claimed

  // New regime — standard deduction is auto-applied from TdsRegimeConfig;
  // no investment deductions allowed, but this field lets employees
  // declare other income (e.g. interest) that increases taxable income.
  otherIncome     Decimal  @default(0) @db.Decimal(18, 2)

  // pending_hr | approved | rejected
  status          String   @default("pending_hr") @db.NVarChar(20)
  approvedByUserId Int?
  approvedAt       DateTime?
  rejectionReason  String? @db.NVarChar(500)
  remarks         String? @db.NVarChar(500)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company Company  @relation(fields: [companyId], references: [id])
  proofs   TdsInvestmentProof[]

  @@index([employeeId, financialYear])
  @@index([companyId, financialYear])
  @@map("TdsInvestmentDeclaration")
}

// Investment proof — uploaded documents backing a declaration. One
// declaration may have multiple proofs (e.g. ELSS statement, LIC receipt).
model TdsInvestmentProof {
  id              Int      @id @default(autoincrement())
  declarationId   Int
  section         String   @db.NVarChar(20) // 80C | 80D | 80CCD | 80G | 80E | 80TTA | OTHER | HRA
  amount          Decimal  @db.Decimal(18, 2)
  description     String?  @db.NVarChar(500)
  // Document reference — stored as a URL/path to the uploaded file. The
  // actual file upload is handled by a separate file API; this stores the
  // reference so the proof can be retrieved and verified.
  documentUrl     String?  @db.NVarChar(500)
  // pending | verified | rejected
  status          String   @default("pending") @db.NVarChar(20)
  verifiedByUserId Int?
  verifiedAt       DateTime?
  rejectionReason  String? @db.NVarChar(500)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  declaration TdsInvestmentDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@map("TdsInvestmentProof")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6 — Loans and Advances.
// ─────────────────────────────────────────────────────────────────────────────

// Loan — an employee's sanctioned loan. Tracks principal, interest,
// tenure, disbursement, and repayment status. LoanType defines the
// product (min/max amount, description); this model is the instance.
model Loan {
  id              Int      @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  loanTypeId      Int
  code            String   @db.NVarChar(20) // unique loan reference within company
  principal       Decimal  @db.Decimal(18, 2)
  interestRate    Decimal  @default(0) @db.Decimal(5, 2) // annual %, 0 = interest-free
  tenureMonths    Int      // total installment count
  installmentAmount Decimal @db.Decimal(18, 2) // principal+interest per month (EMI)
  disbursementDate DateTime @db.Date
  firstDeductionMonth Int?  // 1-12, null = next month after disbursement
  firstDeductionYear  Int?

  // pending | approved | rejected | disbursed | active | closed | written_off
  status          String   @default("pending") @db.NVarChar(20)

  // Approval chain
  requestedByUserId  Int?
  approvedByUserId   Int?
  approvedAt         DateTime?
  rejectionReason    String?  @db.NVarChar(500)

  // Disbursement
  disbursedByUserId  Int?
  disbursedAt        DateTime?
  disbursementReference String? @db.NVarChar(100) // cheque/UTR

  // Running totals (updated as installments are deducted via payroll)
  principalPaid    Decimal  @default(0) @db.Decimal(18, 2)
  interestPaid     Decimal  @default(0) @db.Decimal(18, 2)
  outstandingBalance Decimal @db.Decimal(18, 2) // principal - principalPaid
  installmentsPaid Int      @default(0)

  closedAt         DateTime?
  closureReason    String?  @db.NVarChar(500)
  remarks         String?   @db.NVarChar(500)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loanType  LoanType  @relation(fields: [loanTypeId], references: [id])
  installments LoanInstallment[]

  @@unique([companyId, code])
  @@index([employeeId])
  @@index([companyId, status])
  @@map("Loan")
}

// Loan installment — one row per scheduled EMI. Generated when the loan
// is disbursed. Each row is linked to a payroll run when deducted.
model LoanInstallment {
  id          Int      @id @default(autoincrement())
  loanId      Int
  installmentNumber Int  // 1-based
  dueDate     DateTime @db.Date
  principalComponent Decimal @db.Decimal(18, 2)
  interestComponent  Decimal @db.Decimal(18, 2)
  totalAmount        Decimal @db.Decimal(18, 2)

  // pending | deducted | skipped | adjusted
  status      String   @default("pending") @db.NVarChar(20)
  payrollRunId Int?
  deductedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, installmentNumber])
  @@map("LoanInstallment")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 8 — Full & Final Settlement.
// ─────────────────────────────────────────────────────────────────────────────

// FnF settlement — one per exited employee. Aggregates all terminal dues:
// unpaid salary, leave encashment, gratuity, bonus proportion, notice pay,
// loan recovery, asset recovery. Created when an exit is recorded; components
// are calculated based on FullAndFinalConfig.
model FnFSettlement {
  id              Int      @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  exitInterviewId Int     @unique

  // Settlement period
  lastWorkingDay  DateTime @db.Date
  settlementDate  DateTime?

  // Components (all amounts in currency)
  unpaidSalary       Decimal  @default(0) @db.Decimal(18, 2)
  leaveEncashment    Decimal  @default(0) @db.Decimal(18, 2)
  leaveEncashmentDays Int     @default(0)
  gratuity           Decimal  @default(0) @db.Decimal(18, 2)
  bonusProportion    Decimal  @default(0) @db.Decimal(18, 2)
  noticePay          Decimal  @default(0) @db.Decimal(18, 2) // +ve = payable, -ve = recovery
  loanRecovery        Decimal  @default(0) @db.Decimal(18, 2)
  assetRecovery       Decimal  @default(0) @db.Decimal(18, 2)
  otherPayments      Decimal  @default(0) @db.Decimal(18, 2)
  otherDeductions     Decimal  @default(0) @db.Decimal(18, 2)

  // Totals
  totalPayable     Decimal  @default(0) @db.Decimal(18, 2) // sum of all +ve
  totalRecovery    Decimal  @default(0) @db.Decimal(18, 2) // sum of all -ve
  netPayable       Decimal  @default(0) @db.Decimal(18, 2) // payable - recovery

  // pending | calculated | approved | paid | rejected
  status           String   @default("pending") @db.NVarChar(20)

  calculatedByUserId Int?
  calculatedAt       DateTime?
  approvedByUserId   Int?
  approvedAt         DateTime?
  rejectionReason    String?  @db.NVarChar(500)
  remarks            String?  @db.NVarChar(500)

  paymentDate        DateTime?
  paymentReference   String?  @db.NVarChar(100)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id])
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exitInterview ExitInterview @relation(fields: [exitInterviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@map("FnFSettlement")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 9 — Incentives & Allowances (Batch 2E).
// ─────────────────────────────────────────────────────────────────────────────

// IncentivePolicy — company-scoped. Defines incentive types (attendance
// bonus, shift bonus, production, special) and how they're calculated.
model IncentivePolicy {
  id                Int      @id @default(autoincrement())
  companyId         Int
  type              String   @db.NVarChar(30) // ATTENDANCE_BONUS | SHIFT_BONUS | PRODUCTION | SPECIAL | OTHER
  name              String   @db.NVarChar(100)
  amount            Decimal  @db.Decimal(18, 2)
  calculationType   String   @default("FLAT") @db.NVarChar(20) // FLAT | FORMULA
  formula           String?  @db.NVarChar(500) // JSON formula if calculationType=FORMULA
  eligibility       String?  @db.NVarChar(500) // JSON eligibility criteria
  eligibleShiftCodes String? @db.NVarChar(200) // comma-separated shift codes for SHIFT_BONUS
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, type])
  @@map("IncentivePolicy")
}

// DoubleMachineEntry — per-employee, per-day. Tracks when an employee
// works on two machines simultaneously; incentive is calculated based
// on working hours and rate.
model DoubleMachineEntry {
  id                Int      @id @default(autoincrement())
  employeeId        Int
  date              DateTime @db.Date
  machine1          String?   @db.NVarChar(50)
  machine2          String?   @db.NVarChar(50)
  numMachines       Int       @default(1)
  workingHours      Decimal   @db.Decimal(5, 2)
  incentiveRate     Decimal  @db.Decimal(18, 2)
  calculatedIncentive Decimal @db.Decimal(18, 2)
  hrRemarks         String?   @db.NVarChar(500)
  status            String   @default("PENDING") @db.NVarChar(20) // PENDING | APPROVED | REJECTED
  approvedByUserId  Int?
  approvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@map("DoubleMachineEntry")
}

// CanteenToken — per-employee, per-day. Tracks canteen token usage;
// employee contribution is deducted from payroll.
model CanteenToken {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  date            DateTime @db.Date
  tokensUsed      Int      @default(0)
  ratePerToken    Decimal  @db.Decimal(18, 2)
  employeeContribution Decimal @db.Decimal(18, 2)
  companyContribution   Decimal @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId, date])
  @@map("CanteenToken")
}

// PetrolAllowanceEntry — per-employee, per-travel-date. KM-based
// allowance; approved entries are added as earnings in payroll.
model PetrolAllowanceEntry {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  month           Int
  year            Int
  travelDate      DateTime @db.Date
  km              Decimal  @db.Decimal(10, 2)
  ratePerKm       Decimal  @db.Decimal(18, 2)
  eligibleAmount  Decimal  @db.Decimal(18, 2)
  approvedAmount  Decimal  @db.Decimal(18, 2)
  status          String   @default("PENDING") @db.NVarChar(20) // PENDING | APPROVED | REJECTED
  managerActionByUserId Int?
  managerActionAt DateTime?
  rejectionReason  String?  @db.NVarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([employeeId])
  @@index([employeeId, year, month])
  @@map("PetrolAllowanceEntry")
}

// AllowanceConfig — company-scoped. Configures special allowances
// (heat allowance, etc.) linked to a SalaryComponent code.
model AllowanceConfig {
  id              Int      @id @default(autoincrement())
  companyId       Int
  componentCode   String   @db.NVarChar(30) // links to SalaryComponent
  amount          Decimal  @db.Decimal(18, 2)
  eligibilityType String   @default("ALL") @db.NVarChar(20) // ALL | DESIGNATION | DEPARTMENT | SHIFT
  eligibilityValue String? @db.NVarChar(200) // comma-separated IDs
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("AllowanceConfig")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 10 — Attendance Config (Batch 2H).
// ─────────────────────────────────────────────────────────────────────────────

// AttendanceColorConfig — company-scoped single-row config. Defines the
// color thresholds for the attendance grid (zero/short/partial/normal/
// extended hours, weekly off). Used by the monthly attendance grid to
// color-code cells based on working hours.
model AttendanceColorConfig {
  id                   Int      @id @default(autoincrement())
  companyId            Int      @unique
  zeroHoursColor       String   @default("#ef4444") @db.NVarChar(10) // red
  shortHoursColor      String   @default("#f97316") @db.NVarChar(10) // orange
  shortHoursThreshold  Int      @default(4) // hours
  partialHoursColor    String   @default("#eab308") @db.NVarChar(10) // yellow
  partialHoursThreshold Int     @default(6) // hours
  normalHoursColor     String   @default("#22c55e") @db.NVarChar(10) // light green
  normalHoursThreshold Int      @default(8) // hours
  extendedHoursColor   String   @default("#15803d") @db.NVarChar(10) // dark green
  weeklyOffColor       String   @default("#3b82f6") @db.NVarChar(10) // blue
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("AttendanceColorConfig")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 14 — Manual Arrears + Bonus tracking.
// ─────────────────────────────────────────────────────────────────────────────

// ManualArrear — supports the 5 missing arrear types from BRD §5:
// ALLOWANCE, DEDUCTION_REVERSAL, ATTENDANCE, INCENTIVE, MANUAL.
// Unlike SalaryArrear (which is tied to a SalaryRevisionRequest), these are
// standalone adjustments that can be applied to any payroll run.
model ManualArrear {
  id          Int      @id @default(autoincrement())
  companyId   Int
  employeeId  Int
  // ALLOWANCE | DEDUCTION_REVERSAL | ATTENDANCE | INCENTIVE | MANUAL
  arrearType  String   @db.NVarChar(30)
  // EARNING | DEDUCTION — whether this arrear adds to or subtracts from net
  amountType  String   @default("EARNING") @db.NVarChar(10)
  amount      Decimal  @db.Decimal(18, 2)
  // The month this arrear applies to (for display, not enforcement)
  arrearYear  Int
  arrearMonth Int
  description String?  @db.NVarChar(500)
  // PENDING | APPROVED | REJECTED | APPLIED
  status      String   @default("PENDING") @db.NVarChar(20)
  approvedByUserId Int?
  approvedAt       DateTime?
  rejectReason     String?  @db.NVarChar(500)
  appliedPayrollRunId Int?
  appliedAt          DateTime?
  createdByUserId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company           Company    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee          Employee   @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedPayrollRun PayrollRun? @relation(fields: [appliedPayrollRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@index([employeeId])
  @@map("ManualArrear")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 17 — LIC, Attendance Policy, Hourly/Daily wage support.
// ─────────────────────────────────────────────────────────────────────────────

// LicDeductionConfig — company-scoped. Defines LIC premium deduction
// rules. Can be flat amount or percentage of gross.
model LicDeductionConfig {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  deductionType   String   @default("FLAT") @db.NVarChar(20) // FLAT | PERCENT
  amount          Decimal  @default(0) @db.Decimal(18, 2) // flat amount or % of gross
  minAmount       Decimal  @default(0) @db.Decimal(18, 2) // minimum deduction
  maxAmount       Decimal? @db.Decimal(18, 2) // null = no cap
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("LicDeductionConfig")
}

// AttendancePolicy — company-scoped. Defines break rules, grace periods,
// and attendance thresholds beyond what LomConfig and AttendanceColorConfig
// already cover.
model AttendancePolicy {
  id                   Int      @id @default(autoincrement())
  companyId            Int      @unique
  // Break rules
  breakMinutesPerDay   Int      @default(30) // lunch/tea break deducted from working duration
  breakDeductible      Boolean  @default(false) // whether break is deducted from pay
  // Grace periods (minutes) — separate from LomConfig.graceMinutesExempt
  lateGraceMinutes     Int      @default(0) // grace before marking late
  earlyOutGraceMinutes Int      @default(0) // grace before marking early out
  // Half-day rules
  halfDayMinHours      Int?    // null = no half-day rule; e.g. 4 = <4h = half day
  halfDayMaxHours      Int?    // e.g. 8 = >=8h = full day
  // Minimum hours for full present
  minFullDayHours      Int      @default(8)
  // Auto-absent if no punch
  autoAbsentIfNoPunch  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("AttendancePolicy")
}

// ─────────────────────────────────────────────────────────────────────────────
// JD MASTER (HR Masters) + minimal Job Posting linkage for recruitment
// ─────────────────────────────────────────────────────────────────────────────

model JobDescription {
  id              Int      @id @default(autoincrement())
  jdCode          String   @unique @db.NVarChar(40)
  departmentId    Int
  designationId   Int
  title           String   @db.NVarChar(200)
  description     String   @db.NVarChar(Max)
  jdFileUrl            String?  @db.NVarChar(500)
  minExperienceYears   Decimal? @db.Decimal(4, 1)
  maxExperienceYears   Decimal? @db.Decimal(4, 1)
  salaryPackage        String?  @db.NVarChar(100)
  status               String   @default("Draft") @db.NVarChar(20) // Draft | Active | Archived
  createdByUserId Int?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department  Department  @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designation Designation @relation(fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?       @relation("JdCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  versions    JobDescriptionVersion[]
  tags        JobDescriptionTag[]
  jobPostings JobPosting[]
  employees   Employee[]

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([createdByUserId])
  @@map("JobDescription")
}

model JobDescriptionVersion {
  id               Int      @id @default(autoincrement())
  jobDescriptionId Int
  title                String   @db.NVarChar(200)
  description          String   @db.NVarChar(Max)
  jdFileUrl            String?  @db.NVarChar(500)
  minExperienceYears   Decimal? @db.Decimal(4, 1)
  maxExperienceYears   Decimal? @db.Decimal(4, 1)
  salaryPackage        String?  @db.NVarChar(100)
  editedByUserId       Int?
  editedAt         DateTime @default(now())

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  editedBy       User?          @relation("JdVersionEditedBy", fields: [editedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jobDescriptionId])
  @@index([editedByUserId])
  @@map("JobDescriptionVersion")
}

model JobDescriptionTag {
  id               Int    @id @default(autoincrement())
  jobDescriptionId Int
  tag              String @db.NVarChar(50)

  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([jobDescriptionId, tag])
  @@index([tag])
  @@map("JobDescriptionTag")
}

// Global sequence for JD0001, JD0002, … (departmentId 0 is the counter row).
model JobDescriptionSequence {
  departmentId Int @id
  lastNumber   Int

  @@map("JobDescriptionSequence")
}

model JobPosting {
  id              Int      @id @default(autoincrement())
  title           String   @db.NVarChar(200)
  departmentId    Int?
  designationId   Int?
  jdId            Int?
  status          String   @default("Open") @db.NVarChar(20)
  createdByUserId Int?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department  Department?     @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designation Designation?    @relation(fields: [designationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobDescription JobDescription? @relation(fields: [jdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?           @relation("JobPostingCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jdId])
  @@index([departmentId])
  @@index([designationId])
  @@index([createdByUserId])
  @@map("JobPosting")
}

// ─────────────────────────────────────────────────────────────────────────────
// 19. SHARED PLATFORM SERVICES — Workflow & Approval, Notification, Document,
//     Configuration Snapshot, Audit Trail.
//     Spec: docs/BRD/06 - Shared Platform Services - BRD.docx
//
//     Deliberately relation-free. These tables reference Company, Employee,
//     User and module entities by integer id (indexed) but declare no Prisma
//     @relation, so this section is purely additive: no edits to the
//     Company/Employee back-relation lists and no FK ordering in the
//     migration — which matters while the schema is merged from several
//     branches every few days. Company scoping is enforced in service code
//     via getCompanyId(); every table carries companyId.
//
//     Names are prefixed (Workflow*, Notification*, PlatformDocument*) so they
//     cannot collide with the recruitment tables that exist in the database
//     outside this schema (DocumentType, EmailTemplate, SlaConfig).
//
//     JSON columns are NVarChar(Max) — SQL Server has no native JSON type.
// ─────────────────────────────────────────────────────────────────────────────

// ── Workflow & Approval Engine ───────────────────────────────────────────────

// A registered kind of request (FNF_SETTLEMENT, LEAVE_APPLICATION, OFFER…).
// handlerKey names the in-process module handler the engine calls on
// Validate / post-approval / post-rejection (src/lib/platform/workflow/registry.ts).
model WorkflowRequestType {
  id                       Int      @id @default(autoincrement())
  companyId                Int
  code                     String   @db.NVarChar(30)
  name                     String   @db.NVarChar(120)
  moduleCode               String   @db.NVarChar(4) // CORE ATTN LEAV PAYR LOAN RECR TRDV ESSV PERF FNFS STAT RPTG
  handlerKey               String?  @db.NVarChar(60)
  conditionFieldsUsed      String?  @db.NVarChar(200) // comma list of §7.2 condition fields this type evaluates
  allowReturn              Boolean  @default(true)
  allowCancelAfterSubmit   Boolean  @default(true)
  allowBulkApproval        Boolean  @default(false)
  allowDelegation          Boolean  @default(true)
  autoApproveOnExhaustion  Boolean  @default(false)
  remarkMandatoryOnApprove Boolean  @default(false)
  snapshotTypeCode         String?  @db.NVarChar(30) // ConfigSnapshot bound at Submit, if any
  retentionYears           Int      @default(8)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([companyId, code])
  @@map("WorkflowRequestType")
}

// Effective-dated, versioned approval matrix. Condition columns are the
// §7.2 fields; a populated condition must match for the matrix to be a
// candidate, and the most specific candidate wins (§7.5). Exactly one
// matrix per request type per company has isFallback = true.
model WorkflowMatrix {
  id              Int       @id @default(autoincrement())
  companyId       Int
  code            String    @db.NVarChar(30)
  name            String    @db.NVarChar(120)
  requestTypeCode String    @db.NVarChar(30)
  versionNo       Int       @default(1)
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date
  isFallback      Boolean   @default(false)
  status          String    @default("Active") @db.NVarChar(10) // Active | Inactive

  minAmount        Decimal? @db.Decimal(18, 2) // inclusive
  maxAmount        Decimal? @db.Decimal(18, 2) // exclusive
  designationCodes String?  @db.NVarChar(400) // comma list; empty = any
  departmentCodes  String?  @db.NVarChar(400)
  gradeCodes       String?  @db.NVarChar(400)
  employmentType   String?  @db.NVarChar(20)
  locationCode     String?  @db.NVarChar(30)
  costCentreCode   String?  @db.NVarChar(30)
  requestSubType   String?  @db.NVarChar(30)

  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, code, versionNo])
  @@index([companyId, requestTypeCode, status])
  @@map("WorkflowMatrix")
}

// One approver slot definition at one level of a matrix (§7.3).
// approverType EMPLOYEE → approverRef is an employee code;
//              ROLE     → a Role.code in this company;
//              POSITION → a §7.4 token (REQUESTER_MANAGER_L1, PLANT_HEAD …).
model WorkflowMatrixLine {
  id                    Int     @id @default(autoincrement())
  matrixId              Int
  levelNo               Int
  sequence              Int     @default(1)
  parallelGroup         Int?
  approverType          String  @db.NVarChar(10) // EMPLOYEE | ROLE | POSITION
  approverRef           String  @db.NVarChar(60)
  mandatory             Boolean @default(true)
  quorumRule            String  @default("ALL") @db.NVarChar(12) // ALL | ANY | N_OF_M
  quorumN               Int?
  escalationDays        Decimal @default(2.0) @db.Decimal(4, 1) // business days
  escalationTargetType  String  @default("POSITION") @db.NVarChar(12) // POSITION | ROLE | EMPLOYEE | NONE
  escalationTargetRef   String? @db.NVarChar(60)
  escalationMode        String  @default("ADD") @db.NVarChar(8) // ADD | REPLACE
  maxEscalationHops     Int     @default(2)
  skipIfSameAsRequester Boolean @default(true)
  remarkMandatory       Boolean @default(false)

  @@index([matrixId, levelNo])
  @@map("WorkflowMatrixLine")
}

// The request object (§6.1). currentStatus follows §6.3:
// Draft | Submitted | Validation Failed | Pending Approval | Returned |
// Approved | Rejected | Cancelled | Reopened.
model WorkflowRequest {
  id               Int      @id @default(autoincrement())
  companyId        Int
  requestNo        String   @db.NVarChar(30) // <TYPE>/<FY>/<serial>
  requestTypeCode  String   @db.NVarChar(30)
  moduleCode       String   @db.NVarChar(4)
  sourceEntityType String   @db.NVarChar(40)
  sourceEntityId   Int
  title            String   @db.NVarChar(200)
  requesterEmpId   Int
  requesterUserId  Int?
  subjectEmpId     Int?
  onBehalfOfEmpId  Int?
  amount           Decimal? @db.Decimal(18, 2)
  requestSubType   String?  @db.NVarChar(30)
  priority         String   @default("NORMAL") @db.NVarChar(10) // URGENT | NORMAL | LOW
  payloadJson      String?  @db.NVarChar(Max) // opaque module payload
  contextJson      String?  @db.NVarChar(Max) // condition values resolved at Submit

  currentStatus         String    @default("Draft") @db.NVarChar(24)
  currentLevel          Int       @default(0)
  matrixId              Int?
  matrixVersionNo       Int?
  snapshotId            Int?
  levelEnteredAt        DateTime?
  dueAt                 DateTime?
  slaBreachCount        Int       @default(0)
  escalationExhausted   Boolean   @default(false)
  submittedAt           DateTime?
  decidedAt             DateTime?
  decisionRemark        String?   @db.NVarChar(1000)
  validationErrorsJson  String?   @db.NVarChar(Max)
  reopenedFromRequestId Int?
  createdByUserId       Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([companyId, requestNo])
  @@index([companyId, currentStatus])
  @@index([companyId, requestTypeCode, sourceEntityType, sourceEntityId])
  @@index([requesterEmpId])
  @@index([dueAt])
  @@map("WorkflowRequest")
}

// Approver slots materialised for a request when a level is entered.
// A matrix line resolves to one slot per resolved approver.
model WorkflowSlot {
  id              Int       @id @default(autoincrement())
  requestId       Int
  levelNo         Int
  sequence        Int       @default(1)
  parallelGroup   Int?
  approverType    String    @db.NVarChar(10)
  approverRef     String    @db.NVarChar(60)
  resolvedEmpId   Int?
  resolvedUserId  Int?
  isMandatory     Boolean   @default(true)
  quorumRule      String    @default("ALL") @db.NVarChar(12)
  quorumN         Int?
  status          String    @default("Pending") @db.NVarChar(12) // Pending | Approved | Rejected | Returned | Skipped | Replaced | Vacant
  escalationHop   Int       @default(0)
  actedByEmpId    Int?
  actedByUserId   Int?
  onBehalfOfEmpId Int? // set when acting under a delegation
  delegationId    Int?
  actedAt         DateTime?
  remark          String?   @db.NVarChar(500)
  createdAt       DateTime  @default(now())

  @@index([requestId, levelNo])
  @@index([resolvedEmpId, status])
  @@index([resolvedUserId, status])
  @@map("WorkflowSlot")
}

// Append-only history of every verb applied to a request (§6.4).
model WorkflowAction {
  id              Int      @id @default(autoincrement())
  companyId       Int
  requestId       Int
  verb            String   @db.NVarChar(20) // Submit Validate Approve Reject Return Cancel Resubmit Escalate Reassign Reopen
  fromStatus      String?  @db.NVarChar(24)
  toStatus        String   @db.NVarChar(24)
  levelNo         Int?
  actorUserId     Int?
  actorEmpId      Int?
  onBehalfOfEmpId Int?
  delegationId    Int?
  remark          String?  @db.NVarChar(1000)
  detailJson      String?  @db.NVarChar(Max)
  createdAt       DateTime @default(now())

  @@index([requestId])
  @@index([companyId, createdAt])
  @@map("WorkflowAction")
}

// Time- and scope-bounded delegation of approval authority (§8).
model WorkflowDelegation {
  id                Int       @id @default(autoincrement())
  companyId         Int
  delegatorEmpId    Int
  delegateEmpId     Int
  scopeType         String    @default("ALL") @db.NVarChar(12) // ALL | MODULE | REQUEST_TYPE
  scopeRefList      String?   @db.NVarChar(400)
  fromDate          DateTime  @db.Date
  toDate            DateTime  @db.Date
  amountCeiling     Decimal?  @db.Decimal(18, 2)
  reasonCode        String    @db.NVarChar(20) // LEAVE TRAVEL MEDICAL TRAINING TEMPORARY_ROLE OTHER
  reasonText        String?   @db.NVarChar(500)
  includeInFlight   Boolean   @default(true)
  notifyDelegator   Boolean   @default(true)
  status            String    @default("Active") @db.NVarChar(10) // Active | Expired | Revoked | PendingApproval
  approvalRequestId Int?
  revokedAt         DateTime?
  revokedByUserId   Int?
  createdByUserId   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, delegatorEmpId, status])
  @@index([companyId, delegateEmpId, status])
  @@map("WorkflowDelegation")
}

// One escalation event (§9.6): a level SLA breached and the target was
// added to or replaced the late approver.
model WorkflowEscalation {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  requestId           Int
  levelNo             Int
  hopNo               Int
  fromApproverEmpId   Int?
  toApproverEmpId     Int?
  mode                String    @db.NVarChar(8) // ADD | REPLACE
  dueAtBefore         DateTime?
  dueAtAfter          DateTime?
  elapsedBusinessDays Decimal?  @db.Decimal(6, 2)
  triggerType         String    @db.NVarChar(10) // AUTOMATIC | MANUAL
  triggeredByUserId   Int?
  reasonText          String?   @db.NVarChar(500)
  createdAt           DateTime  @default(now())

  @@index([requestId])
  @@index([companyId, createdAt])
  @@map("WorkflowEscalation")
}

// ── Notification & Communication ─────────────────────────────────────────────

// A registered event a module may raise (§12.1) with its channel switches.
model NotificationEvent {
  id                Int      @id @default(autoincrement())
  companyId         Int
  code              String   @db.NVarChar(40)
  name              String   @db.NVarChar(120)
  moduleCode        String   @db.NVarChar(4)
  category          String   @default("TRANSACTIONAL") @db.NVarChar(20) // TRANSACTIONAL STATUTORY REMINDER INFORMATIONAL MARKETING_INTERNAL
  defaultPriority   String   @default("NORMAL") @db.NVarChar(10)
  defaultRecipients String?  @db.NVarChar(400) // comma list of §13.2 recipient expressions
  contextSchemaJson String?  @db.NVarChar(Max)
  inAppEnabled      Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  pushEnabled       Boolean  @default(false)
  quietHoursExempt  Boolean  @default(false)
  digestEligible    Boolean  @default(false)
  retentionDays     Int      @default(365)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, code])
  @@map("NotificationEvent")
}

// Versioned, effective-dated template per event × channel × language (§12.2).
// Placeholders: {{Namespace.Field|directive}} — see §12.4/§12.5.
model NotificationTemplate {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String    @db.NVarChar(40)
  name              String    @db.NVarChar(120)
  eventCode         String    @db.NVarChar(40)
  channel           String    @db.NVarChar(10) // INAPP | EMAIL | SMS | PUSH
  language          String    @default("en-IN") @db.NVarChar(5)
  versionNo         Int       @default(1)
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  subject           String?   @db.NVarChar(300)
  bodyHtml          String?   @db.NVarChar(Max)
  bodyText          String    @db.NVarChar(Max)
  smsText           String?   @db.NVarChar(320)
  designationFilter String?   @db.NVarChar(200)
  departmentFilter  String?   @db.NVarChar(200)
  status            String    @default("Active") @db.NVarChar(10)
  createdByUserId   Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, code, versionNo])
  @@index([companyId, eventCode, channel, status])
  @@map("NotificationTemplate")
}

// Outbox and delivery audit (§14.3, §14.6). One row per recipient × channel.
// status: Queued | Deferred | Sending | Sent | Delivered | Read |
//         SoftBounced | HardBounced | FailedUnresolvedPlaceholder |
//         FailedNoTemplate | SuppressedOptOut | SuppressedThrottled |
//         SuppressedNoAddress | Expired
model NotificationDelivery {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  correlationId          String?   @db.NVarChar(60)
  eventCode              String    @db.NVarChar(40)
  eventInstanceId        String?   @db.NVarChar(60)
  moduleCode             String?   @db.NVarChar(4)
  sourceEntityType       String?   @db.NVarChar(40)
  sourceEntityId         Int?
  templateId             Int?
  templateVersionNo      Int?
  language               String?   @db.NVarChar(5)
  channel                String    @db.NVarChar(10)
  recipientType          String    @db.NVarChar(12) // EMPLOYEE | USER | EXTERNAL
  recipientId            Int?
  recipientAddress       String?   @db.NVarChar(320) // needed to dispatch; Restricted class per §23
  recipientAddressMasked String?   @db.NVarChar(200)
  recipientExpression    String?   @db.NVarChar(60)
  renderedSubject        String?   @db.NVarChar(300)
  renderedBody           String?   @db.NVarChar(Max)
  priority               String    @default("NORMAL") @db.NVarChar(10)
  status                 String    @default("Queued") @db.NVarChar(32)
  attemptCount           Int       @default(0)
  lastAttemptAt          DateTime?
  nextAttemptAt          DateTime?
  gatewayMessageId       String?   @db.NVarChar(120)
  gatewayResponseCode    String?   @db.NVarChar(40)
  gatewayResponseText    String?   @db.NVarChar(500)
  failureReason          String?   @db.NVarChar(500)
  queuedAt               DateTime  @default(now())
  sentAt                 DateTime?
  deliveredAt            DateTime?
  readAt                 DateTime?
  expiresAt              DateTime?
  createdAt              DateTime  @default(now())

  @@index([companyId, status, nextAttemptAt])
  @@index([companyId, eventCode])
  @@index([recipientType, recipientId])
  @@index([correlationId])
  @@map("NotificationDelivery")
}

// The in-app inbox ("bell"). Written by the INAPP channel; one row per recipient.
model NotificationInApp {
  id              Int       @id @default(autoincrement())
  companyId       Int
  deliveryId      Int?
  recipientUserId Int?
  recipientEmpId  Int?
  eventCode       String    @db.NVarChar(40)
  title           String    @db.NVarChar(300)
  body            String?   @db.NVarChar(Max)
  linkPath        String?   @db.NVarChar(500)
  priority        String    @default("NORMAL") @db.NVarChar(10)
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([companyId, recipientUserId, isRead])
  @@index([companyId, recipientEmpId, isRead])
  @@map("NotificationInApp")
}

// ── Announcements ────────────────────────────────────────────────────────────

// Company announcements and internal circulars shown on the employee portal
// (KUN MoM 23/June/2025: "Enable announcement notifications on the employee
// portal (e.g., policy updates, internal circulars)").
//
// An announcement is DRAFT until published; publishing stamps publishedAt and
// fans out an ANNOUNCEMENT_PUBLISHED notification. Employees read it on
// /ess/announcements. Read receipts live in AnnouncementRead so HR can show
// who has actually seen a policy update — the reason this is a separate table
// rather than a boolean.
model Announcement {
  id          Int    @id @default(autoincrement())
  companyId   Int
  title       String @db.NVarChar(200)
  body        String @db.NVarChar(Max)
  // POLICY | CIRCULAR | GENERAL — the three kinds the MoM names.
  category    String @default("GENERAL") @db.NVarChar(20)
  // NORMAL | IMPORTANT — IMPORTANT pins the item to the top of the ESS list.
  priority    String @default("NORMAL") @db.NVarChar(10)
  // DRAFT | PUBLISHED | ARCHIVED
  status      String @default("DRAFT") @db.NVarChar(12)

  publishedAt DateTime?
  // Optional end of relevance; past this the item drops off the ESS list but
  // stays readable in the HR archive.
  expiresAt   DateTime?

  createdByUserId Int?
  publishedByUserId Int?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  reads AnnouncementRead[]

  @@index([companyId, status, publishedAt])
  @@map("Announcement")
}

// One row the first time an employee opens an announcement. Unique per
// (announcement, employee) so re-opening never duplicates the receipt.
model AnnouncementRead {
  id             Int      @id @default(autoincrement())
  announcementId Int
  employeeId     Int
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("AnnouncementRead")
}

// ── Document Service ─────────────────────────────────────────────────────────

// Document Type Master (§15.1). documentClass drives the §17.3 access matrix.
model PlatformDocumentType {
  id                       Int      @id @default(autoincrement())
  companyId                Int
  code                     String   @db.NVarChar(30)
  name                     String   @db.NVarChar(120)
  category                 String   @db.NVarChar(30) // IDENTITY EDUCATION EMPLOYMENT STATUTORY FINANCIAL MEDICAL TRAINING CONTRACT POLICY OTHER
  appliesToEntity          String   @db.NVarChar(20) // EMPLOYEE CANDIDATE TRAINING ASSET CONTRACTOR REQUEST
  documentClass            String   @default("INTERNAL") @db.NVarChar(12) // PUBLIC INTERNAL CONFIDENTIAL RESTRICTED
  mandatoryFlag            Boolean  @default(false)
  mandatoryFromStage       String?  @db.NVarChar(30)
  applicableDepartment     String?  @db.NVarChar(200)
  applicableDesignation    String?  @db.NVarChar(200)
  applicableGrade          String?  @db.NVarChar(200)
  applicableEmploymentType String?  @db.NVarChar(200)
  applicableLocation       String?  @db.NVarChar(200)
  verificationRequired     Boolean  @default(true)
  verifierRole             String?  @db.NVarChar(30) // Role.code permitted to verify
  expiryRequired           Boolean  @default(false)
  expiryAlertOffsets       String?  @db.NVarChar(60) // e.g. "60,30,15,7,0" days before expiry
  allowedFileTypes         String   @default("pdf,jpg,png") @db.NVarChar(100)
  maxFileSizeMb            Int      @default(5)
  maxFileCount             Int      @default(1)
  retentionYears           Int      @default(8)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([companyId, code])
  @@map("PlatformDocumentType")
}

// A stored document (§15.2). Versions form a chain via supersedes/supersededBy.
// verificationStatus follows §16.1: Uploaded | UnderVerification | Verified |
// Rejected | ReuploadRequired | Expired | Superseded | Revoked | Withdrawn |
// PendingScan | Quarantined | ScanFailed.
model PlatformDocument {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  documentTypeId         Int
  ownerEntityType        String    @db.NVarChar(20)
  ownerEntityId          Int
  documentRef            String    @db.NVarChar(40) // DOC/<FY>/<serial>
  versionNo              Int       @default(1)
  supersedesDocumentId   Int?
  supersededByDocumentId Int?
  storageKey             String    @db.NVarChar(400) // path under file-storage; never the bytes
  originalFileName       String    @db.NVarChar(260)
  mimeType               String    @db.NVarChar(100)
  fileSizeBytes          BigInt
  sha256Hash             String    @db.Char(64)
  identifierMasked       String?   @db.NVarChar(40) // e.g. XXXX-XXXX-7712 for Aadhaar
  issueDate              DateTime? @db.Date
  expiryDate             DateTime? @db.Date
  verificationStatus     String    @default("Uploaded") @db.NVarChar(24)
  verifiedByUserId       Int?
  verifiedAt             DateTime?
  verificationRemark     String?   @db.NVarChar(500)
  rejectionReasonCode    String?   @db.NVarChar(30) // ILLEGIBLE MISMATCH EXPIRED INCOMPLETE SUSPECTED_FORGERY OTHER
  scanStatus             String    @default("Skipped") @db.NVarChar(12) // Skipped Pending Clean Infected Failed
  uploadedByUserId       Int?
  uploadedAt             DateTime  @default(now())
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([companyId, documentRef])
  @@index([companyId, ownerEntityType, ownerEntityId])
  @@index([companyId, documentTypeId, verificationStatus])
  @@index([expiryDate])
  @@map("PlatformDocument")
}

// ── Configuration Snapshot ───────────────────────────────────────────────────

// An immutable copy of the configuration a transaction was evaluated under
// (Part D): F&F input freeze, recruitment scoring weights, payroll inputs.
// Immutability is enforced in service code — there is no update path; a
// change is a new snapshot that supersedes this one.
model ConfigSnapshot {
  id               Int       @id @default(autoincrement())
  companyId        Int
  snapshotTypeCode String    @db.NVarChar(30) // FNF_INPUTS | INTERVIEW_CONFIG | PAYROLL_INPUTS …
  sourceEntityType String    @db.NVarChar(40)
  sourceEntityId   Int
  triggerRequestId Int?
  contentJson      String    @db.NVarChar(Max)
  sha256Hash       String    @db.Char(64) // over the canonical JSON
  takenAt          DateTime  @default(now())
  takenByUserId    Int?
  supersededById   Int?
  supersededAt     DateTime?
  supersededReason String?   @db.NVarChar(500)
  note             String?   @db.NVarChar(500)

  @@index([companyId, snapshotTypeCode, sourceEntityType, sourceEntityId])
  @@map("ConfigSnapshot")
}

// ── Audit Trail ──────────────────────────────────────────────────────────────

// Append-only. Every platform service writes here; modules adopt via
// src/lib/platform/audit/service.ts. No update or delete path exists.
model AuditLog {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  entityType      String   @db.NVarChar(60)
  entityId        Int?
  entityRef       String?  @db.NVarChar(60)
  action          String   @db.NVarChar(30)
  actorUserId     Int?
  actorEmpId      Int?
  actorSource     String   @default("user") @db.NVarChar(20) // user | system | delegate | import
  onBehalfOfEmpId Int?
  beforeJson      String?  @db.NVarChar(Max)
  afterJson       String?  @db.NVarChar(Max)
  changedFields   String?  @db.NVarChar(1000)
  remark          String?  @db.NVarChar(1000)
  correlationId   String?  @db.NVarChar(60)
  ipAddress       String?  @db.NVarChar(45)
  createdAt       DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@index([correlationId])
  @@map("AuditLog")
}

// ─────────────────────────────────────────────────────────────────────────────
// 20. EMPLOYEE MASTER / CORE HR (Step 1, tranche 3) — organisational hierarchy
//     completion, employee code policy, lifecycle transitions, dated reporting
//     history, and role × data-scope access.
//     Spec: docs/BRD/01 - Employee Master & Core HR - BRD.docx
//     Same relation-free, additive discipline as section 19. Existing tables
//     gained only nullable columns (Employee.lifecycleState/personUid,
//     JobInfo.locationId/costCentreId/noticePeriod*, Unit.businessUnitId,
//     Site.unitId, Grade.defaultNoticeDays).
// ─────────────────────────────────────────────────────────────────────────────

// BRD §5.1: Company → Business Unit → Unit → Site → Location. Management
// grouping with no statutory identity (statutory codes live on Unit).
model BusinessUnit {
  id          Int       @id @default(autoincrement())
  companyId   Int
  code        String    @db.NVarChar(20)
  name        String    @db.NVarChar(100)
  headEmpId   Int?
  description String?   @db.NVarChar(500)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("BusinessUnit")
}

// BRD §5.1/§5.2: the physical posting. locationType drives holiday calendar
// and shift-group defaults later; PLANT | BRANCH | CORPORATE_OFFICE | WAREHOUSE.
model Location {
  id           Int       @id @default(autoincrement())
  companyId    Int
  siteId       Int?
  code         String    @db.NVarChar(20)
  name         String    @db.NVarChar(100)
  locationType String    @default("PLANT") @db.NVarChar(20)
  address      String?   @db.NVarChar(500)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([siteId])
  @@map("Location")
}

// BRD §5.2: ccCode is supplied by Finance and is the key the accounting
// interface books payroll cost against.
model CostCentre {
  id           Int       @id @default(autoincrement())
  companyId    Int
  code         String    @db.NVarChar(20)
  name         String    @db.NVarChar(100)
  departmentId Int?
  ownerEmpId   Int?
  description  String?   @db.NVarChar(500)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([departmentId])
  @@map("CostCentre")
}

// BRD §7.2/§7.3: per-company code format and a sequence that is never
// reused. Width auto-expands; it never truncates. nextSequence is advanced
// atomically inside the create transaction.
model EmployeeCodePolicy {
  id            Int      @id @default(autoincrement())
  companyId     Int      @unique
  prefix        String   @default("EMP") @db.NVarChar(5)
  width         Int      @default(3)
  nextSequence  Int      @default(1)
  updatedAt     DateTime @updatedAt

  @@map("EmployeeCodePolicy")
}

// BRD §8.2: one row per lifecycle transition, append-only.
model EmployeeStateTransition {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  employeeId         Int
  fromState          String?  @db.NVarChar(24)
  toState            String   @db.NVarChar(24)
  trigger            String   @db.NVarChar(40)
  effectiveDate      DateTime @db.Date
  reason             String?  @db.NVarChar(500)
  referenceNo        String?  @db.NVarChar(60)
  performedByUserId  Int?
  createdAt          DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([companyId, toState])
  @@map("EmployeeStateTransition")
}

// BRD §15/§17: dated reporting lines. Employee.reportingManagerId and
// secondReportingManagerId remain the denormalised "current" pointers that
// every existing query uses; this history is written on every reporting
// change and read by point-in-time resolution.
model EmployeeReportingHistory {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  employeeId          Int
  primaryManagerId    Int?
  secondaryManagerId  Int?
  effectiveFrom       DateTime  @db.Date
  effectiveTo         DateTime? @db.Date
  changeReason        String?   @db.NVarChar(30)
  createdByUserId     Int?
  createdAt           DateTime  @default(now())

  @@index([employeeId, effectiveFrom])
  @@index([primaryManagerId])
  @@map("EmployeeReportingHistory")
}

// BRD §20: ACCESS = ROLE × DATA SCOPE. A user holds zero or more scope
// assignments; visible employees are the union. No assignment means the
// implicit SELF scope only. scopeValues is a comma list of codes (or
// employee codes for EMPLOYEE_LIST); treeDepth applies to REPORTING_TREE.
model UserScope {
  id               Int      @id @default(autoincrement())
  companyId        Int
  userId           Int
  scopeType        String   @db.NVarChar(20) // GLOBAL | COMPANY | BUSINESS_UNIT | UNIT | SITE | LOCATION | DEPARTMENT | SUB_DEPARTMENT | COST_CENTRE | REPORTING_TREE | EMPLOYEE_LIST
  scopeValues      String?  @db.NVarChar(2000)
  treeDepth        String?  @db.NVarChar(8) // DIRECT | ALL
  isActive         Boolean  @default(true)
  createdByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, isActive])
  @@index([companyId])
  @@map("UserScope")
}

// ─────────────────────────────────────────────────────────────────────────────
// 21. LEAVE MANAGEMENT ENGINE (Step 1, tranche 4) — transaction ledger,
//     accrual runs, leave-year configuration, in-service encashment.
//     Spec: docs/BRD/04 - Leave Management - BRD.docx
//     Same additive, relation-free discipline as sections 19–20. LeaveMaster,
//     LeaveBalance and LeaveApplication gained nullable/defaulted columns only.
//     LeaveBalance remains the per-year summary; LeaveTransaction is the
//     source of truth and LeaveBalance is rebuilt from it.
// ─────────────────────────────────────────────────────────────────────────────

// §7: leave-year basis per company and the calendar around it.
model LeaveYearConfig {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  basis                 String   @default("FINANCIAL") @db.NVarChar(12) // CALENDAR | FINANCIAL | ANNIVERSARY
  iseWindowStartMonth   Int      @default(1)  // In-Service Encashment window, 1 Jan…
  iseWindowStartDay     Int      @default(1)
  iseWindowEndMonth     Int      @default(1)  // …to 31 Jan
  iseWindowEndDay       Int      @default(31)
  lapseWarningDays      String   @default("60,15") @db.NVarChar(40)
  accrualRunHour        Int      @default(1)  // 01:30 IST
  accrualRunMinute      Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("LeaveYearConfig")
}

// §11.3: every movement of leave days. Append-only; a correction is a new
// signed transaction. LeaveBalance is derived from this table.
model LeaveTransaction {
  id               Int       @id @default(autoincrement())
  companyId        Int
  employeeId       Int
  leaveMasterId    Int
  leaveYear        String    @db.NVarChar(9) // FY2026-27 | CY2026
  txnType          String    @db.NVarChar(24) // OPENING ACCRUAL ACCRUAL_ADJUSTMENT RETRO_ACCRUAL AVAIL AVAIL_REVERSAL HR_ADJUSTMENT ISE_DEBIT ELS_DEBIT LAPSE EXPIRY CARRY_FORWARD_OUT CARRY_FORWARD_IN HOLD_RELEASE
  txnDate          DateTime  @db.Date
  postedAt         DateTime  @default(now())
  days             Decimal   @db.Decimal(6, 2) // signed
  rawValue         Decimal?  @db.Decimal(10, 4)
  isHeld           Boolean   @default(false)
  validUntil       DateTime? @db.Date
  sourceRefType    String?   @db.NVarChar(30) // LEAVE_APPLICATION ISE_REQUEST ELS_CALC ACCRUAL_RUN HR_ADJUSTMENT COMP_OFF
  sourceRefId      Int?
  reasonCode       String?   @db.NVarChar(30)
  remark           String?   @db.NVarChar(500)
  runId            Int?
  createdByUserId  Int?

  @@index([companyId, employeeId, leaveMasterId, leaveYear])
  @@index([employeeId, txnDate])
  @@index([runId])
  @@index([sourceRefType, sourceRefId])
  @@map("LeaveTransaction")
}

// §10.1: one execution of the accrual, year-close or replay job.
model LeaveAccrualRun {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  leaveYear           String    @db.NVarChar(9)
  period              String    @db.NVarChar(7) // YYYY-MM for monthly; YYYY for close
  runType             String    @db.NVarChar(24) // MONTHLY | YEAR_CLOSE | PERIOD_REPLAY | EMPLOYEE_REPLAY | RULE_VERSION_REPLAY | DRY_RUN
  status              String    @default("RUNNING") @db.NVarChar(12) // RUNNING | COMPLETED | ABORTED | FAILED
  employeesProcessed  Int       @default(0)
  txnsPosted          Int       @default(0)
  exceptionsJson      String?   @db.NVarChar(Max)
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  triggeredByUserId   Int?
  reason              String?   @db.NVarChar(500)

  @@index([companyId, leaveYear, period, runType])
  @@map("LeaveAccrualRun")
}

// §18: In-Service Leave Encashment (ISE) — employee-initiated, paid via
// payroll. Exit Leave Settlement (ELS) is computed by F&F on the frozen
// ledger and has no request row here.
model LeaveEncashmentRequest {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  employeeId          Int
  leaveMasterId       Int
  leaveYear           String    @db.NVarChar(9)
  daysRequested       Decimal   @db.Decimal(6, 2)
  daysApproved        Decimal?  @db.Decimal(6, 2)
  estimatedAmount     Decimal?  @db.Decimal(18, 2)
  finalAmount         Decimal?  @db.Decimal(18, 2)
  status              String    @default("SUBMITTED") @db.NVarChar(20) // DRAFT SUBMITTED APPROVED QUEUED_FOR_PAYROLL PAID REJECTED CANCELLED LAPSED_ON_EXIT
  workflowRequestId   Int?
  payrollRunId        Int?
  requestedAt         DateTime  @default(now())
  decidedAt           DateTime?
  decidedByUserId     Int?
  paidAt              DateTime?
  remark              String?   @db.NVarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, employeeId, status])
  @@index([companyId, leaveYear, status])
  @@map("LeaveEncashmentRequest")
}

// ─────────────────────────────────────────────────────────────────────────────
// 22. EXPENSE REIMBURSEMENT (ESS) — Employee-initiated reimbursement requests
//     Status: DRAFT → SUBMITTED → APPROVED/REJECTED → PAID/CANCELLED
// ─────────────────────────────────────────────────────────────────────────────

model ExpenseReimbursement {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  employeeId            Int
  status                String    @default("DRAFT") @db.NVarChar(20) // DRAFT SUBMITTED APPROVED REJECTED PAID CANCELLED
  submissionDate        DateTime  @default(now())
  purpose               String    @db.NVarChar(100) // CLIENT_VISIT TRAINING TRAVEL BUSINESS_MEALS OFFICE_SUPPLIES OTHER
  description           String?   @db.NVarChar(Max)
  totalAmount           Decimal   @db.Decimal(18, 2)
  approvedAmount        Decimal?  @db.Decimal(18, 2)
  approvedBy            Int?
  approvalDate          DateTime?
  rejectionReason       String?   @db.NVarChar(500)
  paymentDate           DateTime?
  createdByUserId       Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  items                 ExpenseReimbursementItem[]

  @@index([companyId, employeeId, status])
  @@index([employeeId, submissionDate])
  @@index([status])
  @@map("ExpenseReimbursement")
}

model ExpenseReimbursementItem {
  id                        Int       @id @default(autoincrement())
  expenseReimbursementId    Int
  category                  String    @db.NVarChar(30) // MEALS TRANSPORT ACCOMMODATION OFFICE_SUPPLIES OTHERS
  description               String    @db.NVarChar(500)
  amount                    Decimal   @db.Decimal(18, 2)
  receiptDate               DateTime  @db.Date
  receiptAttachmentPath     String?   @db.NVarChar(Max) // Path or reference to uploaded receipt
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  expenseReimbursement      ExpenseReimbursement @relation(fields: [expenseReimbursementId], references: [id], onDelete: Cascade)

  @@index([expenseReimbursementId])
  @@map("ExpenseReimbursementItem")
}
