  lines    CommonPurchaseItem[]

  @@map("COMMON_PURCHASE_ORDER")
}

/// Shared ERP Purchasing lines — ROW_ID is NOT identity; allocate explicitly on create.
model CommonPurchaseItem {
  rowId         Int       @id @map("ROW_ID")
  poOrderNo     String?   @map("PO_ORDER_NO") @db.NVarChar(16)
  itemCode      String?   @map("ITEM_CODE") @db.NVarChar(25)
  price         Decimal?  @map("PRICE") @db.Decimal(18, 3)
  qty           Decimal?  @map("QTY") @db.Decimal(18, 3)
  uom           String?   @map("UOM") @db.NVarChar(10)
  comments      String?   @map("COMMENTS") @db.NVarChar(Max)
  creatUserIdCd String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt       DateTime? @map("CREAT_DT") @db.DateTime
  itemType      String?   @map("ITEM_TYPE") @db.NVarChar(50)
  itemName      String?   @map("ITEM_NAME") @db.NVarChar(Max)
  hsnCode       String?   @map("HSN_CODE") @db.NVarChar(20)
  remarks       String?   @map("REMARKS") @db.NVarChar(50)
  itemDesc      String?   @map("item_desc") @db.NVarChar(Max)
  toolRefNo     Int?      @map("TOOL_REF_NO")

  order CommonPurchaseOrder? @relation(fields: [poOrderNo], references: [poOrderNo], onUpdate: NoAction, onDelete: NoAction)
  tool  GaugeAndTools?       @relation(fields: [toolRefNo], references: [refNo], onUpdate: NoAction, onDelete: NoAction)

  @@map("COMMON_PURCHASE_ITEM")
}

