}

// ═══════════════════════════════════════════════════════════════════
// CALIBRATION WORKFLOW
// ═══════════════════════════════════════════════════════════════════

model ToolsIssueForCalibration {
  dcNo            Int       @id @map("DC_NO") @default(autoincrement())
  issueDate       DateTime? @map("ISSUE_DATE") @db.DateTime
  receiveName     String?   @map("RECEIVE_NAME") @db.NVarChar(25)
  subCode         String?   @map("SUB_CODE") @db.NVarChar(10)
  issueFor        String?   @map("ISSUE_FOR") @db.NVarChar(25)
  startDtTime     DateTime? @map("START_DT_TIME") @db.DateTime
  toolsPoNo       String?   @map("TOOLS_PO_NO") @db.NVarChar(20)
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  inHouseLines    ToolsTransIssueForCalibration[]
  receiveHeaders  ToolsReceiveForCalibration[]

  @@map("TOOLS_ISSUE_FOR_CALIBRATION")
}

model ToolsTransIssueForCalibration {
  // ROW_ID is NOT identity in the ERP DB — creates must supply it explicitly.
  rowId               Int       @id @map("ROW_ID")
  dcNo                Int?      @map("DC_NO")
  toolOrGaugeNo       String?   @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  grouping            String?   @map("GROUPING") @db.NVarChar(25)
  issueQty            Int?      @map("ISSUE_QTY")
  serialNo            Int?      @map("SERIAL_NO")
  dueDate             DateTime? @map("DUE_DATE") @db.DateTime
  calibDueDate        DateTime? @map("CALIB_DUE_DATE") @db.DateTime
  status              String?   @map("STATUS") @db.NVarChar(30)
  calibrationStatus   String?   @map("CALIBRATION_STATUS") @db.NVarChar(10)
  nxtCalibDate        DateTime? @map("NXT_CALIB_DATE") @db.DateTime
  resultStatus        String?   @map("RESULT_STATUS") @db.NVarChar(30)
  calibResultComments String?   @map("CALIB_RESULT_COMMENTS") @db.NVarChar(50)
  calibratedBy        String?   @map("CALIBRATED_BY") @db.NVarChar(25)
  calibratedDate      DateTime? @map("CALIBRATED_DATE") @db.DateTime
  toolRefNo           Int?      @map("TOOL_REF_NO")
  remarks             String?   @map("REMARKS") @db.NVarChar(50)
  creatUserIdCd       String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt             DateTime? @map("CREAT_DT") @db.DateTime

  calibIssue      ToolsIssueForCalibration? @relation(fields: [dcNo], references: [dcNo])
  tool            GaugeAndTools?            @relation(fields: [toolOrGaugeNo], references: [toolOrGaugeNo])

  @@map("TOOLS_TRANS_ISSUE_FOR_CALIBRATION")
}

model ToolsReceiveForCalibration {
  recNo           Int       @id @map("REC_NO") @default(autoincrement())
  dcNo            Int       @map("DC_NO")
  receiveDate     DateTime? @map("RECEIVE_DATE") @db.DateTime
  partyDcNo       String?   @map("PARTY_DC_NO") @db.NVarChar(20)
  vendorCd        String?   @map("VENDOR_CD") @db.NVarChar(20)
  receiverName    String?   @map("RECEIVER_NAME") @db.NVarChar(30)
  status          String?   @map("STATUS") @db.NVarChar(10)
  creatUserIdCd   String?   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)

  calibIssue      ToolsIssueForCalibration @relation(fields: [dcNo], references: [dcNo])
  lines           ToolsTransReceiveForCalibration[]

  @@map("TOOLS_RECEIVE_FOR_CALIBRATION")
}

model ToolsTransReceiveForCalibration {
  // ROW_ID is IDENTITY in SQL Server — do not supply on create.
  rowId           Int       @id @default(autoincrement()) @map("ROW_ID")
  recNo           Int       @map("REC_NO")
  dcNo            Int       @map("DC_NO")
  toolOrGaugeNo   String?   @map("TOOL_OR_GAUGE_NO") @db.NVarChar(25)
  description     String?   @map("DESCRIPTION") @db.NVarChar(50)
  serialNo        Int?      @map("SERIAL_NO")
  qty             Decimal?  @map("QTY") @db.Decimal(10, 3)
  price           Decimal?  @map("PRICE") @db.Decimal(10, 3)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime

  header          ToolsReceiveForCalibration @relation(fields: [recNo], references: [recNo])
  tool            GaugeAndTools?             @relation(fields: [toolOrGaugeNo], references: [toolOrGaugeNo])

  @@map("TOOLS_TRANS_RECEIVE_FOR_CALIBRATION")
}

model GaugeControlCard {
  rowId           Int       @id @map("ROW_ID")
  toolOrGaugeNo   String    @map("TOOL_OR_GAUGE_NO") @db.NVarChar(15)
  type            String?   @map("TYPE") @db.NVarChar(25)
  status          String?   @map("STATUS") @db.NVarChar(15)
  frequency       String?   @map("FREQUENCY") @db.NVarChar(15)
  creatUserIdCd   String?   @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.Date

  tool            GaugeAndTools? @relation(fields: [toolOrGaugeNo], references: [toolOrGaugeNo])
  history         GaugeControlCardTrans[]

  @@unique([toolOrGaugeNo])
  @@map("GAUGE_CONTROL_CARD")
}

model GaugeControlCardTrans {
  rowId           Int       @id @map("ROW_ID") @default(autoincrement())
  refNo           Int       @map("REF_NO")
  cDate           DateTime? @map("C_DATE") @db.Date
  nextCDate       DateTime? @map("NEXT_C_DATE") @db.Date
  remarks         String?   @map("REMARKS") @db.NVarChar(25)
  creatDt         DateTime  @map("CREAT_DT") @db.Date
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)

  controlCard     GaugeControlCard @relation(fields: [refNo], references: [rowId])

  @@map("GAUGE_CONTROL_CARD_TRANS")
}

// ═══════════════════════════════════════════════════════════════════
// CALIBRATION FREQUENCY MASTER (app-only table, not in ERP)
