// ═══════════════════════════════════════════════════════════════════
// PURCHASE ORDER LINKED MODULES
// ═══════════════════════════════════════════════════════════════════

/// ERP purchase approval trail — read-only aggregate source (no Tools-owned table).
model PurchaseApproval {
  refNo           Int       @id @map("REF_NO")
  poOrderNo       String?   @map("PO_ORDER_NO") @db.NVarChar(20)
  poAmendNo       Int?      @map("PO_AMEND_NO")
  poSchNo         Int?      @map("PO_SCH_NO")
  subPoOrderNo    String?   @map("SUB_PO_ORDER_NO") @db.NVarChar(15)
  prevStatusCd    Int       @map("PREV_STATUS_CD")
  curStatusCd     Int       @map("CUR_STATUS_CD")
  comments        String?   @map("COMMENTS") @db.NVarChar(200)
  creatUserIdCd   String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt         DateTime? @map("CREAT_DT") @db.DateTime
  lstUpdtUserIdCd String?   @map("LST_UPDT_USER_ID_CD") @db.NVarChar(10)
  lstUpdtTs       DateTime? @map("LST_UPDT_TS") @db.DateTime

  @@map("PURCHASE_APPROVAL")
}

/// Shared ERP Purchasing header — read-only in Tools Management.
model CommonPurchaseOrder {
  poOrderNo         String    @id @map("PO_ORDER_NO") @db.NVarChar(16)
  poDate            DateTime? @map("PO_DATE") @db.DateTime
  validTill         DateTime? @map("VALID_TILL") @db.DateTime
  orderStatusCd     Int?      @map("ORDER_STATUS_CD")
  supCode           String?   @map("SUP_CODE") @db.NVarChar(10)
  quotNo            String?   @map("QUOT_NO") @db.NVarChar(25)
  remarks           String?   @map("REMARKS") @db.NVarChar(300)
  contactName       String?   @map("CONTACT_NAME") @db.NVarChar(50)
  creatUserIdCd     String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.DateTime
  poGoodsType       String?   @map("PO_GOODS_TYPE") @db.NVarChar(50)
  poCat             String?   @map("PO_CAT") @db.NVarChar(50)
  purchaseType      String?   @map("PURCHASE_TYPE") @db.NVarChar(20)
  currency          String?   @map("CURRENCY") @db.NVarChar(15)
  lobType           String?   @map("LOB_TYPE") @db.NVarChar(50)
  vendorType        String?   @map("VENDOR_TYPE") @db.NVarChar(15)
  purchaseValue     Decimal?  @map("PURCHASE_VALUE") @db.Decimal(14, 4)
  subTotValue       Decimal?  @map("SUB_TOT_VALUE") @db.Decimal(14, 4)
  department        String?   @map("DEPARTMENT") @db.NVarChar(50)
  approverCd        String?   @map("APPROVER_CD") @db.NVarChar(100)

  supplier          Supplier? @relation(fields: [supCode], references: [supCode], onUpdate: NoAction, onDelete: NoAction)
  lines             CommonPurchaseItem[]

  @@map("COMMON_PURCHASE_ORDER")
}

/// Shared ERP Purchasing lines — read-only in Tools Management.
model CommonPurchaseItem {
  rowId             Int       @id @map("ROW_ID")
  poOrderNo         String?   @map("PO_ORDER_NO") @db.NVarChar(16)
  itemCode          String?   @map("ITEM_CODE") @db.NVarChar(25)
  price             Decimal?  @map("PRICE") @db.Decimal(18, 3)
  qty               Decimal?  @map("QTY") @db.Decimal(18, 3)
  uom               String?   @map("UOM") @db.NVarChar(10)
  comments          String?   @map("COMMENTS") @db.NVarChar(Max)
  creatUserIdCd     String    @map("CREAT_USER_ID_CD") @db.NVarChar(10)
  creatDt           DateTime? @map("CREAT_DT") @db.DateTime
  itemType          String?   @map("ITEM_TYPE") @db.NVarChar(50)
  itemName          String?   @map("ITEM_NAME") @db.NVarChar(Max)
  hsnCode           String?   @map("HSN_CODE") @db.NVarChar(20)
  remarks           String?   @map("REMARKS") @db.NVarChar(50)
  itemDesc          String?   @map("item_desc") @db.NVarChar(Max)
  toolRefNo         Int?      @map("TOOL_REF_NO")

  order             CommonPurchaseOrder? @relation(fields: [poOrderNo], references: [poOrderNo], onUpdate: NoAction, onDelete: NoAction)
  tool              GaugeAndTools?       @relation(fields: [toolRefNo], references: [refNo], onUpdate: NoAction, onDelete: NoAction)

  @@map("COMMON_PURCHASE_ITEM")
}

model ToolsPoReceive {
  girNo           Int       @id @map("GIR_NO") @default(autoincrement())
  girNoNew        String?   @map("GIR_NO_NEW") @db.NVarChar(20)
  girDate         DateTime? @map("GIR_DATE") @db.DateTime
  poOrderNo       String?   @map("PO_ORDER_NO") @db.NVarChar(16)
