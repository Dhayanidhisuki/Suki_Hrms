// Employee-submitted request to correct a day's punch (missing/wrong
// in/out), reviewed in two stages before DailyAttendance is touched at all
// — Reporting Manager first, then HR — per client BRD: "employee applies,
// Reporting Manager and HR review/approve." Mirrors LeaveApplication's
// pending/approved/rejected shape, but needs two actor/timestamp pairs
// since it's a two-stage approval, not LeaveApplication's single stage.
model MispunchCorrection {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date

  requestedInTime  DateTime?
  requestedOutTime DateTime?
  reason           String    @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status String @default("pending_manager") @db.NVarChar(20)

  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)

  hrActionByUserId  Int?
  hrActionAt        DateTime?
  hrRejectionReason String?   @db.NVarChar(500)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("MispunchCorrection")
}

// Per-employee, per-leave-type, per-year balance ledger.
model LeaveBalance {
  id             Int     @id @default(autoincrement())
  employeeId     Int
  leaveMasterId  Int
  year           Int
  openingBalance Decimal @default(0) @db.Decimal(5, 2)
  accrued        Decimal @default(0) @db.Decimal(5, 2)
  availed        Decimal @default(0) @db.Decimal(5, 2)
  adjusted       Decimal @default(0) @db.Decimal(5, 2)
  closingBalance Decimal @default(0) @db.Decimal(5, 2)
  carryForwardIn Decimal @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  leaveMaster LeaveMaster @relation(fields: [leaveMasterId], references: [id])

  @@unique([employeeId, leaveMasterId, year])
  @@map("LeaveBalance")
}

// Per-company "free permission hours per month" policy (BRD: "2 Hrs /
// Dynamic" — client left the exact number company-configurable, not fixed).
// One row per company; freeHoursPerMonth defaults to 2 only as a starting
// point, not a client-confirmed figure.
model PermissionPolicy {
  id                Int      @id @default(autoincrement())
  companyId         Int      @unique
  freeHoursPerMonth Decimal  @default(2) @db.Decimal(4, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("PermissionPolicy")
}

// Employee-submitted short-leave-in-hours request (self-service, like
// Mispunch). Single-stage RBAC approval — the BRD's Permission section
// names no Reporting-Manager stage the way Mispunch/OT explicitly do.
// Approval only flags whether this request pushes the employee over their
// monthly free-hours allowance (exceedsAllowance/excessHours, computed at
// approval time against PermissionPolicy + the month's other approved
// requests) — it does NOT auto-convert the excess to LOP on DailyAttendance,
// since that table has no fractional-day-LOP field; per BRD ("exceed limit
// = LOM only") the excess is meant to reduce pay, so converting it is left
// as a manual attendance correction HR makes using the flagged hours.
model PermissionRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime @db.Date
  fromTime   DateTime
  toTime     DateTime
  hours      Decimal  @db.Decimal(4, 2)
  reason     String?  @db.NVarChar(500)

  // pending_manager | pending_hr | approved | rejected
  status                 String    @default("pending_manager") @db.NVarChar(20)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectionReason String?   @db.NVarChar(500)
  approvedByUserId       Int?
  approvedAt             DateTime?
  rejectionReason        String?   @db.NVarChar(500)

  exceedsAllowance Boolean @default(false)
  excessHours      Decimal @default(0) @db.Decimal(4, 2)

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("PermissionRequest")
}

// ─────────────────────────────────────────────────────────────────────────────
// 15. PAYROLL PROCESSING — PHASE 1
//     Scope: gross -> LOP-adjusted earnings -> OT -> PF/ESI/PT/TDS (simple
//     estimate against the existing statutory masters) -> net salary ->
//     approve -> lock, with itemized payslips. Reads the employee's current
//     EmployeeSalaryRevision/EmployeeSalaryComponent (NOT EmployeeCtc, which
//     has zero consumers and explicitly forbids invented formulas; NOT the
//     legacy SalaryStructure) and that month's MonthlyAttendanceSummary.
//     Deferred: real Loan/Bonus/Gratuity/Arrear module integration (none of
//     those modules exist yet — PayrollLineComponent.isAdhoc is the
//     manual-entry stand-in), LWF (no master anywhere), full annual TDS with
//     regime/exemptions/rebate/surcharge/cess (flat monthly TDSSlab lookup
//     only), bank transfer files, bulk payslip PDF, configurable rounding,
//     multi-level approval.
// ─────────────────────────────────────────────────────────────────────────────

// Company-level entity (like Unit/Role) — carries companyId directly rather
// than resolving it via an employee join.
model PayrollRun {
  id        Int @id @default(autoincrement())
  companyId Int
  year      Int
  month     Int // 1-12

  // DRAFT | CALCULATED | APPROVED | LOCKED — a deliberately compressed
  // version of the BRD's fuller status chain; Phase 1 has one approver, not
  // multiple distinct verification/submission stages.
  status String @default("DRAFT") @db.NVarChar(20)

  calculatedAt     DateTime?
  approvedAt       DateTime?
  approvedByUserId Int?
  lockedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines          PayrollLine[]
  // Arrears applied into this run as ad-hoc PayrollLineComponent rows —
  // see SalaryArrear.appliedPayrollRunId.
  appliedArrears SalaryArrear[]
  // Bonuses applied into this run as ad-hoc PayrollLineComponent rows —
  // see BonusRecord.appliedPayrollRunId.
  appliedBonuses BonusRecord[]

  @@unique([companyId, year, month])
  @@map("PayrollRun")
}

// One row per employee per run.
model PayrollLine {
  id           Int @id @default(autoincrement())
  payrollRunId Int
  employeeId   Int

  totalWorkingDays Int     @default(0)
  payableDays      Decimal @default(0) @db.Decimal(5, 2)
  lopDays          Int     @default(0)

  grossEarnings      Decimal @default(0) @db.Decimal(18, 2) // LOP-adjusted sum of recurring earning components
  otAmount           Decimal @default(0) @db.Decimal(18, 2)
  otherEarningsTotal Decimal @default(0) @db.Decimal(18, 2) // sum of isAdhoc earning components

  pfEmployee           Decimal @default(0) @db.Decimal(18, 2)
  pfEmployer           Decimal @default(0) @db.Decimal(18, 2)
  epsEmployer          Decimal @default(0) @db.Decimal(18, 2)
  esiEmployee          Decimal @default(0) @db.Decimal(18, 2)
  esiEmployer          Decimal @default(0) @db.Decimal(18, 2)
  professionalTax      Decimal @default(0) @db.Decimal(18, 2)
  tds                  Decimal @default(0) @db.Decimal(18, 2)
  otherDeductionsTotal Decimal @default(0) @db.Decimal(18, 2) // sum of isAdhoc deduction components

  netSalary Decimal @default(0) @db.Decimal(18, 2)

  // Snapshotted from JobInfo/defaults at calculate time (not live-joined),
  // same convention as DailyAttendance.shiftMasterId. pfApplicable has no
  // JobInfo source field (unlike esi/pt) — defaults true, editable per run.
  pfApplicable  Boolean @default(true)
  esiApplicable Boolean @default(false)
  ptApplicable  Boolean @default(false)

  // OK | HOLD — per-employee exception flag, distinct from the run's own
  // status (e.g. attendance not finalized for this employee yet).
  status     String  @default("OK") @db.NVarChar(20)
  holdReason String? @db.NVarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun             @relation(fields: [payrollRunId], references: [id])
  employee   Employee               @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components PayrollLineComponent[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("PayrollLine")
}

// Itemization for the payslip — both the LOP-adjusted recurring components
// (isAdhoc: false) and any one-off entries added to this run only
// (isAdhoc: true — e.g. a manually-entered loan recovery or bonus, since
// those modules don't exist yet).
model PayrollLineComponent {
  id                Int     @id @default(autoincrement())
  payrollLineId     Int
  salaryComponentId Int
  amount            Decimal @db.Decimal(18, 2)
  isAdhoc           Boolean @default(false)

  createdAt DateTime @default(now())

  payrollLine     PayrollLine     @relation(fields: [payrollLineId], references: [id])
  salaryComponent SalaryComponent @relation(fields: [salaryComponentId], references: [id])

  @@index([payrollLineId])
  @@map("PayrollLineComponent")
}

// ─────────────────────────────────────────────────────────────────────────────
// 16. SALARY REVISION & ARREAR — PHASE 1
//     Scope: employee-wise revision request with a single-approver workflow
//     (Draft/Submitted/Approved/Rejected/Hold/Cancelled — no HR-Verification-
//     then-Management multi-stage chain) that, on approval, versions the
//     employee's salary via the same logic src/app/api/employees/[id]/salary
//     already uses (extracted into src/lib/salaryRevisioning.ts) and
//     auto-detects a retroactive effective date to generate a month-wise
//     SalaryArrear, which is then pushed into Payroll as ad-hoc
//     PayrollLineComponent rows — reusing the ad-hoc mechanism from section 15
//     rather than inventing a new payroll-input concept.
//     Deferred to a later phase: SalaryRevisionCycle (bulk/department/grade-
//     wide revisions), a configurable eligibility engine, bulk Excel upload,
//     multi-level approval, a separate arrear-approval stage, a dedicated
//     audit table (reuse EmployeeActivity/logActivity instead), the reports
//     suite, "Other Deduction Arrear", and PT/TDS arrear adjustment.
//     All FKs here are onDelete/onUpdate: NoAction — several of these models
//     have more than one path back to Company/Employee (e.g. SalaryArrear
//     carries both companyId/employeeId directly AND a link through
//     SalaryRevisionRequest, which itself reaches the same rows), so every
//     relation is pinned NoAction up front rather than chasing SQL Server's
//     "multiple cascade paths" error one FK at a time.
// ─────────────────────────────────────────────────────────────────────────────

model SalaryRevisionRequest {
  id         Int @id @default(autoincrement())
  companyId  Int
  employeeId Int

  // ANNUAL_INCREMENT | PROMOTION | SPECIAL
  revisionType   String @db.NVarChar(30)
  // PERCENTAGE | FIXED_AMOUNT | REVISED_GROSS — which input the user typed;
  // the other two of {incrementPercent, incrementAmount, revisedGross} are
  // server-computed from it (BRD §27).
  revisionMethod String @db.NVarChar(20)

  currentGross     Decimal  @db.Decimal(18, 2) // snapshot of gross at proposal time
  incrementPercent Decimal? @db.Decimal(7, 2)
  incrementAmount  Decimal? @db.Decimal(18, 2)
  revisedGross     Decimal  @db.Decimal(18, 2)

  effectiveFrom DateTime

  // DRAFT | SUBMITTED | PENDING_MANAGER | PENDING_HR | APPROVED | REJECTED | HOLD | CANCELLED
  status       String  @default("DRAFT") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  // Manager stage (two-level approval: Manager → HR)
  managerActionByUserId  Int?
  managerActionAt        DateTime?
  managerRejectReason   String? @db.NVarChar(500)

  // Set once approved — the new EmployeeSalaryRevision version this request
  // produced. @unique here is for Prisma's relation typing only — the real
  // DB constraint is a FILTERED unique index (WHERE appliedRevisionId IS
  // NOT NULL, migration 000010), same fix as Employee.userId, since most
  // requests sit at NULL until approved and SQL Server's plain UNIQUE only
  // allows one NULL. `prisma migrate diff` will keep re-emitting the plain
  // "ADD CONSTRAINT ... UNIQUE NONCLUSTERED" version of this — exclude it
  // from any future migration, same as Employee_userId_key.
  appliedRevisionId Int? @unique

  createdByUserId  Int?
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company                   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee        Employee                  @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedRevision EmployeeSalaryRevision?   @relation(fields: [appliedRevisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components      SalaryRevisionComponent[]
  arrear          SalaryArrear?

  @@index([companyId, status])
  @@index([employeeId])
  @@map("SalaryRevisionRequest")
}

// Component-level revised amounts for the proposal — mirrors
// EmployeeSalaryComponent's shape; copied into a real EmployeeSalaryComponent
// row set on approval via salaryRevisioning.ts.
model SalaryRevisionComponent {
  id                      Int     @id @default(autoincrement())
  salaryRevisionRequestId Int
  salaryComponentId       Int
  currentAmount           Decimal @db.Decimal(18, 2)
  revisedAmount           Decimal @db.Decimal(18, 2)

  salaryRevisionRequest SalaryRevisionRequest @relation(fields: [salaryRevisionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salaryComponent       SalaryComponent       @relation(fields: [salaryComponentId], references: [id])

  @@unique([salaryRevisionRequestId, salaryComponentId])
  @@map("SalaryRevisionComponent")
}

// One per approved + retroactive SalaryRevisionRequest — header totals;
// month-wise detail lives in SalaryArrearMonth (BRD §18's auditability ask).
model SalaryArrear {
  id                      Int @id @default(autoincrement())
  salaryRevisionRequestId Int @unique
  employeeId              Int
  companyId               Int

  oldGross     Decimal @db.Decimal(18, 2)
  revisedGross Decimal @db.Decimal(18, 2)

  arrearFromYear  Int
  arrearFromMonth Int
  arrearToYear    Int
  arrearToMonth   Int

  grossArrearTotal Decimal @default(0) @db.Decimal(18, 2)
  pfArrearTotal    Decimal @default(0) @db.Decimal(18, 2)
  esiArrearTotal   Decimal @default(0) @db.Decimal(18, 2)
  netArrearTotal   Decimal @default(0) @db.Decimal(18, 2)

  // CALCULATED | APPLIED
  status       String   @default("CALCULATED") @db.NVarChar(20)
  calculatedAt DateTime @default(now())

  appliedPayrollRunId Int?
  appliedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salaryRevisionRequest SalaryRevisionRequest @relation(fields: [salaryRevisionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company               Company               @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedPayrollRun     PayrollRun?           @relation(fields: [appliedPayrollRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  months                SalaryArrearMonth[]

  @@map("SalaryArrear")
}

model SalaryArrearMonth {
  id             Int @id @default(autoincrement())
  salaryArrearId Int
  year           Int
  month          Int

  oldGross        Decimal @db.Decimal(18, 2)
  revisedGross    Decimal @db.Decimal(18, 2)
  grossDifference Decimal @db.Decimal(18, 2)
  pfArrear        Decimal @default(0) @db.Decimal(18, 2)
  esiArrear       Decimal @default(0) @db.Decimal(18, 2)
  netArrear       Decimal @db.Decimal(18, 2)

  salaryArrear SalaryArrear @relation(fields: [salaryArrearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([salaryArrearId, year, month])
  @@map("SalaryArrearMonth")
}

// ─────────────────────────────────────────────────────────────────────────────
// 17. BONUS MANAGEMENT — PHASE 1 (Tier 5a)
//     Scope: statutory-minimum bonus only (BRD's own worked example —
//     min(basic, wage ceiling) × 12 × rate%), against a configurable
//     BonusRate master, with a single-approver workflow that pushes the
//     approved amount into Payroll as an ad-hoc earning line — same pattern
//     as section 16's SalaryArrear → PayrollLineComponent integration.
//     Deferred: the full allocable-surplus/Set-On-Set-Off variable bonus
//     scheme, unit/category/performance-based rate determinants, a
//     configured Remark master, true attendance-day-sum eligibility (DOJ-vs-
//     calculation-date proxy instead), multi-level approval, bulk
//     upload/export, a dedicated audit table (reuse EmployeeActivity).
//     Gratuity (the BRD's "II." module) is intentionally out of scope here —
//     see Tier 5b.
// ─────────────────────────────────────────────────────────────────────────────

// Company-scoped since migration 000013 (previously global, like PfRate/
// EsiRate). calculationType picks which of the two Phase-1 bonus formulas
// bonusCalculation.ts uses for this company: BASIC_PROJECTION (the original
// Tier 5a logic) or ACTUAL_NET_PAY (sums real PayrollLine.netSalary paid
// across the accounting year instead of projecting off Basic). 8.33% is a
// hard floor on ratePercent/minRatePercent — enforced in
// src/lib/validations/master.ts's bonusRateSchema, not just documented.
model BonusRate {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  code                   String    @db.NVarChar(20)
  calculationType        String    @default("BASIC_PROJECTION") @db.NVarChar(30)
  ratePercent            Decimal   @db.Decimal(5, 2) // e.g. 8.33
  minRatePercent         Decimal   @db.Decimal(5, 2)
  maxRatePercent         Decimal   @db.Decimal(5, 2)
  wageEligibilityCeiling Decimal   @db.Decimal(18, 2) // e.g. 21000 — monthly wage must be <= this
  calculationWageCeiling Decimal   @db.Decimal(18, 2) // e.g. 7000 — wage basis capped at this (BASIC_PROJECTION only)
  minWorkingDays         Int       @default(30)
  effectiveFrom          DateTime
  effectiveTo            DateTime? // NULL = currently active
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, effectiveFrom, effectiveTo])
  @@index([code])
  @@map("BonusRate")
}

// One row per employee per accounting year (acYear = FY's starting calendar
// year, e.g. 2026 for "2026-2027" — same convention as the PT report's
// financialYear).
model BonusRecord {
  id         Int @id @default(autoincrement())
  companyId  Int
  employeeId Int
  acYear     Int

  currentGross   Decimal  @db.Decimal(18, 2)
  currentBasic   Decimal  @db.Decimal(18, 2)
  doj            DateTime
  yearsOfService Decimal  @db.Decimal(6, 2)

  // ELIGIBLE | NOT_ELIGIBLE_WAGE | NOT_ELIGIBLE_SERVICE | MANUAL_REVIEW
  // (MANUAL_REVIEW: ACTUAL_NET_PAY type with zero processed payroll months
  // this accounting year — nothing to sum, not a fabricated ₹0 bonus)
  eligibilityStatus String  @db.NVarChar(30)
  eligibilityReason String? @db.NVarChar(500)

  // BASIC_PROJECTION | ACTUAL_NET_PAY — snapshot of which BonusRate.calculationType
  // produced this record, for display/audit.
  calculationType String   @default("BASIC_PROJECTION") @db.NVarChar(30)
  // The wage base bonusAmount was last computed from (min(basic,ceiling)×12
  // for BASIC_PROJECTION, summed actual netSalary for ACTUAL_NET_PAY) —
  // stored so PUT /api/bonus/records/[id] can recompute bonusAmount from a
  // new bonusPercent without re-touching Payroll data.
  annualBonusWage Decimal? @db.Decimal(18, 2)

  bonusPercent Decimal? @db.Decimal(5, 2)
  bonusAmount  Decimal? @db.Decimal(18, 2)

  // PENDING | NOT_ELIGIBLE | CALCULATED | APPROVED | REJECTED | HOLD | PROCESSED
  status       String  @default("PENDING") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  appliedPayrollRunId Int?
  appliedAt           DateTime?

  calculatedAt     DateTime?
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedPayrollRun PayrollRun? @relation(fields: [appliedPayrollRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([companyId, employeeId, acYear])
  @@index([companyId, acYear, status])
  @@map("BonusRecord")
}

// ─────────────────────────────────────────────────────────────────────────────
// 18. GRATUITY — PHASE 1 (Tier 5b)
//     Scope: the BRD's own worked example (§20) — Last Drawn Eligible Salary
//     x multiplierNumerator/multiplierDenominator x Completed Years of
//     Service, capped at a configurable ceiling, both gross and payable
//     figures retained (§13). Triggered per-employee by their own
//     ExitInterview (section 7's schema-only model, finally getting an
//     API/UI here), not a whole-company batch like Bonus.
//     Deferred: multiple/category-specific policies, the standalone
//     estimation facility, death/disability special rules + nominee/
//     document tracking, multi-level approval, bulk processing, the full
//     reports suite, a dedicated audit table (reuse EmployeeActivity),
//     Payroll integration (gratuity is a terminal settlement per the BRD's
//     own diagram, not an ad-hoc PayrollLineComponent like Arrear/Bonus —
//     paymentDate/paymentReference live directly on GratuityRecord).
// ─────────────────────────────────────────────────────────────────────────────

model GratuityPolicy {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  code                    String    @db.NVarChar(20)
  policyName              String    @db.NVarChar(100)
  multiplierNumerator     Decimal   @default(15) @db.Decimal(5, 2)
  multiplierDenominator   Decimal   @default(26) @db.Decimal(5, 2)
  minEligibleServiceYears Decimal   @default(5) @db.Decimal(5, 2)
  maxGratuityCeiling      Decimal   @db.Decimal(18, 2)
  effectiveFrom           DateTime
  effectiveTo             DateTime? // NULL = currently active
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, effectiveFrom, effectiveTo])
  @@index([code])
  @@map("GratuityPolicy")
}

// One row per employee separation (1:1 with ExitInterview).
model GratuityRecord {
  id              Int @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  exitInterviewId Int @unique

  doj                    DateTime
  separationDate         DateTime
  qualifyingServiceYears Decimal  @db.Decimal(6, 2)

  // ELIGIBLE | NOT_ELIGIBLE_SERVICE
  eligibilityStatus String  @db.NVarChar(30)
  eligibilityReason String? @db.NVarChar(500)

  eligibleSalary        Decimal? @db.Decimal(18, 2)
  multiplierNumerator   Decimal? @db.Decimal(5, 2)
  multiplierDenominator Decimal? @db.Decimal(5, 2)
  // Pre-ceiling and post-ceiling amounts, both retained — BRD §13.
  grossGratuity         Decimal? @db.Decimal(18, 2)
  payableGratuity       Decimal? @db.Decimal(18, 2)

  // CALCULATED | NOT_ELIGIBLE | APPROVED | REJECTED | HOLD | PAID
  status       String  @default("CALCULATED") @db.NVarChar(20)
  holdReason   String? @db.NVarChar(500)
  rejectReason String? @db.NVarChar(500)
  remarks      String? @db.NVarChar(500)

  paymentDate      DateTime?
  paymentReference String?   @db.NVarChar(100)

  calculatedAt     DateTime  @default(now())
  approvedByUserId Int?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exitInterview ExitInterview @relation(fields: [exitInterviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status])
  @@map("GratuityRecord")
}
