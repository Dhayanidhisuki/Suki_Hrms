# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Session artifacts
.token.txt
~$*.pptx
*.fuse_hidden*
.commit-msg.txt

# Diagnostic / test scripts with hardcoded credentials
test-api.js
check-user21.js

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit; contain DB, JWT, encryption and biometric secrets
.env
.env.*
!.env.example

# ERP data extracts — may contain employee PII/credentials, never commit
scripts/erp-extract/out/

# Employee uploads (ID documents, photos) — served through the permission-gated
# /api/uploads/[...path] route, never committed. See src/lib/file-storage.ts.
/uploads/
/public/uploads/

# local scratch / debug artefacts at repo root
/test-*.js
/test-*.mjs
/test-*.csv
/trace-*.js
/verify-*.js
/verify-*.txt
/summaries-*.txt
check-user21.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
