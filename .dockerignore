# Build context hygiene. node_modules and .next are excluded so the image is
# built from source rather than inheriting whatever the Windows host had --
# this also avoids copying in native binaries built for a different platform.
node_modules
.next
out
build

# Secrets: .env is injected at runtime via compose env_file, never baked in.
.env
.env.*
!.env.example

.git
.gitignore
.github
.gitlab-ci.yml

Dockerfile
.dockerignore
docker-compose*.yml
compose*.yaml

# Runtime-written tool documents. These live on a bind mount, and shipping the
# host's copy into the image would both bloat it and mask a broken mount.
storage

# Dead code the app no longer references
_to_delete

# Agent/editor scaffolding
.agents
.claude
.cursor
.windsurf
skills-lock.json

# Tests and tooling that the runtime image has no use for
tests
playwright.config.ts
vitest.config.ts
**/*.test.ts
**/*.spec.ts

# Editor / OS noise
.vscode
.idea
.DS_Store
*.swp

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# Docs and binary artefacts that bloat the context
docs
design-system-export
design-system-export.zip
*.docx
*.xlsx
*.sql
