# Database
DB_PROVIDER="sqlserver"
DATABASE_URL="sqlserver://HOST:1433;database=suki_hrms;user=USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true;connection_limit=20;pool_timeout=30;"

# Auth
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
AUTH_JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="CHANGE_ME_BASE64_KEY"

# Biometric device controller (on-prem)
BIOMETRIC_API_URL=http://DEVICE_IP:8070
BIOMETRIC_API_KEY=YOUR_API_KEY

# Hold biometric scheduler until device API is reachable
BIOMETRIC_SYNC_ENABLED=true

# Mobile-app attendance database (separate SQL Server, READ-ONLY login).
# Reads punches from dbo.ATTENDANCE_ENTRY + dbo.OD_ATTENDANCE_ENTRY
# (ERPDB_SUKISOFT). Everything is off until ESSL_SYNC_ENABLED=true —
# until then the biometric flow runs exactly as before and the merge
# code never executes.
ESSL_SYNC_ENABLED=false
ESSL_DB_SERVER=APP_DB_HOST
ESSL_DB_PORT=1433
ESSL_DB_NAME=ERPDB_SUKISOFT
ESSL_DB_USER=READONLY_USER
ESSL_DB_PASSWORD=YOUR_PASSWORD
ESSL_DB_ENCRYPT=true
ESSL_DB_TRUST_CERT=false
